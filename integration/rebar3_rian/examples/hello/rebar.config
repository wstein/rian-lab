%% Demo: a rebar3 app whose `.rian` sources compile to BEAM via the rebar3_rian
%% plugin. `rebar3 compile` runs the normal Erlang compile, then (post-hook) the
%% `rian` provider compiles rian_src/*.rian into this app's ebin/.
%%
%% Provide the plugin to rebar3 one of two ways:
%%   * published:  {plugins, [rebar3_rian]}  (once on Hex)
%%   * local dev:  put it in `_checkouts/rebar3_rian` (symlink or copy) — see README.
{plugins, [rebar3_rian]}.

{provider_hooks, [{post, [{compile, rian}]}]}.

%% `bin` defaults to `rian` on PATH; `src_dir` defaults to `rian_src`.
{rian, [{src_dir, "rian_src"}]}.
