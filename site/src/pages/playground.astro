---
import SiteShell from "../layouts/SiteShell.astro";
import { TARGET_META } from "../lib/highlight";
import tour from "../data/tour.json";

const order = ["ex", "rs", "js", "jvm"];
const files = tour.cells.map((c) => ({ id: c.id, file: c.file }));
---

<SiteShell title="Rian Playground" active="playground">
  <div class="pg">
    <!-- activity bar -->
    <div class="pg-activity">
      {
        ["explorer", "search", "run", "git", "settings"].map((ic, i) => (
          <button class={`pg-act ${i === 0 ? "on" : ""}`} aria-label={ic} title={ic}>
            <span class="pg-act-glyph">{["▢", "⌕", "▷", "⎇", "⚙"][i]}</span>
          </button>
        ))
      }
    </div>

    <div class="pg-main">
      <!-- file tabs -->
      <div class="pg-tabs" id="pg-tabs">
        {
          files.map((f, i) => (
            <button class={`pg-tab ${i === 0 ? "on" : ""}`} data-file={f.id}>
              <span class="rl-rtile" style="width:13px;height:13px;font-size:8px;">R</span>
              {f.file}
            </button>
          ))
        }
      </div>

      <div class="pg-body">
        <!-- left: editor + console -->
        <div class="pg-left">
          <div class="pg-editor">
            <div class="pg-gutter" id="pg-gutter"></div>
            <div class="pg-codearea">
              <pre class="pg-hl rl-code" id="pg-hl"></pre>
              <textarea id="pg-src" spellcheck="false" autocomplete="off" autocapitalize="off"></textarea>
            </div>
          </div>
          <div class="pg-console">
            <div class="pg-console-bar">
              <span class="rl-mono pg-console-title">OUTPUT</span>
              <span class="pg-edited" id="pg-edited" hidden>● edited (not re-lowered)</span>
              <div class="pg-console-btns">
                <button class="pg-btn pg-run" id="pg-run">▷ Run</button>
                <button class="pg-btn" id="pg-reset">↺ Reset</button>
              </div>
            </div>
            <pre class="rl-mono pg-out" id="pg-out">Run to see the compiler's gate + reachability report.</pre>
          </div>
        </div>

        <!-- right: lowered output -->
        <div class="pg-output">
          <div class="pg-otabs" id="pg-otabs">
            {
              order.map((t) => (
                <button class="pg-otab" data-set={t}>
                  <span class="rl-dot" style={`width:7px;height:7px;background:${TARGET_META[t].dot};`} />
                  {t === "ex" ? "BEAM" : t === "rs" ? "Rust" : t === "js" ? "JS" : "JVM"}
                </button>
              ))
            }
          </div>
          <div class="pg-panes" id="pg-panes">
            {
              order.map((t) => (
                <div class="rl-pane" data-t={t}>
                  <pre class="rl-code pg-pane-code" data-pane={t} />
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <!-- status bar -->
      <div class="pg-status rl-mono">
        <span>⎇ main</span>
        <span class="pg-status-sep">·</span>
        <span>Rian</span>
        <span class="pg-status-sep">·</span>
        <span style="color:#34d399;">✓ type-checked · exhaustive · capability</span>
        <span class="pg-status-grow" id="pg-status-reach"></span>
        <span id="pg-status-ln">Ln 1</span>
        <span class="pg-status-sep">·</span>
        <span>Spaces: 2</span>
        <span class="pg-status-sep">·</span>
        <span>UTF-8</span>
      </div>
    </div>
  </div>
</SiteShell>

<script>
  import { highlight } from "../lib/highlight";
  import tour from "../data/tour.json";

  type Cell = (typeof tour.cells)[number];
  const cells = tour.cells as Cell[];
  const byId = new Map(cells.map((c) => [c.id, c]));
  const LABEL: Record<string, string> = { ex: "BEAM · Elixir", rs: "Rust", js: "JavaScript", jvm: "JVM · Kotlin" };

  const $ = (s: string) => document.querySelector(s) as HTMLElement;
  const src = $("#pg-src") as HTMLTextAreaElement;
  const hl = $("#pg-hl");
  const gutter = $("#pg-gutter");
  const out = $("#pg-out");
  const edited = $("#pg-edited");
  const statusReach = $("#pg-status-reach");
  const statusLn = $("#pg-status-ln");

  let current: Cell = cells[0];

  function renderEditor() {
    const code = src.value;
    hl.innerHTML = highlight(code) + "\n";
    const lines = code.split("\n").length;
    gutter.innerHTML = Array.from({ length: lines }, (_, i) => `<span>${i + 1}</span>`).join("");
    statusLn.textContent = "Ln " + lines;
    edited.hidden = code === current.source;
  }

  function renderPanes() {
    for (const t of ["ex", "rs", "js", "jvm"]) {
      const el = document.querySelector(`.pg-pane-code[data-pane="${t}"]`);
      if (el) el.innerHTML = highlight((current.panes as Record<string, string>)[t]);
    }
    const reach = Object.values(current.reach)[0] as string[];
    const order = ["ex", "rs", "js", "jvm"];
    statusReach.innerHTML =
      "reaches " +
      order
        .map(
          (t) =>
            `<span style="opacity:${reach.includes(t) ? "1" : "0.45"};text-decoration:${reach.includes(t) ? "none" : "line-through"}">:${t}</span>`,
        )
        .join(" · ");
  }

  function loadFile(id: string) {
    current = byId.get(id)!;
    src.value = current.source;
    document.querySelectorAll(".pg-tab").forEach((b) => b.classList.toggle("on", (b as HTMLElement).dataset.file === id));
    renderEditor();
    renderPanes();
    out.textContent = "Run to see the compiler's gate + reachability report.";
  }

  function run() {
    const reach = (Object.values(current.reach)[0] as string[]).map((t) => ":" + t).join(" · ");
    const fn = Object.keys(current.reach)[0];
    const dirty = src.value !== current.source;
    out.textContent =
      `$ rian check ${current.file}\n` +
      `  ✓ parsed\n  ✓ type-checked\n  ✓ exhaustive (Maranget)\n  ✓ capability\n` +
      `  ${fn} reaches ${reach}\n` +
      (dirty
        ? `\n  note: the buffer was edited — the panes show the reference\n  emission for ${current.file}; in-browser re-lowering is not wired\n  (the hosted Lab recompiles server-side).`
        : `\n  exit 0`);
  }

  // wire up
  document.querySelectorAll(".pg-tab").forEach((b) =>
    b.addEventListener("click", () => loadFile((b as HTMLElement).dataset.file!)),
  );
  document.querySelectorAll(".pg-otab").forEach((b) =>
    b.addEventListener("click", () => {
      const t = (b as HTMLElement).dataset.set!;
      document.documentElement.dataset.target = t;
      try {
        localStorage.setItem("rian-target", t);
      } catch (e) {}
    }),
  );
  src.addEventListener("input", renderEditor);
  src.addEventListener("scroll", () => {
    hl.scrollTop = src.scrollTop;
    hl.scrollLeft = src.scrollLeft;
    gutter.scrollTop = src.scrollTop;
  });
  $("#pg-run").addEventListener("click", run);
  $("#pg-reset").addEventListener("click", () => {
    src.value = current.source;
    renderEditor();
    out.textContent = "Reset to " + current.file + ".";
  });

  loadFile(cells[0].id);
</script>

<style>
  .pg {
    display: grid;
    grid-template-columns: 48px 1fr;
    height: calc(100vh - 113px);
    min-height: 560px;
    border-top: 1px solid var(--border);
  }
  .pg-activity {
    background: var(--code-chrome);
    border-right: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 10px 0;
    gap: 4px;
  }
  .pg-act {
    width: 36px;
    height: 36px;
    border: none;
    background: transparent;
    color: var(--dim);
    cursor: pointer;
    border-radius: 8px;
    font-size: 16px;
  }
  .pg-act.on {
    color: var(--text-strong);
    box-shadow: inset 2px 0 0 var(--accent);
  }
  .pg-act:hover {
    color: var(--text-strong);
  }
  .pg-main {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .pg-tabs {
    display: flex;
    gap: 1px;
    background: var(--code-chrome);
    border-bottom: 1px solid var(--border);
    overflow-x: auto;
  }
  .pg-tab {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    color: var(--dim);
    background: transparent;
    border: none;
    border-right: 1px solid var(--border);
    padding: 10px 16px;
    cursor: pointer;
    white-space: nowrap;
  }
  .pg-tab.on {
    color: var(--text-strong);
    background: var(--code-bg);
    box-shadow: inset 0 2px 0 var(--accent);
  }
  .pg-body {
    flex: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 0;
  }
  .pg-left {
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--border);
    min-width: 0;
  }
  .pg-editor {
    flex: 1;
    display: grid;
    grid-template-columns: 48px 1fr;
    min-height: 0;
    background: var(--code-bg);
  }
  .pg-gutter {
    overflow: hidden;
    padding: 18px 0;
    text-align: right;
    color: #475569;
    font-family: "JetBrains Mono", monospace;
    font-size: 13px;
    line-height: 1.75;
    user-select: none;
  }
  .pg-gutter :global(span) {
    display: block;
    padding-right: 12px;
  }
  .pg-codearea {
    position: relative;
    min-width: 0;
  }
  .pg-hl,
  .pg-codearea textarea {
    margin: 0;
    padding: 18px;
    font-family: "JetBrains Mono", monospace;
    font-size: 13px;
    line-height: 1.75;
    white-space: pre;
    overflow: auto;
    border: 0;
  }
  .pg-hl {
    position: absolute;
    inset: 0;
    pointer-events: none;
    color: #cbd5e1;
    background: transparent;
  }
  .pg-codearea textarea {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    resize: none;
    background: transparent;
    color: transparent;
    caret-color: var(--accent);
    outline: none;
    tab-size: 2;
  }
  .pg-console {
    border-top: 1px solid var(--border);
    height: 38%;
    min-height: 120px;
    display: flex;
    flex-direction: column;
    background: var(--code-chrome);
  }
  .pg-console-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 14px;
    border-bottom: 1px solid var(--border);
  }
  .pg-console-title {
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--dim);
  }
  .pg-edited {
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    color: #f59e0b;
  }
  .pg-console-btns {
    margin-left: auto;
    display: flex;
    gap: 8px;
  }
  .pg-btn {
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    cursor: pointer;
    border: 1px solid var(--border);
    background: var(--code-bg);
    color: var(--ink);
    padding: 5px 11px;
    border-radius: 7px;
  }
  .pg-btn:hover {
    color: var(--text-strong);
  }
  .pg-run {
    background: var(--accent);
    color: #fff;
    border-color: transparent;
  }
  .pg-out {
    flex: 1;
    margin: 0;
    padding: 14px;
    overflow: auto;
    font-size: 12.5px;
    line-height: 1.65;
    color: #cbd5e1;
    background: var(--code-bg);
  }
  .pg-output {
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: var(--code-bg);
  }
  .pg-otabs {
    display: flex;
    gap: 2px;
    padding: 8px 10px 0;
    background: var(--code-chrome);
    border-bottom: 1px solid var(--border);
  }
  .pg-otab {
    font-family: "JetBrains Mono", monospace;
    cursor: pointer;
    border: none;
    background: transparent;
    color: var(--dim);
    font-size: 12px;
    font-weight: 600;
    padding: 9px 13px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border-bottom: 2px solid transparent;
  }
  [data-target="ex"] .pg-otab[data-set="ex"],
  [data-target="rs"] .pg-otab[data-set="rs"],
  [data-target="js"] .pg-otab[data-set="js"],
  [data-target="jvm"] .pg-otab[data-set="jvm"] {
    color: var(--text-strong);
    border-bottom-color: var(--accent);
  }
  .pg-panes {
    flex: 1;
    overflow: auto;
    min-height: 0;
  }
  .pg-pane-code {
    height: 100%;
  }
  .pg-status {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px;
    background: var(--accent);
    color: #fff;
    font-size: 11.5px;
  }
  .pg-status-sep {
    opacity: 0.5;
  }
  .pg-status-grow {
    margin-left: auto;
    display: flex;
    gap: 6px;
  }
  .pg-status :global(span span) {
    color: #fff;
  }
  @media (max-width: 860px) {
    .pg-body {
      grid-template-columns: 1fr;
      grid-auto-rows: minmax(280px, auto);
    }
    .pg-left {
      border-right: none;
      border-bottom: 1px solid var(--border);
    }
    .pg {
      height: auto;
    }
  }
</style>
