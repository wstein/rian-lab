---
import { highlight, TARGET_META } from "../../lib/highlight";

interface Cell {
  id: string;
  title: string;
  file: string;
  blurb: string;
  covers: string[];
  source: string;
  panes: Record<string, string>;
  reach: Record<string, string[]>;
}

interface Props {
  cell: Cell;
  /** when true, render the eyebrow/heading (default); set false to embed bare */
  heading?: boolean;
}

const { cell, heading = true } = Astro.props as Props;
const order = ["ex", "rs", "js", "jvm"];

// "Open in Lab" deep-link — the cell source, base64url'd into the playground's `#code=`
// permalink. Built here at build time with Node's `Buffer` so it needs no client JS; the
// browser side (`rian-live.ts` decodeSource) reads the identical encoding (ADR-0090).
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const labHref = `${base}/playground#code=${Buffer.from(cell.source, "utf8").toString("base64url")}`;
---

<section id={cell.id} class="rl-cell" data-cell-id={cell.id}>
  {
    heading && (
      <header class="rl-cell-head">
        <h2>{cell.title}</h2>
        <p class="rl-cell-blurb" set:html={cell.blurb.replace(/`([^`]+)`/g, '<code>$1</code>')} />
        <div class="rl-covers">
          <span class="rl-covers-label">covers</span>
          {cell.covers.map((c) => <code class="rl-mono">{c}</code>)}
        </div>
      </header>
    )
  }

  <div class="rl-grid">
    <div class="rl-col">
      <div class="rl-pane-head">
        <span class="rl-rtile">R</span>
        <span class="rl-pane-name">{cell.file}</span>
        <span class="rl-mono rl-edithint" title="Edit the source — it compiles and runs live in your browser">
          ✎ EDIT · LIVE
        </span>
        <a class="rl-mono rl-lablink" href={labHref} title="Open this source in the Playground (the Lab)">
          Open in Lab ↗
        </a>
      </div>
      <div class="rl-codearea">
        <pre class="rl-code rl-hl" data-cell-hl set:html={highlight(cell.source)}></pre>
        <textarea class="rl-code rl-src" data-cell-src spellcheck="false" autocomplete="off" autocapitalize="off">{cell.source}</textarea>
      </div>
      <pre class="rl-cell-out rl-mono" data-cell-out data-kind="idle">▷ edit the source to compile + run it live</pre>
    </div>
    <div class="rl-col">
      {
        order.map((t) => (
          <div class="rl-pane" data-t={t} style={`border-top:2px solid ${TARGET_META[t].dot};`}>
            <div class="rl-pane-head">
              <span class="rl-dot" style={`background:${TARGET_META[t].dot};`} />
              <span class="rl-pane-name" style={`color:${TARGET_META[t].dot};`}>
                {TARGET_META[t].label}
              </span>
            </div>
            <pre class="rl-code" data-cell-pane={t} set:html={highlight(cell.panes[t])} />
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .rl-cell {
    margin-bottom: 44px;
    scroll-margin-top: 132px;
  }
  .rl-cell-head h2 {
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 8px;
  }
  .rl-cell-blurb {
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--ink);
    margin: 0 0 12px;
    max-width: 640px;
  }
  .rl-cell-blurb :global(code),
  .rl-covers code {
    font-family: "JetBrains Mono", monospace;
    font-size: 12.5px;
    background: var(--active);
    padding: 1px 5px;
    border-radius: 4px;
    color: var(--text-strong);
  }
  .rl-covers {
    display: flex;
    gap: 7px;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 16px;
  }
  .rl-covers-label {
    font-size: 11.5px;
    font-weight: 600;
    color: var(--dim);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .rl-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 1px solid var(--border);
    border-radius: 13px;
    overflow: hidden;
  }
  .rl-col {
    min-width: 0;
    background: var(--code-bg);
  }
  .rl-col:first-child {
    border-right: 1px solid var(--border);
  }
  @media (max-width: 720px) {
    .rl-grid {
      grid-template-columns: 1fr;
    }
    .rl-col:first-child {
      border-right: none;
      border-bottom: 1px solid var(--border);
    }
  }

  /* ── live editable source (overlay editor, same metrics as .rl-code) ──────── */
  .rl-edithint {
    margin-left: auto;
    font-size: 10.5px;
    letter-spacing: 0.06em;
    color: var(--accent);
  }
  .rl-lablink {
    margin-left: 12px;
    font-size: 10.5px;
    letter-spacing: 0.04em;
    color: var(--accent);
    text-decoration: none;
    white-space: nowrap;
  }
  .rl-lablink:hover {
    text-decoration: underline;
  }
  .rl-codearea {
    position: relative;
    min-width: 0;
  }
  .rl-codearea .rl-hl {
    pointer-events: none;
  }
  .rl-codearea .rl-src {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    resize: none;
    white-space: pre;
    background: transparent;
    color: transparent;
    caret-color: var(--accent);
    border: 0;
    outline: none;
  }
  /* live execution line under the source */
  .rl-cell-out {
    margin: 0;
    padding: 9px 18px;
    font-size: 11.5px;
    line-height: 1.5;
    white-space: pre-wrap;
    border-top: 1px solid var(--border);
    background: var(--code-chrome, var(--code-bg));
    color: #94a3b8;
    transition: color 0.12s ease;
  }
  .rl-cell-out[data-kind="hint"],
  .rl-cell-out[data-kind="idle"] {
    color: #64748b;
  }
  .rl-cell-out[data-kind="soft"] {
    color: #d9a441;
  }
  .rl-cell-out[data-kind="ok"] {
    color: #34d399;
  }
</style>
