# ===========================================================================
# SELF-HOSTING — Rian.Pratt ported to Rian, fixpoint-locked (FULL grammar)
# ===========================================================================
# The parser's output is diffed against the reference `Rian.Pratt.parse` over a
# corpus (test/rian/parse_fixpoint_test.exs) with NO projection: the port builds
# the *exact* surface tuples Pratt emits — `{:num,s}`, `{:bin,op,l,r}`, `:wild`,
# `{:lit,v}`, `{:if,c,t,e}`, arms `{pat,guard,body}`, … — as raw Rian tuples/atoms.
# A parametric result `R(node, rest)` threads each `(node, remaining-tokens)` pair.
#
# Coverage: the full expression grammar (prefix `-`/`not`/`&`-capture; primaries
# if/case/with/list/map/tuple/paren-or-lambda/atom/str/char/num/id; postfix
# dot/call; labelled args; precedence climbing) AND the full pattern grammar
# (wild/var/lit/char/atom/tuple/list+tail/map/ctor/struct), plus blocks
# (`:=`/typed/bare statements).
#
# Out of scope (documented surface SUGAR resolved by separate passes, not the core
# grammar): string interpolation `"…${e}…"` (ADR-0069, re-parses hole source) and
# the bare `<-` propagation bind (ADR-0066, desugars a block to a Result `case`).
# ---------------------------------------------------------------------------

mod Parse do
  type Tok := TNum(String)
            | TStr(String)
            | TChar(Int53)
            | TId(String)
            | TKw(String)
            | TOp(String)
            | TLP
            | TRP
            | TLBracket
            | TRBracket
            | TLBrace
            | TRBrace
            | TMapOpen
            | TComma
            | TSemi

  # a (parsed-node, remaining-tokens) pair; `node` is a raw Pratt surface term.
  type R := R(node N, rest Vec(Tok))

  pub def parse(ts Vec(Tok)) N
  pub def parse(ts)
    case parse_bp(0, ts) do
      R(e, _) -> e
    end
  end

  # ── integers / casing (portable, FFI-free) ──
  def parse_int(s String) Int53 := digits(Prim.str_chars(s), 0)

  def digits(Vec(Int53), Int53) Int53
  def digits([], acc) := acc
  def digits([c | rest], acc)
    if c == 95 do
      digits(rest, acc)
    else
      digits(rest, acc * 10 + c - 48)
    end
  end

  def pascal(s String) Bool
    case Prim.str_chars(s) do
      [c | _] -> c >= 65 and c <= 90
      [] -> false
    end
  end

  # ── expression: precedence climbing ──
  def parse_bp(min_bp Int53, ts Vec(Tok)) R
  def parse_bp(min_bp, ts)
    case parse_prefix(ts) do
      R(lhs, rest) -> climb(min_bp, lhs, rest)
    end
  end

  def climb(min_bp Int53, lhs N, ts Vec(Tok)) R
  def climb(min_bp, lhs, [TOp(op) | rest])
    if lbp(op) >= min_bp do
      case parse_bp(rbp(op), rest) do
        R(rhs, rest2) -> climb(min_bp, {:bin, op, lhs, rhs}, rest2)
      end
    else
      R(lhs, [TOp(op) | rest])
    end
  end
  def climb(min_bp, lhs, ts) := R(lhs, ts)

  # prefix := ('-'|'not') prefix@110 | '&' capture | primary
  def parse_prefix(ts Vec(Tok)) R
  def parse_prefix([TOp("-") | rest])
    case parse_bp(110, rest) do
      R(x, rest2) -> R({:unary, "-", x}, rest2)
    end
  end
  def parse_prefix([TOp("not") | rest])
    case parse_bp(110, rest) do
      R(x, rest2) -> R({:unary, "not", x}, rest2)
    end
  end
  def parse_prefix([TOp("&") | rest]) := parse_capture(rest)
  def parse_prefix(ts) := parse_primary(ts)

  # primary := keyword-forms | literals | id  then postfix
  def parse_primary(ts Vec(Tok)) R
  def parse_primary([TKw("if") | rest]) := parse_if(rest)
  def parse_primary([TKw("case") | rest]) := parse_case(rest)
  def parse_primary([TKw("with") | rest]) := parse_with(rest)
  def parse_primary([TLBracket | rest]) := parse_list(rest, [])
  def parse_primary([TMapOpen | rest]) := parse_map(rest, [])
  def parse_primary([TLBrace | rest]) := parse_tuple(rest, [])
  def parse_primary([TLP | rest]) := parse_paren([TLP | rest])
  def parse_primary([TOp(":"), TId(name) | rest]) := parse_postfix({:atom, name}, rest)
  def parse_primary([TStr(s) | rest]) := parse_postfix({:str, s}, rest)
  def parse_primary([TNum(n) | rest]) := parse_postfix({:num, n}, rest)
  def parse_primary([TChar(cp) | rest]) := parse_postfix({:char, cp}, rest)
  def parse_primary([TId(x) | rest]) := parse_postfix({:id, x}, rest)
  def parse_primary(ts) := R(:perr, ts)

  # '(' lambda-or-grouped ')' — lambda iff a top-level `->` follows the match `)`.
  def parse_paren(ts Vec(Tok)) R
  def parse_paren([TLP | rest])
    if lambda_ahead([TLP | rest]) do
      parse_lambda([TLP | rest])
    else
      case parse_bp(0, rest) do
        R(e, [TRP | rest2]) -> parse_postfix(e, rest2)
        R(e, other) -> R(e, other)
      end
    end
  end

  def lambda_ahead(Vec(Tok)) Bool
  def lambda_ahead([TLP | rest]) := arrow_next(after_paren(rest, 1))

  def arrow_next(Vec(Tok)) Bool
  def arrow_next([TOp("->") | _]) := true
  def arrow_next(_) := false

  def after_paren(Vec(Tok), Int53) Vec(Tok)
  def after_paren(ts, 0) := ts
  def after_paren([TLP | t], d) := after_paren(t, d + 1)
  def after_paren([TRP | t], 1) := after_paren(t, 0)
  def after_paren([TRP | t], d) := after_paren(t, d - 1)
  def after_paren([_ | t], d) := after_paren(t, d)
  def after_paren([], _) := []

  # postfix := ('.' id | '(' args ')')*
  def parse_postfix(node N, ts Vec(Tok)) R
  def parse_postfix(node, [TOp("."), TId(name) | rest]) := parse_postfix({:dot, node, name}, rest)
  def parse_postfix(node, [TLP | rest])
    case parse_args(rest) do
      R(args, rest2) -> parse_postfix({:call, node, args}, rest2)
    end
  end
  def parse_postfix(node, ts) := R(node, ts)

  # args := ε | (label|expr) (',' …)*
  def parse_args(ts Vec(Tok)) R
  def parse_args([TRP | rest]) := R([], rest)
  def parse_args([TId(name), TOp(":") | rest])
    case parse_bp(0, rest) do
      R(v, rest2) -> finish_arg({:label, name, v}, rest2)
    end
  end
  def parse_args(ts)
    case parse_bp(0, ts) do
      R(a, rest) -> finish_arg(a, rest)
    end
  end

  def finish_arg(a N, ts Vec(Tok)) R
  def finish_arg(a, [TComma | rest])
    case parse_args(rest) do
      R(more, rest2) -> R([a | more], rest2)
    end
  end
  def finish_arg(a, [TRP | rest]) := R([a], rest)
  def finish_arg(a, ts) := R([a], ts)

  # list literal `[e, …]` / `[e, … | tail]`
  def parse_list(Vec(Tok), Vec(N)) R
  def parse_list([TRBracket | rest], acc) := R({:list_lit, rev(acc), :nil}, rest)
  def parse_list(ts, acc)
    case parse_bp(0, ts) do
      R(e, [TComma | rest]) -> parse_list(rest, [e | acc])
      R(e, [TRBracket | rest]) -> R({:list_lit, rev([e | acc]), :nil}, rest)
      R(e, [TOp("|") | rest]) -> list_tail(rev([e | acc]), rest)
      R(e, other) -> R(:perr, other)
    end
  end

  def list_tail(es Vec(N), ts Vec(Tok)) R
  def list_tail(es, ts)
    case parse_bp(0, ts) do
      R(t, [TRBracket | rest]) -> R({:list_lit, es, {:tail, t}}, rest)
      R(t, other) -> R(:perr, other)
    end
  end

  # tuple literal `{e, …}`
  def parse_tuple(Vec(Tok), Vec(N)) R
  def parse_tuple([TRBrace | rest], acc) := R({:tuple, rev(acc)}, rest)
  def parse_tuple(ts, acc)
    case parse_bp(0, ts) do
      R(e, [TComma | rest]) -> parse_tuple(rest, [e | acc])
      R(e, [TRBrace | rest]) -> R({:tuple, rev([e | acc])}, rest)
      R(e, other) -> R(:perr, other)
    end
  end

  # map literal `%{k: v, …}`
  def parse_map(Vec(Tok), Vec(N)) R
  def parse_map([TRBrace | rest], acc) := R({:map_lit, rev(acc)}, rest)
  def parse_map([TId(k), TOp(":") | rest], acc)
    case parse_bp(0, rest) do
      R(v, [TComma | r]) -> parse_map(r, [{k, v} | acc])
      R(v, [TRBrace | r]) -> R({:map_lit, rev([{k, v} | acc])}, r)
      R(v, other) -> R(:perr, other)
    end
  end

  # lambda `(p, …) -> body`
  def parse_lambda(Vec(Tok)) R
  def parse_lambda([TLP | rest])
    case parse_params(rest) do
      R(params, rest2) ->
        case parse_bp(0, drop_arrow(rest2)) do
          R(body, rest3) -> R({:lambda, params, body}, rest3)
        end
    end
  end

  def drop_arrow(Vec(Tok)) Vec(Tok)
  def drop_arrow([TOp("->") | rest]) := rest
  def drop_arrow(ts) := ts

  def parse_params(Vec(Tok)) R
  def parse_params([TRP | rest]) := R([], rest)
  def parse_params(ts)
    case parse_param(ts) do
      R(p, [TComma | rest]) ->
        case parse_params(rest) do
          R(ps, rest2) -> R([p | ps], rest2)
        end
      R(p, [TRP | rest]) -> R([p], rest)
      R(p, other) -> R([p], other)
    end
  end

  def parse_param(Vec(Tok)) R
  def parse_param([TId(name), TId(ty) | rest]) := R({name, ty}, rest)
  def parse_param([TId(name) | rest]) := R({name, :nil}, rest)

  # capture `&N` / `&(expr)` / `&path/arity`
  def parse_capture(Vec(Tok)) R
  def parse_capture([TNum(n) | rest]) := parse_postfix({:cap_arg, parse_int(n)}, rest)
  def parse_capture([TLP | rest])
    case parse_bp(0, rest) do
      R(body, [TRP | rest2]) -> R({:capture, body}, rest2)
      R(body, other) -> R({:capture, body}, other)
    end
  end
  def parse_capture(ts)
    case parse_path(ts) do
      R(path, [TOp("/"), TNum(n) | rest]) -> R({:capture_named, path, parse_int(n)}, rest)
      R(path, other) -> R(:perr, other)
    end
  end

  def parse_path(Vec(Tok)) R
  def parse_path([TOp(":"), TId(name) | rest]) := collect_dots({:atom, name}, rest)
  def parse_path([TId(name) | rest]) := collect_dots({:id, name}, rest)

  def collect_dots(node N, ts Vec(Tok)) R
  def collect_dots(node, [TOp("."), TId(n) | rest]) := collect_dots({:dot, node, n}, rest)
  def collect_dots(node, ts) := R(node, ts)

  # if / case / with
  def parse_if(Vec(Tok)) R
  def parse_if(ts)
    case parse_bp(0, ts) do
      R(cnd, rest) ->
        case parse_block(drop_kw(rest, "do")) do
          R(then_b, rest2) -> finish_if(cnd, then_b, rest2)
        end
    end
  end

  def finish_if(cnd N, then_b N, ts Vec(Tok)) R
  def finish_if(cnd, then_b, [TKw("else") | rest])
    case parse_block(rest) do
      R(else_b, rest2) -> R({:"if", cnd, then_b, else_b}, drop_kw(rest2, "end"))
    end
  end
  def finish_if(cnd, then_b, ts) := R({:"if", cnd, then_b, {:block, []}}, drop_kw(ts, "end"))

  def parse_case(Vec(Tok)) R
  def parse_case(ts)
    case parse_bp(0, ts) do
      R(scrut, rest) ->
        case parse_arms(drop_kw(rest, "do"), []) do
          R(arms, rest2) -> R({:"case", scrut, arms}, drop_kw(rest2, "end"))
        end
    end
  end

  def parse_arms(Vec(Tok), Vec(N)) R
  def parse_arms([TKw("end") | rest], acc) := R(rev(acc), [TKw("end") | rest])
  def parse_arms(ts, acc)
    case parse_pat(ts) do
      R(pat, rest) -> arm_guard(pat, rest, acc)
    end
  end

  def arm_guard(pat N, ts Vec(Tok), acc Vec(N)) R
  def arm_guard(pat, [TKw("when") | rest], acc)
    case parse_bp(0, rest) do
      R(g, rest2) -> arm_body(pat, g, drop_arrow(rest2), acc)
    end
  end
  def arm_guard(pat, ts, acc) := arm_body(pat, :nil, drop_arrow(ts), acc)

  def arm_body(pat N, guard N, ts Vec(Tok), acc Vec(N)) R
  def arm_body(pat, guard, ts, acc)
    case parse_bp(0, ts) do
      R(body, rest) -> parse_arms(rest, [{pat, guard, body} | acc])
    end
  end

  def parse_with(Vec(Tok)) R
  def parse_with(ts)
    case parse_with_clauses(ts, []) do
      R(clauses, rest) ->
        case parse_block(drop_kw(rest, "do")) do
          R(body, rest2) -> finish_with(clauses, body, rest2)
        end
    end
  end

  def finish_with(clauses N, body N, ts Vec(Tok)) R
  def finish_with(clauses, body, [TKw("else") | rest])
    case parse_arms(rest, []) do
      R(arms, rest2) -> R({:"with", clauses, body, arms}, drop_kw(rest2, "end"))
    end
  end
  def finish_with(clauses, body, ts) := R({:"with", clauses, body, []}, drop_kw(ts, "end"))

  def parse_with_clauses(Vec(Tok), Vec(N)) R
  def parse_with_clauses(ts, acc)
    case parse_pat(ts) do
      R(pat, rest) ->
        case parse_bp(0, drop_op(rest, "<-")) do
          R(e, [TComma | rest2]) -> parse_with_clauses(rest2, [{pat, e} | acc])
          R(e, rest2) -> R(rev([{pat, e} | acc]), rest2)
        end
    end
  end

  # blocks / statements (no `<-` propagation sugar — out of scope)
  def parse_block(Vec(Tok)) R
  def parse_block(ts)
    case parse_stmts(ts, []) do
      R(stmts, rest) -> R({:block, rev(stmts)}, rest)
    end
  end

  def parse_stmts(Vec(Tok), Vec(N)) R
  def parse_stmts([TKw("else") | rest], acc) := R(acc, [TKw("else") | rest])
  def parse_stmts([TKw("end") | rest], acc) := R(acc, [TKw("end") | rest])
  def parse_stmts([], acc) := R(acc, [])
  def parse_stmts(ts, acc)
    case parse_stmt(ts) do
      R(stmt, [TSemi | rest]) -> parse_stmts(rest, [stmt | acc])
      R(stmt, rest) -> R([stmt | acc], rest)
    end
  end

  def parse_stmt(Vec(Tok)) R
  def parse_stmt([TId(name), TOp(":=") | rest])
    case parse_bp(0, rest) do
      R(e, rest2) -> R({:bind, name, e}, rest2)
    end
  end
  def parse_stmt([TId(name), TId(ty0) | more])
    case parse_type([TId(ty0) | more]) do
      R(ty, [TOp(":=") | rest]) -> typed_bind(name, ty, rest)
      R(_, _) -> stmt_expr([TId(name), TId(ty0) | more])
    end
  end
  def parse_stmt(ts) := stmt_expr(ts)

  def typed_bind(name String, ty N, ts Vec(Tok)) R
  def typed_bind(name, ty, ts)
    case parse_bp(0, ts) do
      R(e, rest) -> R({:typed_bind, name, ty, e}, rest)
    end
  end

  def stmt_expr(Vec(Tok)) R
  def stmt_expr(ts)
    case parse_bp(0, ts) do
      R(e, rest) -> R({:expr, e}, rest)
    end
  end

  # type phrase `Name` / `Name(arg, …)` -> a no-interior-space string
  def parse_type(Vec(Tok)) R
  def parse_type([TId(name), TLP | rest])
    case parse_type_args(rest, []) do
      R(args, rest2) -> R(name <> "(" <> join_commas(args) <> ")", rest2)
    end
  end
  def parse_type([TId(name) | rest]) := R(name, rest)

  def parse_type_args(Vec(Tok), Vec(String)) R
  def parse_type_args(ts, acc)
    case parse_type(ts) do
      R(t, [TRP | rest]) -> R(rev([t | acc]), rest)
      R(t, [TComma | rest]) -> parse_type_args(rest, [t | acc])
      R(t, other) -> R(:perr, other)
    end
  end

  def join_commas(Vec(String)) String
  def join_commas([]) := ""
  def join_commas([s]) := s
  def join_commas([s | rest]) := s <> "," <> join_commas(rest)

  # ── pattern grammar ──
  def parse_pat(Vec(Tok)) R
  def parse_pat([TId("_") | rest]) := R(:wild, rest)
  def parse_pat([TOp("-"), TNum(n) | rest]) := R({:lit, 0 - parse_int(n)}, rest)
  def parse_pat([TNum(n) | rest]) := R({:lit, parse_int(n)}, rest)
  def parse_pat([TChar(cp) | rest]) := R({:char_lit, cp}, rest)
  def parse_pat([TOp(":"), TId(name) | rest]) := R({:atom, name}, rest)
  def parse_pat([TStr(s) | rest]) := R({:lit, s}, rest)
  def parse_pat([TLBrace | rest]) := parse_pat_tuple(rest, [])
  def parse_pat([TLBracket | rest]) := parse_pat_list(rest, [])
  def parse_pat([TMapOpen | rest]) := parse_pat_map(rest, [])
  def parse_pat([TId(name) | rest]) := pat_id(name, rest)

  # an identifier pattern: Pascal-case -> ctor/struct, else a variable.
  def pat_id(name String, ts Vec(Tok)) R
  def pat_id(name, ts)
    if pascal(name) do
      pat_ctor(name, ts)
    else
      R({:var, name}, ts)
    end
  end

  def pat_ctor(name String, ts Vec(Tok)) R
  def pat_ctor(name, [TLP, TId(f0), TOp(":") | rest])
    case parse_pat_fields([TId(f0), TOp(":") | rest], []) do
      R(fields, rest2) -> R({:"struct", name, fields}, rest2)
    end
  end
  def pat_ctor(name, [TLP | rest])
    case parse_pat_args(rest, []) do
      R(args, rest2) -> R({:ctor, name, args}, rest2)
    end
  end
  def pat_ctor(name, ts) := R({:ctor, name, []}, ts)

  def parse_pat_args(Vec(Tok), Vec(N)) R
  def parse_pat_args([TRP | rest], acc) := R(rev(acc), rest)
  def parse_pat_args(ts, acc)
    case parse_pat(ts) do
      R(p, [TComma | rest]) -> parse_pat_args(rest, [p | acc])
      R(p, [TRP | rest]) -> R(rev([p | acc]), rest)
      R(p, other) -> R(:perr, other)
    end
  end

  def parse_pat_tuple(Vec(Tok), Vec(N)) R
  def parse_pat_tuple([TRBrace | rest], acc) := R({:tuple, rev(acc)}, rest)
  def parse_pat_tuple(ts, acc)
    case parse_pat(ts) do
      R(p, [TComma | rest]) -> parse_pat_tuple(rest, [p | acc])
      R(p, [TRBrace | rest]) -> R({:tuple, rev([p | acc])}, rest)
      R(p, other) -> R(:perr, other)
    end
  end

  def parse_pat_list(Vec(Tok), Vec(N)) R
  def parse_pat_list([TRBracket | rest], acc) := R({:list, rev(acc), :close}, rest)
  def parse_pat_list(ts, acc)
    case parse_pat(ts) do
      R(p, [TComma | rest]) -> parse_pat_list(rest, [p | acc])
      R(p, [TRBracket | rest]) -> R({:list, rev([p | acc]), :close}, rest)
      R(p, [TOp("|") | rest]) -> pat_list_tail(rev([p | acc]), rest)
      R(p, other) -> R(:perr, other)
    end
  end

  def pat_list_tail(ps Vec(N), ts Vec(Tok)) R
  def pat_list_tail(ps, ts)
    case parse_pat(ts) do
      R(t, [TRBracket | rest]) -> R({:list, ps, {:tail, t}}, rest)
      R(t, other) -> R(:perr, other)
    end
  end

  def parse_pat_map(Vec(Tok), Vec(N)) R
  def parse_pat_map([TRBrace | rest], acc) := R({:map, rev(acc)}, rest)
  def parse_pat_map([TId(k), TOp(":") | rest], acc)
    case parse_pat(rest) do
      R(p, [TComma | r]) -> parse_pat_map(r, [{k, p} | acc])
      R(p, [TRBrace | r]) -> R({:map, rev([{k, p} | acc])}, r)
      R(p, other) -> R(:perr, other)
    end
  end

  def parse_pat_fields(Vec(Tok), Vec(N)) R
  def parse_pat_fields([TRP | rest], acc) := R(rev(acc), rest)
  def parse_pat_fields([TId(k), TOp(":") | rest], acc)
    case parse_pat(rest) do
      R(p, [TComma | r]) -> parse_pat_fields(r, [{k, p} | acc])
      R(p, [TRP | r]) -> R(rev([{k, p} | acc]), r)
      R(p, other) -> R(:perr, other)
    end
  end

  # ── small helpers ──
  def rev(Vec(N)) Vec(N)
  def rev(xs) := rev_onto(xs, [])
  def rev_onto(Vec(N), Vec(N)) Vec(N)
  def rev_onto([], acc) := acc
  def rev_onto([x | xs], acc) := rev_onto(xs, [x | acc])

  def drop_kw(Vec(Tok), String) Vec(Tok)
  def drop_kw([TKw(k) | rest], k) := rest
  def drop_kw(ts, _) := ts

  def drop_op(Vec(Tok), String) Vec(Tok)
  def drop_op([TOp(o) | rest], o) := rest
  def drop_op(ts, _) := ts

  # ── binding powers (mirror Rian.Pratt.bp) ──
  def lbp(op String) Int53 := bp_base(level(op)) + left_off(op)
  def rbp(op String) Int53 := bp_base(level(op)) + right_off(op)
  def bp_base(lvl Int53) Int53 := (13 - lvl) * 10

  def left_off(op String) Int53
  def left_off("<>") := 1
  def left_off(op) := 0

  def right_off(op String) Int53
  def right_off("<>") := 0
  def right_off(op) := 1

  def level(op String) Int53
  def level("*") := 3
  def level("/") := 3
  def level("rem") := 3
  def level("div") := 3
  def level("+") := 4
  def level("-") := 4
  def level("<>") := 5
  def level("<") := 8
  def level("<=") := 8
  def level(">") := 8
  def level(">=") := 8
  def level("==") := 9
  def level("!=") := 9
  def level("and") := 10
  def level("or") := 11
  def level(other) := 100
end
