# ===========================================================================
# SELF-HOSTING — COMPOSITION rung 11: SUM TYPES + constructor-pattern dispatch
# ===========================================================================
# Rung 10 made the whole front-end verified ports but the composed build only
# exercised selfhost_decl's arithmetic/list slice. selfhost_decl ALREADY parses
# `type Name := A | B(T, …)` declarations and constructor patterns/values — that
# capability is equivalence-locked but was unused. This rung widens build's
# SURFACE to use it: sum-type declarations and constructor dispatch, e.g.
#
#   type Color := Red | Green | Blue
#   def code(Red) := 0
#   def code(Green) := 1
#   def code(Blue) := 2
#
# No verified port changes — the front-end (LexerV2 + Decl) and
# back-end (Beam) are the same locked ports as rung 10. Only the driver
# glue grows: the `type` declaration is ERASED (variants are atoms / tagged tuples
# on the BEAM — no codegen), and the Form inflater learns FCtorN / FCtor:
#   nullary ctor pattern/value -> {:atom, 0, snake_atom}     (Red -> :red)
#   applied ctor              -> {:tuple, 0, [{:atom,0,tag} | args]}  (Pair(a,b))
# via a `to_snake` matching Rian.PatternLower.to_snake (SNum -> :s_num, SP -> :sp).
#
# Pipeline (unchanged from rung 10 except the wider inflater):
#   LexerV2.tokenize → Decl.parse_program → normalize (drops DType)
#     → surface→Core lowering → Beam.compile_forms → inflate → load
#
# All three ports load under :"Elixir.*" atoms (Pascal calls, ADR-0041);
# sibling-port calls are composition, not host crutches. Only host FFI:
# :compile.forms / :code.load_binary. selfhost_decl still lacks `if`/strings, so
# widening it off :partial remains the path to a real selfhost_*.rian slice.
# ---------------------------------------------------------------------------

mod ComposeRealSum do
  # ── selfhost_beam's INPUT IR (the shared contract — structurally identical) ──
  type Core := CNum(String)
             | CStr(String)
             | CChar(Int53)
             | CId(String)
             | CAtom(String)
             | CUnary(String, Core)
             | CBin(String, Core, Core)
             | CCall(String, Vec(Core))
             | CLambda(Vec(String), Core)
             | CApply(Core, Vec(Core))
             | CTuple(Vec(Core))
             | CList(Vec(Core), Tail)
             | CIf(Core, Block, Block)
             | CCase(Core, Vec(Arm))

  type Tail := TClose | TTail(Core)
  type Block := Block(Vec(Stmt))
  type Stmt := SBind(String, Core) | STypedBind(String, String, Core) | SExpr(Core)
  type Arm := Arm(Pat, Guard, Block)

  type Pat := PWild
            | PVar(String)
            | PInt(Int53)
            | PStr(String)
            | PChar(Int53)
            | PAtom(String)
            | PCtor(String, Vec(Pat))
            | PTuple(Vec(Pat))
            | PStructP(String, Vec(FldP))
            | PList(Vec(Pat), PTail)

  type PTail := PtlClose | PtlTail(Pat)
  type FldP := FP(String, Pat)
  type Guard := GNone | GSome(Core)
  type Clause := Clause(Vec(Pat), Guard, Block)
  type Func := Func(String, Int53, Vec(Clause))

  # ── selfhost_beam's OUTPUT (the string-carrying Form sum we inflate) ──
  type Form := FInt(Int53)
             | FStr(String)
             | FVar(String)
             | FAtom(String)
             | FCtorN(String)
             | FCtor(String, Vec(Form))
             | FOp1(String, Form)
             | FOp2(String, Form, Form)
             | FCall(String, Vec(Form))
             | FRemote(String, String, Vec(Form))
             | FConcat(Form, Form)
             | FTuple(Vec(Form))
             | FNil
             | FCons(Form, Form)
             | FIf(Form, Vec(Form), Vec(Form))
             | FCase(Form, Vec(FClause))
             | FMatch(String, Form)

  type GForm := GfNone | GfSome(Form)
  type FClause := FClause(Vec(Form), GForm, Vec(Form))
  type FFunc := FFunc(String, Int53, Vec(FClause))

  # ── driver-local types ──
  type NClause := NC(String, Vec(Pat), Guard, Block)
  type Grp := Grp(String, Int53, Vec(NClause))

  # the exhaustiveness gate's env (ADR-0036) — same field shape as Exhaust's
  # CDef/TDef/Env (which only field-READS them, ignoring the struct tag), so these
  # locally-declared structs feed the verified `Exhaust.useful` directly.
  struct CDef(name String, ar Int53, ty String)
  struct TDef(ty String, ctors Vec(String))
  struct Env(cdefs Vec(CDef), tdefs Vec(TDef))

  # the capability lattice (ADR-0055), same shape as Cap's Cap, so the
  # verified `Cap.beam_legal` decides BEAM-legality of a parameter cap.
  type Cap := Iso | Val | Ref | Tag

  # ── the BEAM toolchain boundary: two @external(:ex) host calls (counted FFI) ──
  @external(:ex, ":compile.forms(forms, [:return_errors])")
  def compile_forms_host(forms Vec(Tuple)) Tuple

  @external(:ex, ":code.load_binary(name, chars, bin)")
  def load_binary(name Symbol, chars Vec(Int53), bin String) Tuple

  # a String's BYTES (not codepoints) — what a `{:string, L, Cs}` bin-segment needs,
  # matching Rian.Beam.str_form exactly (codepoints would truncate >255 in an 8-bit
  # segment). Host FFI, counted in the @selfhost_ffi ledger.
  @external(:ex, ":erlang.binary_to_list(s)")
  def str_bytes(s String) Vec(Int53)

  # ── the driver: source -> a loaded, runnable module ──
  pub def build(src String, modname Symbol) Symbol
  pub def build(src, modname)
    case compile_forms_host(compile_module(src, modname)) do
      {:ok, m, bin} -> loaded(load_binary(m, Prim.str_chars("nofile"), bin))
      bad -> refuse_compile(bad)
    end
  end

  def loaded(Tuple) Symbol
  def loaded({:module, m}) := m

  # ── source -> a full :compile.forms input, via the REAL lexer + parser + backend ──
  # the front-end is entirely verified ports: LexerV2.tokenize feeds
  # Decl.parse_program directly (same token tags, no projection). SELF-CHECKING
  # (ADR-0036): the exhaustiveness gate runs first and REFUSES (raises) on a
  # non-exhaustive sum-dispatch function — the compiler rejects bad input rather than
  # silently emitting it. Requires Exhaust to be loaded.
  pub def compile_module(src String, modname Symbol) Vec(Tuple)
  pub def compile_module(src, modname)
    decls := with_protocols(inline_consts(Decl.parse_program(LexerV2.tokenize(src))))
    ncs := normalize(decls)
    grps := group(resolve_ncs(nc_names(ncs), ncs))
    case first_bad(gate_env(decls), grps) do
      "" -> emit_checked(decls, grps, modname)
      bad -> refuse(bad)
    end
  end

  # protocol/impl emission (ADR-0042 §3): desugar every `protocol`/`impl` into its
  # guarded BEAM dispatcher + mangled impl functions, rendered back to Rian source by
  # `Decl.expand_protocols_src` and re-parsed through the same front end, then APPENDED
  # to the decls so `normalize`/`emit_checked` emit them alongside the user functions.
  def with_protocols(decls Vec(Tuple)) Vec(Tuple)
  def with_protocols(decls) := cat(decls, proto_decls(Decl.expand_protocols_src(decls)))

  def proto_decls(String) Vec(Tuple)
  def proto_decls("") := []
  def proto_decls(src) := Decl.parse_program(LexerV2.tokenize(src))

  # variable application (ADR-0042): a bare call `name(args)` is a LOCAL call only if
  # `name` is a top-level function, a constructor (Pascal), or a prim (`__prim_*`);
  # otherwise `name` is a fun-valued bound variable (a param / lambda-param / bind)
  # and the call is variable application `Var(args)`. We rewrite `CCall -> CApply`
  # for that case here, keyed on the GLOBAL function-name set — so no per-scope
  # tracking is needed (a bound var is never a top-level function name).
  def nc_names(Vec(NClause)) Vec(String)
  def nc_names([]) := []
  def nc_names([NC(name, _, _, _) | rest]) := [name | nc_names(rest)]

  def resolve_ncs(fn Vec(String), ncs Vec(NClause)) Vec(NClause)
  def resolve_ncs(_, []) := []
  def resolve_ncs(fn, [NC(name, pats, g, body) | rest]) := [NC(name, pats, rapp_guard(fn, g), rapp_block(fn, body)) | resolve_ncs(fn, rest)]

  def is_local_call(fn Vec(String), name String) Bool := is_ctorish(name) or is_primish(name) or is_guard_bif(name) or member_str(fn, name)

  # the type-test guard BIFs the protocol dispatcher emits (`guard_for`): they are not
  # top-level functions, but they ARE local calls (Erlang guard BIFs) and must NOT be
  # rewritten to variable application — a `Var.(x)` apply is illegal in a guard.
  def is_guard_bif(name String) Bool := name == "is_integer" or name == "is_binary" or name == "is_float" or name == "is_boolean"
  def is_ctorish(name String) Bool := is_upper(first_code(name))
  def is_primish(name String) Bool := first_code(name) == 95
  def first_code(s String) Int53
  def first_code(s)
    case Prim.str_chars(s) do
      [c | _] -> c
      [] -> 0
    end
  end
  def member_str(Vec(String), String) Bool
  def member_str([], _) := false
  def member_str([x | rest], name) := if x == name do true else member_str(rest, name) end

  def rapp(fn Vec(String), c Core) Core
  def rapp(fn, CCall(name, args))
    if is_local_call(fn, name) do
      CCall(name, rapp_all(fn, args))
    else
      CApply(CId(name), rapp_all(fn, args))
    end
  end
  def rapp(fn, CApply(c, args)) := CApply(rapp(fn, c), rapp_all(fn, args))
  def rapp(fn, CLambda(ps, b)) := CLambda(ps, rapp(fn, b))
  def rapp(fn, CUnary(op, x)) := CUnary(op, rapp(fn, x))
  def rapp(fn, CBin(op, l, r)) := CBin(op, rapp(fn, l), rapp(fn, r))
  def rapp(fn, CTuple(es)) := CTuple(rapp_all(fn, es))
  def rapp(fn, CList(es, t)) := CList(rapp_all(fn, es), rapp_tail(fn, t))
  def rapp(fn, CIf(c, t, e)) := CIf(rapp(fn, c), rapp_block(fn, t), rapp_block(fn, e))
  def rapp(fn, CCase(s, arms)) := CCase(rapp(fn, s), rapp_arms(fn, arms))
  def rapp(fn, CStruct(name, flds)) := CStruct(name, rapp_flds(fn, flds))
  def rapp(fn, CMap(flds)) := CMap(rapp_flds(fn, flds))
  def rapp(fn, CDot(h, f)) := CDot(rapp(fn, h), f)
  def rapp(fn, CRemote(m, f, args)) := CRemote(m, f, rapp_all(fn, args))
  def rapp(_, c) := c

  def rapp_all(fn Vec(String), cs Vec(Core)) Vec(Core)
  def rapp_all(_, []) := []
  def rapp_all(fn, [c | rest]) := [rapp(fn, c) | rapp_all(fn, rest)]

  def rapp_tail(fn Vec(String), t Tail) Tail
  def rapp_tail(_, TClose) := TClose
  def rapp_tail(fn, TTail(c)) := TTail(rapp(fn, c))

  def rapp_block(fn Vec(String), b Block) Block
  def rapp_block(fn, Block(ss)) := Block(rapp_stmts(fn, ss))

  def rapp_stmts(fn Vec(String), ss Vec(Stmt)) Vec(Stmt)
  def rapp_stmts(_, []) := []
  def rapp_stmts(fn, [SBind(n, c) | rest]) := [SBind(n, rapp(fn, c)) | rapp_stmts(fn, rest)]
  def rapp_stmts(fn, [STypedBind(n, t, c) | rest]) := [STypedBind(n, t, rapp(fn, c)) | rapp_stmts(fn, rest)]
  def rapp_stmts(fn, [SExpr(c) | rest]) := [SExpr(rapp(fn, c)) | rapp_stmts(fn, rest)]

  def rapp_arms(fn Vec(String), arms Vec(Arm)) Vec(Arm)
  def rapp_arms(_, []) := []
  def rapp_arms(fn, [Arm(p, g, b) | rest]) := [Arm(p, rapp_guard(fn, g), rapp_block(fn, b)) | rapp_arms(fn, rest)]

  def rapp_guard(fn Vec(String), g Guard) Guard
  def rapp_guard(_, GNone) := GNone
  def rapp_guard(fn, GSome(c)) := GSome(rapp(fn, c))

  def rapp_flds(fn Vec(String), flds Vec(SFld)) Vec(SFld)
  def rapp_flds(_, []) := []
  def rapp_flds(fn, [SFld(k, v) | rest]) := [SFld(k, rapp(fn, v)) | rapp_flds(fn, rest)]

  # capability gate (ADR-0055/P5): after exhaustiveness, refuse any function with a
  # BEAM-illegal parameter capability (`ref` → `&mut`, not in the portable core).
  def emit_checked(decls Vec(Tuple), grps Vec(Grp), modname Symbol) Vec(Tuple)
  def emit_checked(decls, grps, modname)
    case first_illegal_cap(decls) do
      "" ->
        case first_num_mix(decls) do
          "" ->
            case first_ret_error(decls) do
              "" ->
                case first_bind_bad(decls) do
                  "" ->
                    case first_bound_bad(decls) do
                      "" -> assemble(modname, funcs(grps))
                      bad -> refuse_type(bad)
                    end
                  bad -> refuse_type(bad)
                end
              bad -> refuse_type(bad)
            end
          bad -> refuse_type(bad)
        end
      bad -> refuse_cap(bad)
    end
  end

  # refusal channels: a non-exhaustive or capability-illegal program is rejected (the
  # BEAM raises). Host FFI (ADR-0068) — `name` is the offending function.
  @external(:ex, ":erlang.error({:non_exhaustive, name})")
  def refuse(name String) Vec(Tuple)

  @external(:ex, ":erlang.error({:not_beam_legal, name})")
  def refuse_cap(name String) Vec(Tuple)

  # the type checker (Checker.num_mix, ADR-0035/P3) proved an int↔float mix in a `d_func`
  # body — the self-built compiler REFUSES it rather than emitting it. `name` is the
  # offending function.
  @external(:ex, ":erlang.error({:type_error, name})")
  def refuse_type(name String) Vec(Tuple)

  # the BEAM toolchain rejected the emitted forms (`:compile.forms` returned a
  # non-`{:ok, _, _}` result — e.g. `{:error, errors, warnings}`). A compile failure
  # is raised loudly, never silently dropped; `bad` is the raw failure term.
  @external(:ex, ":erlang.error({:compile_failed, bad})")
  def refuse_compile(bad Tuple) Symbol

  # an interpolation hole whose static type the AOT resolver cannot determine is
  # REFUSED, not guessed (ADR-0069 §4 — the stringify is chosen by the hole's static
  # type; a `:unknown` hole is a documented limitation: name the value or annotate).
  @external(:ex, ":erlang.error({:unresolved_interp_hole, src})")
  def refuse_interp(src String) Tuple

  def assemble(modname Symbol, fs Vec(Func)) Vec(Tuple) := [{:attribute, 0, :module, modname}, {:attribute, 0, :export, exports(fs)} | inflate_funcs(Beam.compile_forms(fs))]

  def exports(Vec(Func)) Vec(Tuple)
  def exports([]) := []
  def exports([Func(name, arity, _) | rest]) := [{Prim.str_to_atom(name), arity} | exports(rest)]

  # ── normalize: selfhost_decl's Decl IR -> a flat list of (name, pats, body) ──
  # selfhost_decl yields four function-clause forms: a bodiless `DSig` (skipped —
  # it only declares the arity), guarded/unguarded pattern clauses (`DClauseG`/
  # `DClause`), and a single TYPED clause with a body (`DFunc`, e.g.
  # `def tokenize(s String) Vec(Tok) := …`). All but DSig become an NClause; DFunc's
  # params become `PVar` patterns. A `when` guard is carried as `GSome`.
  def normalize(ds) Vec(NClause)
  def normalize([]) := []
  def normalize([{:d_clause, name, pats, expr} | rest]) := [NC(name, lower_pats(pats), GNone, lower_body(desugar_interp([], expr))) | normalize(rest)]
  def normalize([{:d_clause_g, name, pats, guard, expr} | rest]) := [NC(name, lower_pats(pats), GSome(lower_surface(guard)), lower_body(desugar_interp([], expr))) | normalize(rest)]
  def normalize([{:d_func, _, name, params, _, _, body} | rest]) := [NC(name, param_pats(params), GNone, lower_body(desugar_interp(param_tenv(params), body))) | normalize(rest)]
  # a real selfhost_*.rian file wraps its defs in `mod Name do … end`; flatten the
  # module's inner declarations into the same clause stream (its name is the build's
  # `modname`, supplied by the caller).
  def normalize([{:d_mod, _, inner} | rest]) := cat(normalize(inner), normalize(rest))
  # an `@external(:ex, "host expr")` on the following bodiless `DSig` (ADR-0068): the
  # host expression is itself Rian surface (e.g. `:erlang.binary_to_list(s)`), so
  # parse it and splice it as the function body, a single clause whose head binds the
  # signature's params (mirrors Rian.Beam.beam_func for externals).
  def normalize([{:d_extern, "ex", code}, {:d_sig, _, name, params, _, _} | rest]) := [NC(name, param_pats(params), GNone, Block([SExpr(lower_surface(parse_host(code)))])) | normalize(rest)]
  def normalize([_ | rest]) := normalize(rest)

  # parse an `@external` host-code string into a surface expression, via the same
  # verified lexer + the decl parser's exported expression entry point.
  def parse_host(code String) Tuple := Decl.parse_expr(LexerV2.tokenize(code))

  # module constants — `const K Type := <literal>` (DConst). A const is a literal-
  # valued compile-time constant, so the build INLINES references rather than
  # emitting an accessor: `K` is capitalized and would otherwise lower to a nullary-
  # ctor atom, so we collect the consts into a substitution env and rewrite every
  # body's references via the decl parser's exhaustive `subst_e`. An empty env
  # short-circuits, leaving const-free programs byte-identical (v1==v2 safe).
  def inline_consts(ds Vec(Tuple)) Vec(Tuple) := apply_consts(const_env(ds), ds)

  def apply_consts(Vec(Subst), Vec(Tuple)) Vec(Tuple)
  def apply_consts([], ds) := ds
  def apply_consts(env, ds) := subst_decls(env, ds)

  def const_env(ds Vec(Tuple)) Vec(Subst)
  def const_env([]) := []
  def const_env([{:d_const, name, _ty, v} | rest]) := [SB(name, Num(v)) | const_env(rest)]
  def const_env([{:d_mod, _, inner} | rest]) := cat_subst(const_env(inner), const_env(rest))
  def const_env([_ | rest]) := const_env(rest)

  def cat_subst(Vec(Subst), Vec(Subst)) Vec(Subst)
  def cat_subst([], ys) := ys
  def cat_subst([x | xs], ys) := [x | cat_subst(xs, ys)]

  def subst_decls(env Vec(Subst), ds Vec(Tuple)) Vec(Tuple)
  def subst_decls(_, []) := []
  def subst_decls(env, [{:d_clause, name, pats, body} | rest]) := [{:d_clause, name, pats, Decl.subst_e(env, body)} | subst_decls(env, rest)]
  def subst_decls(env, [{:d_clause_g, name, pats, g, body} | rest]) := [{:d_clause_g, name, pats, Decl.subst_e(env, g), Decl.subst_e(env, body)} | subst_decls(env, rest)]
  def subst_decls(env, [{:d_func, a, name, params, b, c, body} | rest]) := [{:d_func, a, name, params, b, c, Decl.subst_e(env, body)} | subst_decls(env, rest)]
  def subst_decls(env, [{:d_mod, n, inner} | rest]) := [{:d_mod, n, subst_decls(env, inner)} | subst_decls(env, rest)]
  def subst_decls(env, [d | rest]) := [d | subst_decls(env, rest)]

  def cat(Vec(NClause), Vec(NClause)) Vec(NClause)
  def cat([], ys) := ys
  def cat([x | xs], ys) := [x | cat(xs, ys)]

  # a `DFunc`'s parameters become plain variable patterns (`def f(a, b) := …`).
  def param_pats(ps) Vec(Pat)
  def param_pats([]) := []
  def param_pats([{:par, n, _, _} | rest]) := [PVar(n) | param_pats(rest)]

  # a clause body -> a selfhost_beam Block. A `BlockE` (multi-statement block body)
  # lowers each statement; any other expression is a one-statement block.
  def lower_body(body) Block
  def lower_body({:block_e, stmts}) := Block(lower_stmts(stmts))
  def lower_body(e) := Block([SExpr(lower_surface(e))])

  # ── AOT string interpolation (ADR-0069) ──────────────────────────────────────
  # An `Interp` node desugars, ahead of time, to a single `Prim.str_concat_all(…)`
  # over its segments — each hole stringified by its STATIC type (no runtime `Show`
  # dispatch, which could not tell a `Char` from an `Int` on the BEAM): `Int*` →
  # `int_to_string`, `Char` → `char_to_string`, `Float*` → `float_repr`, `String` →
  # identity, `Bool` → `if`. The type comes from the hole's literal form or a declared
  # param type (`env`); a hole whose type cannot be resolved is REFUSED (refuse_interp),
  # the documented `:unknown` limitation — name the value or use explicit calls.
  def param_tenv(params Vec(Tuple)) Vec(Tuple)
  def param_tenv([]) := []
  def param_tenv([{:par, n, _, t} | rest]) := [{n, t} | param_tenv(rest)]

  def desugar_interp(env Vec(Tuple), e Tuple) Tuple
  def desugar_interp(env, {:interp, segs}) := {:call, {:dot, {:id, "Prim"}, "str_concat_all"}, stringify_segs(env, segs)}
  def desugar_interp(env, {:bin, op, l, r}) := {:bin, op, desugar_interp(env, l), desugar_interp(env, r)}
  def desugar_interp(env, {:unary, op, x}) := {:unary, op, desugar_interp(env, x)}
  def desugar_interp(env, {:call, c, args}) := {:call, desugar_interp(env, c), di_all(env, args)}
  def desugar_interp(env, {:dot, o, f}) := {:dot, desugar_interp(env, o), f}
  def desugar_interp(env, {:label, n, v}) := {:label, n, desugar_interp(env, v)}
  def desugar_interp(env, {:"if", c, t, e}) := {:"if", desugar_interp(env, c), desugar_interp(env, t), desugar_interp(env, e)}
  def desugar_interp(env, {:"case", s, arms}) := {:"case", desugar_interp(env, s), di_arms(env, arms)}
  def desugar_interp(env, {:"with", cs, b, els}) := {:"with", di_wcs(env, cs), desugar_interp(env, b), di_arms(env, els)}
  def desugar_interp(env, {:block_e, stmts}) := {:block_e, di_stmts(env, stmts)}
  def desugar_interp(env, {:tuple, es}) := {:tuple, di_all(env, es)}
  def desugar_interp(env, {:map_e, flds}) := {:map_e, di_all(env, flds)}
  def desugar_interp(env, {:lam, ps, b}) := {:lam, ps, desugar_interp(env, b)}
  def desugar_interp(env, {:cons_e, h, t}) := {:cons_e, desugar_interp(env, h), desugar_interp(env, t)}
  def desugar_interp(_, x) := x

  def di_all(env Vec(Tuple), es Vec(Tuple)) Vec(Tuple)
  def di_all(_, []) := []
  def di_all(env, [e | rest]) := [desugar_interp(env, e) | di_all(env, rest)]

  def di_arms(env Vec(Tuple), arms Vec(Tuple)) Vec(Tuple)
  def di_arms(_, []) := []
  def di_arms(env, [{:c_arm, pat, body} | rest]) := [{:c_arm, pat, desugar_interp(env, body)} | di_arms(env, rest)]
  def di_arms(env, [{:c_arm_g, pat, g, body} | rest]) := [{:c_arm_g, pat, desugar_interp(env, g), desugar_interp(env, body)} | di_arms(env, rest)]

  def di_wcs(env Vec(Tuple), cs Vec(Tuple)) Vec(Tuple)
  def di_wcs(_, []) := []
  def di_wcs(env, [{:wc, pat, src} | rest]) := [{:wc, pat, desugar_interp(env, src)} | di_wcs(env, rest)]

  def di_stmts(env Vec(Tuple), ss Vec(Tuple)) Vec(Tuple)
  def di_stmts(_, []) := []
  def di_stmts(env, [{:s_bind, n, e} | rest]) := [{:s_bind, n, desugar_interp(env, e)} | di_stmts(env, rest)]
  def di_stmts(env, [{:s_typed_bind, n, ty, e} | rest]) := [{:s_typed_bind, n, ty, desugar_interp(env, e)} | di_stmts(env, rest)]
  def di_stmts(env, [{:s_expr, e} | rest]) := [{:s_expr, desugar_interp(env, e)} | di_stmts(env, rest)]

  def stringify_segs(env Vec(Tuple), segs Vec(Tuple)) Vec(Tuple)
  def stringify_segs(_, []) := []
  def stringify_segs(env, [{:s_lit, s} | rest]) := [{:str, s} | stringify_segs(env, rest)]
  def stringify_segs(env, [{:s_hole, e} | rest]) := [stringify_hole(hole_type(env, e), desugar_interp(env, e)) | stringify_segs(env, rest)]

  # the hole's STATIC type — from its literal form, or a declared param type in `env`.
  def hole_type(env Vec(Tuple), e Tuple) String
  def hole_type(_, {:num, s}) := if num_is_float(s) do "Float64" else "Int53" end
  def hole_type(_, {:str, _}) := "String"
  def hole_type(_, {:char, _}) := "Char"
  def hole_type(_, {:id, "true"}) := "Bool"
  def hole_type(_, {:id, "false"}) := "Bool"
  def hole_type(env, {:id, x}) := lookup_ty(env, x)
  def hole_type(_, {:bin, "<>", _, _}) := "String"
  def hole_type(env, {:bin, op, l, _}) := if is_cmp_op(op) do "Bool" else hole_type(env, l) end
  def hole_type(_, _) := ""

  def lookup_ty(Vec(Tuple), String) String
  def lookup_ty([], _) := ""
  def lookup_ty([{n, t} | rest], x) := if n == x do t else lookup_ty(rest, x) end

  # choose the stringify prim by static type; an unresolved type is refused.
  def stringify_hole(String, Tuple) Tuple
  def stringify_hole("String", e) := e
  def stringify_hole("Char", e) := {:call, {:dot, {:id, "Prim"}, "char_to_string"}, [e]}
  def stringify_hole("Bool", e) := {:"if", e, {:str, "true"}, {:str, "false"}}
  def stringify_hole(t, e)
    if starts_with(t, "Int") or starts_with(t, "UInt") do
      {:call, {:dot, {:id, "Prim"}, "int_to_string"}, [e]}
    else
      stringify_float_or_refuse(t, e)
    end
  end

  def stringify_float_or_refuse(t String, e Tuple) Tuple
  def stringify_float_or_refuse(t, e)
    if starts_with(t, "Float") do
      {:call, {:dot, {:id, "Prim"}, "float_repr"}, [e]}
    else
      refuse_interp(t)
    end
  end

  def num_is_float(s String) Bool := scan_fmark(Prim.str_chars(s))
  def scan_fmark(Vec(Int53)) Bool
  def scan_fmark([]) := false
  def scan_fmark([c | rest]) := if c == 46 or c == 101 or c == 69 do true else scan_fmark(rest) end

  def is_cmp_op(op String) Bool := op == "<" or op == ">" or op == "<=" or op == ">=" or op == "==" or op == "!="

  def starts_with(s String, p String) Bool := pfx(Prim.str_chars(s), Prim.str_chars(p))
  def pfx(Vec(Int53), Vec(Int53)) Bool
  def pfx(_, []) := true
  def pfx([], [_ | _]) := false
  def pfx([c | cs], [p | ps]) := if c == p do pfx(cs, ps) else false end

  def lower_stmts(ss) Vec(Stmt)
  def lower_stmts([]) := []
  def lower_stmts([{:s_bind, n, e} | rest]) := [SBind(n, lower_surface(e)) | lower_stmts(rest)]
  def lower_stmts([{:s_typed_bind, n, ty, e} | rest]) := [STypedBind(n, ty, lower_surface(e)) | lower_stmts(rest)]
  def lower_stmts([{:s_expr, e} | rest]) := [SExpr(lower_surface(e)) | lower_stmts(rest)]

  # ── the surface→Core lowering: selfhost_decl Pat/Expr -> selfhost_beam Pat/Core ──
  def lower_pats(ps) Vec(Pat)
  def lower_pats([]) := []
  def lower_pats([p | rest]) := [lower_pat(p) | lower_pats(rest)]

  pub def lower_pat(p) Pat
  def lower_pat(:wild) := PWild
  def lower_pat(:nil_p) := PList([], PtlClose)
  def lower_pat({:var, n}) := PVar(n)
  def lower_pat({:lit, k}) := PInt(k)
  def lower_pat({:str_p, s}) := PStr(s)
  def lower_pat({:char_p, cp}) := PChar(cp)
  def lower_pat({:ctor, c, ps}) := PCtor(c, lower_pats(ps))
  def lower_pat({:struct_p, c, flds}) := PStructP(c, lower_fldpats(flds))
  def lower_pat({:atom_p, n}) := PAtom(n)
  def lower_pat({:tuple_p, ps}) := PTuple(lower_pats(ps))
  def lower_pat({:cons_p, h, t}) := cons_pat([lower_pat(h)], t)

  def lower_fldpats(flds Vec(Tuple)) Vec(FldP)
  def lower_fldpats([]) := []
  def lower_fldpats([{:fp, f, p} | rest]) := [FP(f, lower_pat(p)) | lower_fldpats(rest)]

  # flatten a cons-pattern chain `[a, b | tl]` into PList([a, b], tail).
  def cons_pat(acc Vec(Pat), t) Pat
  def cons_pat(acc, :nil_p) := PList(rev_pats(acc, []), PtlClose)
  def cons_pat(acc, {:cons_p, h, t}) := cons_pat([lower_pat(h) | acc], t)
  def cons_pat(acc, other) := PList(rev_pats(acc, []), PtlTail(lower_pat(other)))

  def rev_pats(Vec(Pat), Vec(Pat)) Vec(Pat)
  def rev_pats([], out) := out
  def rev_pats([p | rest], out) := rev_pats(rest, [p | out])

  # `pub` so the equivalence bridge (`compose_core_bridge_fixpoint_test`) can render
  # the driver's Core and assert it matches the verified `selfhost_core` oracle
  # (≡ `Rian.Core`). Exported on the sig; the clauses below stay local.
  pub def lower_surface(e) Core
  def lower_surface({:num, s}) := CNum(s)
  def lower_surface({:str, s}) := CStr(s)
  def lower_surface({:char, cp}) := CChar(cp)
  def lower_surface({:id, x}) := CId(x)
  def lower_surface({:atom, n}) := CAtom(n)
  def lower_surface({:tuple, es}) := CTuple(lower_all(es))
  # bare field access `obj.field` as a VALUE (not a call callee) -> a Core field-read
  # (`maps:get`); struct field reads like `cd.name` in exhaust.rian.
  def lower_surface({:dot, obj, field}) := CDot(lower_surface(obj), field)
  def lower_surface({:bin, op, l, r}) := CBin(op, lower_surface(l), lower_surface(r))
  def lower_surface({:unary, op, x}) := CUnary(op, lower_surface(x))
  # a `Prim.X(args)` dot-call is a local intrinsic (`__prim_X`); any other
  # `Mod.fun(args)` dot-call is a cross-module REMOTE call into a sibling self-host
  # module, loaded on the BEAM under its `Elixir.`-prefixed atom (the lexer/decl/beam
  # modules the driver composes). Plain `f(args)` stays a local call.
  def lower_surface({:call, {:dot, {:id, "Prim"}, name}, args}) := CCall(Prim.str_concat("__prim_", name), lower_all(args))
  def lower_surface({:call, {:dot, {:id, mname}, fun}, args}) := CRemote(Prim.str_concat("Elixir.", mname), fun, lower_all(args))
  # a raw-atom module dot-call `:erlang.f(args)` (NO `Elixir.` prefix) — what an
  # `@external(:ex, ":erlang.binary_to_list(s)")` host expression parses to.
  def lower_surface({:call, {:dot, {:atom, m}, fun}, args}) := CRemote(m, fun, lower_all(args))
  # named struct construction `Name(field: v, …)` — labeled args -> a tagged map.
  # (A call's args are all-labeled or none; matching the first label suffices.)
  def lower_surface({:call, {:id, ctor}, [{:label, k, v} | more]}) := CStruct(ctor, lower_flds([{:label, k, v} | more]))
  # a bare `name(args)` is a named call (resolved to variable application later if
  # `name` is a bound var — see `resolve_apply`). A callee that is ANY OTHER
  # expression — a lambda `((x) -> e)(…)`, a curried result `f(a)(b)`, … — is
  # variable application: apply the callee VALUE to the args.
  def lower_surface({:call, {:id, name}, args}) := CCall(name, lower_all(args))
  def lower_surface({:call, callee, args}) := CApply(lower_surface(callee), lower_all(args))
  # a lambda `(params) -> body` (ADR-0042) -> a Core closure; BEAM captures lexically.
  def lower_surface({:lam, ps, b}) := CLambda(ps, lower_surface(b))
  # map literal `%{k: v, …}` — `MapE` of `Label` fields -> a Core map; the fields
  # reuse the labeled-construction lowering (`lower_flds`), but no `__struct__` tag.
  def lower_surface({:map_e, flds}) := CMap(lower_flds(flds))
  # selfhost_decl's `If(cond, then, else)` (single-expr branches) -> selfhost_beam's
  # CIf with single-statement blocks; the backend lowers it to a `case` on the bool.
  def lower_surface({:"if", c, t, e}) := CIf(lower_surface(c), Block([SExpr(lower_surface(t))]), Block([SExpr(lower_surface(e))]))
  # selfhost_decl's `Case(scrut, arms)` -> selfhost_beam's CCase; each arm's pattern
  # reuses lower_pat, its single-expr body becomes a one-statement Block, and a
  # `when` guard becomes GSome (CArm -> GNone).
  def lower_surface({:"case", scrut, arms}) := CCase(lower_surface(scrut), lower_arms(arms))
  # selfhost_decl's `With(clauses, body, els)` desugars to nested `case` HERE, at the
  # AST -> Core boundary (ADR-0039) — the parser kept the construct, this lowering
  # turns it into the Core the backend already understands. Each clause `C <- E`
  # becomes `case E do C -> <rest> ; _with -> <else over _with> end`; a non-matching
  # value falls to the `else` arms, or (with no `else`) is the `with`'s result.
  def lower_surface({:"with", clauses, body, els}) := with_case(clauses, body, els)
  # list construction in a body (`[x | acc]`, `[a, b]`) — a nil/cons chain -> CList,
  # mirroring lower_pat's cons_pat. A non-nil tail becomes TTail (an open list).
  def lower_surface(:nil_e) := CList([], TClose)
  def lower_surface({:cons_e, h, t}) := cons_expr([lower_surface(h)], t)

  def cons_expr(acc Vec(Core), t) Core
  def cons_expr(acc, :nil_e) := CList(rev_core(acc, []), TClose)
  def cons_expr(acc, {:cons_e, h, t}) := cons_expr([lower_surface(h) | acc], t)
  def cons_expr(acc, other) := CList(rev_core(acc, []), TTail(lower_surface(other)))

  def rev_core(Vec(Core), Vec(Core)) Vec(Core)
  def rev_core([], out) := out
  def rev_core([c | rest], out) := rev_core(rest, [c | out])

  def lower_arms(arms) Vec(Arm)
  def lower_arms([]) := []
  def lower_arms([a | rest]) := [lower_arm(a) | lower_arms(rest)]

  def lower_arm(a) Arm
  def lower_arm({:c_arm, pat, body}) := Arm(lower_pat(pat), GNone, Block([SExpr(lower_surface(body))]))
  def lower_arm({:c_arm_g, pat, g, body}) := Arm(lower_pat(pat), GSome(lower_surface(g)), Block([SExpr(lower_surface(body))]))

  # the `with` desugar (ADR-0039). When the clauses are exhausted, the result is the
  # `with` body. Each clause nests a `case` over its expression: the pattern arm
  # continues with the remaining clauses; a catch-all `_with` arm runs the `else`
  # arms (case-style) — or, with no `else`, returns the non-matching value.
  def with_case(cs, body, els) Core
  def with_case([], body, _els) := lower_surface(body)
  def with_case([{:wc, pat, src} | rest], body, els) := CCase(lower_surface(src), [Arm(lower_pat(pat), GNone, Block([SExpr(with_case(rest, body, els))])), Arm(PVar("_with"), GNone, Block([SExpr(else_lower(els))]))])

  def else_lower(els) Core
  def else_lower([]) := CId("_with")
  def else_lower(els) := CCase(CId("_with"), lower_arms(els))

  def lower_all(es) Vec(Core)
  def lower_all([]) := []
  def lower_all([e | rest]) := [lower_surface(e) | lower_all(rest)]

  def lower_flds(es Vec(Tuple)) Vec(SFld)
  def lower_flds([]) := []
  def lower_flds([{:label, k, v} | rest]) := [SFld(k, lower_surface(v)) | lower_flds(rest)]

  # ── group consecutive same-name clauses, wrap each as a beam Func ──
  def group(Vec(NClause)) Vec(Grp)
  def group([]) := []
  def group([NC(name, pats, g, b) | rest]) := group_run(name, plen(pats), [NC(name, pats, g, b)], rest)

  def group_run(name String, arity Int53, acc Vec(NClause), Vec(NClause)) Vec(Grp)
  def group_run(name, arity, acc, []) := [Grp(name, arity, rev_ncs(acc, []))]
  def group_run(name, arity, acc, [NC(n2, p2, g2, b2) | rest])
    if name == n2 do
      group_run(name, arity, [NC(n2, p2, g2, b2) | acc], rest)
    else
      [Grp(name, arity, rev_ncs(acc, [])) | group([NC(n2, p2, g2, b2) | rest])]
    end
  end

  def rev_ncs(Vec(NClause), Vec(NClause)) Vec(NClause)
  def rev_ncs([], out) := out
  def rev_ncs([c | rest], out) := rev_ncs(rest, [c | out])

  def funcs(Vec(Grp)) Vec(Func)
  def funcs([]) := []
  def funcs([Grp(name, arity, ncs) | rest]) := [Func(name, arity, clauses_of(ncs)) | funcs(rest)]

  def clauses_of(Vec(NClause)) Vec(Clause)
  def clauses_of([]) := []
  def clauses_of([NC(_, pats, guard, block) | rest]) := [Clause(pats, guard, block) | clauses_of(rest)]

  def plen(Vec(Pat)) Int53
  def plen([]) := 0
  def plen([_ | rest]) := 1 + plen(rest)

  # ── inflate selfhost_beam's Form sum -> real abstract-form tuples ──
  def inflate_funcs(Vec(FFunc)) Vec(Tuple)
  def inflate_funcs([]) := []
  def inflate_funcs([f | rest]) := [inflate_func(f) | inflate_funcs(rest)]

  def inflate_func(FFunc) Tuple
  def inflate_func(FFunc(name, arity, clauses)) := {:function, 0, Prim.str_to_atom(name), arity, inflate_clauses(clauses)}

  def inflate_clauses(Vec(FClause)) Vec(Tuple)
  def inflate_clauses([]) := []
  def inflate_clauses([c | rest]) := [inflate_clause(c) | inflate_clauses(rest)]

  def inflate_clause(FClause) Tuple
  def inflate_clause(FClause(pats, guard, body)) := {:clause, 0, inflate_all(pats), guard_seq(guard), inflate_all(body)}

  def guard_seq(GForm) Vec(Vec(Tuple))
  def guard_seq(GfNone) := []
  def guard_seq(GfSome(g)) := [[inflate(g)]]

  def inflate_all(Vec(Form)) Vec(Tuple)
  def inflate_all([]) := []
  def inflate_all([f | rest]) := [inflate(f) | inflate_all(rest)]

  # each join part is a `/binary` bit-string segment (str_concat_all).
  def inflate_bin_segs(Vec(Form)) Vec(Tuple)
  def inflate_bin_segs([]) := []
  def inflate_bin_segs([f | rest]) := [{:bin_element, 0, inflate(f), :default, [:binary]} | inflate_bin_segs(rest)]

  # a lambda's parameters -> Erlang variable forms (the fun clause head).
  def param_vars(Vec(String)) Vec(Tuple)
  def param_vars([]) := []
  def param_vars([n | rest]) := [{:var, 0, var_atom(n)} | param_vars(rest)]

  # a struct pattern's field-exacts `field := pat` (FMapPat).
  def inflate_fld_pats(Vec(FFldP)) Vec(Tuple)
  def inflate_fld_pats([]) := []
  def inflate_fld_pats([FFP(f, p) | rest]) := [{:map_field_exact, 0, {:atom, 0, Prim.str_to_atom(f)}, inflate(p)} | inflate_fld_pats(rest)]

  def inflate_flds(Vec(FFld)) Vec(Tuple)
  def inflate_flds([]) := []
  def inflate_flds([FFld(k, v) | rest]) := [{:map_field_assoc, 0, {:atom, 0, Prim.str_to_atom(k)}, inflate(v)} | inflate_flds(rest)]

  def inflate(Form) Tuple
  def inflate(FInt(v)) := {:integer, 0, v}
  def inflate(FFloat(v)) := {:float, 0, v}
  # a string literal -> a binary form `<<"…"/string-segment>>` (Rian.Beam.str_form):
  # one bin-element wrapping the byte list as a `{:string, …}` charlist.
  def inflate(FStr(s)) := {:bin, 0, [{:bin_element, 0, {:string, 0, str_bytes(s)}, :default, :default}]}
  def inflate(FVar(n)) := {:var, 0, var_atom(n)}
  def inflate(FAtom(a)) := {:atom, 0, Prim.str_to_atom(a)}
  def inflate(FNil) := {:nil, 0}
  def inflate(FCons(h, t)) := {:cons, 0, inflate(h), inflate(t)}
  def inflate(FOp1(op, x)) := {:op, 0, op_atom(op), inflate(x)}
  def inflate(FOp2(op, l, r)) := {:op, 0, op_atom(op), inflate(l), inflate(r)}
  def inflate(FCall(f, args)) := {:call, 0, {:atom, 0, Prim.str_to_atom(f)}, inflate_all(args)}
  # a lambda -> a single-clause Erlang `fun` (BEAM closes over free vars lexically).
  def inflate(FFun(params, body)) := {:fun, 0, {:clauses, [{:clause, 0, param_vars(params), [], [inflate(body)]}]}}
  # variable application -> a call whose callee is an EXPRESSION (a var or a fun).
  def inflate(FApply(callee, args)) := {:call, 0, inflate(callee), inflate_all(args)}
  # a Prim lowered to a host remote call (str_chars → String.to_charlist, …).
  def inflate(FRemote(m, fun, args)) := {:call, 0, {:remote, 0, {:atom, 0, Prim.str_to_atom(m)}, {:atom, 0, Prim.str_to_atom(fun)}}, inflate_all(args)}
  # `<>` — binary construction `<<L/binary, R/binary>>` (Rian.Beam), not an op.
  def inflate(FConcat(l, r)) := {:bin, 0, [{:bin_element, 0, inflate(l), :default, [:binary]}, {:bin_element, 0, inflate(r), :default, [:binary]}]}
  # a variadic single-shot binary join (str_concat_all) — one `<<seg, …>>` form.
  def inflate(FBinAll(parts)) := {:bin, 0, inflate_bin_segs(parts)}
  # a Char's UTF-8 string `<<cp/utf8>>` (char_to_string).
  def inflate(FCharBin(c)) := {:bin, 0, [{:bin_element, 0, inflate(c), :default, [:utf8]}]}
  # a nullary constructor (pattern or value) is its snake_case atom; an applied
  # constructor is a tagged tuple {tag, arg, …} — the BEAM rep of a sum value.
  def inflate(FCtorN(c)) := {:atom, 0, to_snake(c)}
  def inflate(FCtor(c, args)) := {:tuple, 0, [{:atom, 0, to_snake(c)} | inflate_all(args)]}
  def inflate(FTuple(es)) := {:tuple, 0, inflate_all(es)}
  # named struct construction -> a tagged map `%{__struct__: <snake>, field: v, …}`
  # (Rian.Beam.expr_form): the `__struct__` field carries the snake-cased type name.
  def inflate(FStruct(name, fields)) := {:map, 0, [{:map_field_assoc, 0, {:atom, 0, Prim.str_to_atom("__struct__")}, {:atom, 0, to_snake(name)}} | inflate_flds(fields)]}
  # a map literal -> a plain Erlang map (no `__struct__` tag); fields reuse inflate_flds.
  def inflate(FMap(fields)) := {:map, 0, inflate_flds(fields)}
  # a struct PATTERN `P(field: pat, …)` -> a map pattern requiring `__struct__ := <snake>`
  # plus each named field exactly (`field := pat`); other fields are ignored.
  def inflate(FMapPat(name, fields)) := {:map, 0, [{:map_field_exact, 0, {:atom, 0, Prim.str_to_atom("__struct__")}, {:atom, 0, to_snake(name)}} | inflate_fld_pats(fields)]}
  # `if` lowers (via selfhost_beam's FIf) to a `case` on the boolean condition.
  def inflate(FIf(c, t, e)) := {:"case", 0, inflate(c), [{:clause, 0, [{:atom, 0, :true}], [], inflate_all(t)}, {:clause, 0, [{:atom, 0, :false}], [], inflate_all(e)}]}
  # `case` -> a real Erlang `case`; each arm is an FClause (single pattern, guard, body).
  def inflate(FCase(scrut, clauses)) := {:"case", 0, inflate(scrut), inflate_clauses(clauses)}
  # a block-body bind (`d := e`) is an Erlang match `D = e`.
  def inflate(FMatch(n, e)) := {:match, 0, {:var, 0, var_atom(n)}, inflate(e)}

  def var_atom(n String) Symbol := Prim.str_to_atom(cap(n))

  # constructor name -> snake_case atom, matching Rian.PatternLower.to_snake:
  # insert `_` before an uppercase that follows a lower/digit, OR before the last
  # uppercase of a cap-run when a lowercase follows (SNum -> s_num, SP -> sp,
  # PPr -> p_pr); then downcase. So a variant value/pattern gets its BEAM tag.
  def to_snake(s String) Symbol := Prim.str_to_atom(Prim.str_from_chars(snake_walk(0, Prim.str_chars(s))))

  def snake_walk(prev Int53, Vec(Int53)) Vec(Int53)
  def snake_walk(prev, []) := []
  def snake_walk(prev, [c | rest])
    if needs_us(prev, c, rest) do
      [95, low(c) | snake_walk(c, rest)]
    else
      [low(c) | snake_walk(c, rest)]
    end
  end

  def needs_us(prev Int53, c Int53, rest Vec(Int53)) Bool
  def needs_us(prev, c, rest)
    if is_upper(c) do
      (is_lower(prev) or is_digit(prev)) or (is_upper(prev) and next_lower(rest))
    else
      false
    end
  end

  def next_lower(Vec(Int53)) Bool
  def next_lower([]) := false
  def next_lower([h | _]) := is_lower(h)

  def is_upper(c Int53) Bool := c >= 65 and c <= 90
  def is_lower(c Int53) Bool := c >= 97 and c <= 122
  def is_digit(c Int53) Bool := c >= 48 and c <= 57
  def low(c Int53) Int53 := up_to_low(c)

  def up_to_low(c Int53) Int53
    if is_upper(c) do
      c + 32
    else
      c
    end
  end

  def op_atom(String) Symbol
  def op_atom("+") := :"+"
  def op_atom("-") := :"-"
  def op_atom("*") := :"*"
  def op_atom("band") := :band
  def op_atom("/") := :"/"
  def op_atom("div") := :"div"
  def op_atom("rem") := :"rem"
  def op_atom("==") := :"=="
  def op_atom("!=") := :"/="
  def op_atom("<") := :"<"
  def op_atom(">") := :">"
  def op_atom(">=") := :">="
  def op_atom("<=") := :"=<"
  def op_atom("and") := :andalso
  def op_atom("or") := :orelse
  def op_atom("not") := :"not"

  def cap(s String) String
    case Prim.str_chars(s) do
      [c | rest] -> Prim.str_from_chars([up(c) | rest])
      [] -> s
    end
  end

  def up(c Int53) Int53
    if c >= 97 and c <= 122 do
      c - 32
    else
      c
    end
  end

  # ── exhaustiveness gate (ADR-0036) — the verified Exhaust port, in-loop ──
  # Build the usefulness env from the program's `type` declarations, then ask
  # Exhaust.useful whether a wildcard row is useful against each function's
  # clause matrix (useful ⇒ an uncovered case ⇒ NON-exhaustive). Read-only: returns
  # "" if every CHECKABLE function is exhaustive, else the first that is not.
  # Functions with guards or non-ctor/wild/var patterns (literals/lists/tuples) are
  # conservatively SKIPPED — the gate decides the sum-type-dispatch subset.
  pub def non_exhaustive(src String) String
  pub def non_exhaustive(src)
    decls := Decl.parse_program(LexerV2.tokenize(src))
    first_bad(gate_env(decls), group(normalize(decls)))
  end

  def gate_env(decls Vec(Tuple)) Env := Env(cdefs: gate_cdefs(decls), tdefs: gate_tdefs(decls))

  def gate_cdefs(decls Vec(Tuple)) Vec(CDef)
  def gate_cdefs([]) := []
  def gate_cdefs([{:d_type, name, vs} | rest]) := cat_cd(vs_cdefs(name, vs), gate_cdefs(rest))
  def gate_cdefs([{:d_pub_type, name, vs} | rest]) := cat_cd(vs_cdefs(name, vs), gate_cdefs(rest))
  def gate_cdefs([{:d_mod, _, inner} | rest]) := cat_cd(gate_cdefs(inner), gate_cdefs(rest))
  def gate_cdefs([_ | rest]) := gate_cdefs(rest)

  def vs_cdefs(ty String, vs Vec(Tuple)) Vec(CDef)
  def vs_cdefs(_, []) := []
  def vs_cdefs(ty, [{:v, c, argtys} | rest]) := [CDef(name: c, ar: vlen(argtys), ty: ty) | vs_cdefs(ty, rest)]

  def gate_tdefs(decls Vec(Tuple)) Vec(TDef)
  def gate_tdefs([]) := []
  def gate_tdefs([{:d_type, name, vs} | rest]) := [TDef(ty: name, ctors: v_names(vs)) | gate_tdefs(rest)]
  def gate_tdefs([{:d_pub_type, name, vs} | rest]) := [TDef(ty: name, ctors: v_names(vs)) | gate_tdefs(rest)]
  def gate_tdefs([{:d_mod, _, inner} | rest]) := cat_td(gate_tdefs(inner), gate_tdefs(rest))
  def gate_tdefs([_ | rest]) := gate_tdefs(rest)

  def v_names(vs Vec(Tuple)) Vec(String)
  def v_names([]) := []
  def v_names([{:v, c, _} | rest]) := [c | v_names(rest)]

  def vlen(xs Vec(String)) Int53
  def vlen([]) := 0
  def vlen([_ | rest]) := 1 + vlen(rest)

  def cat_cd(Vec(CDef), Vec(CDef)) Vec(CDef)
  def cat_cd([], ys) := ys
  def cat_cd([x | xs], ys) := [x | cat_cd(xs, ys)]

  def cat_td(Vec(TDef), Vec(TDef)) Vec(TDef)
  def cat_td([], ys) := ys
  def cat_td([x | xs], ys) := [x | cat_td(xs, ys)]

  def first_bad(env Env, grps Vec(Grp)) String
  def first_bad(_, []) := ""
  def first_bad(env, [Grp(name, ar, cls) | rest])
    if grp_bad(env, ar, cls) do
      name
    else
      first_bad(env, rest)
    end
  end

  def grp_bad(env Env, ar Int53, cls Vec(NClause)) Bool
    if checkable(cls) do
      Exhaust.useful(env, matrix(cls), dup_wild(ar))
    else
      false
    end
  end

  def checkable(Vec(NClause)) Bool
  def checkable([]) := true
  def checkable([NC(_, pats, GNone, _) | rest])
    if pats_ok(pats) do
      checkable(rest)
    else
      false
    end
  end
  def checkable([NC(_, _, GSome(_), _) | rest]) := false

  def pats_ok(Vec(Pat)) Bool
  def pats_ok([]) := true
  def pats_ok([p | rest])
    if pat_ok(p) do
      pats_ok(rest)
    else
      false
    end
  end

  def pat_ok(p Pat) Bool
  def pat_ok(PWild) := true
  def pat_ok(PVar(_)) := true
  def pat_ok(PCtor(_, args)) := pats_ok(args)
  def pat_ok(_) := false

  def matrix(Vec(NClause)) Vec(Vec(Pat))
  def matrix([]) := []
  def matrix([NC(_, pats, _, _) | rest]) := [exh_row(pats) | matrix(rest)]

  def exh_row(Vec(Pat)) Vec(Pat)
  def exh_row([]) := []
  def exh_row([p | rest]) := [to_exh(p) | exh_row(rest)]

  def to_exh(p Pat) Pat
  def to_exh(PWild) := PWild
  def to_exh(PVar(_)) := PWild
  def to_exh(PCtor(c, args)) := PCtor(c, exh_row(args))
  # a struct has a single shape, so a struct pattern always covers its type — treat
  # it as a wildcard for the gate (same approximation the catch-all gives literals).
  def to_exh(PStructP(_, _)) := PWild
  def to_exh(_) := PWild

  def dup_wild(Int53) Vec(Pat)
  def dup_wild(0) := []
  def dup_wild(n) := [PWild | dup_wild(n - 1)]

  # ── capability gate (ADR-0055/P5) — the verified Cap.beam_legal, in-loop ──
  # The first function with a parameter whose capability is not BEAM-legal (`ref`),
  # else "". Caps live on the typed head (DSig/DFunc); pattern clauses carry none.
  def first_illegal_cap(decls Vec(Tuple)) String
  def first_illegal_cap([]) := ""
  def first_illegal_cap([{:d_sig, _, name, params, _, _} | rest]) := cap_or(name, params, rest)
  def first_illegal_cap([{:d_func, _, name, params, _, _, _} | rest]) := cap_or(name, params, rest)
  def first_illegal_cap([{:d_mod, _, inner} | rest]) := mod_cap(first_illegal_cap(inner), rest)
  def first_illegal_cap([_ | rest]) := first_illegal_cap(rest)

  def cap_or(name String, params Vec(Tuple), rest Vec(Tuple)) String
    if params_legal(params) do
      first_illegal_cap(rest)
    else
      name
    end
  end

  def mod_cap(inner String, rest Vec(Tuple)) String
    if inner == "" do
      first_illegal_cap(rest)
    else
      inner
    end
  end

  def params_legal(Vec(Tuple)) Bool
  def params_legal([]) := true
  def params_legal([{:par, _, cap, _} | rest])
    if Cap.beam_legal(to_cap(cap)) do
      params_legal(rest)
    else
      false
    end
  end

  def to_cap(s String) Cap
  def to_cap("iso") := Iso
  def to_cap("ref") := Ref
  def to_cap("tag") := Tag
  def to_cap(_) := Val

  # ── self-CHECKING gate: numeric mix (ADR-0035, P3) ─────────────────────────────
  # The THIRD build-loop gate (after exhaustiveness + capability) — the one that turns
  # the self-built compiler from self-COMPILING into self-CHECKING. It reuses the
  # equivalence-locked `Checker.num_mix` (checker.rian, locked by
  # checker_nummix_fixpoint_test): a `d_func` whose body provably mixes int and float in
  # a `+`/`-`/`*` is REFUSED with `{:type_error, name}` — a value never silently becomes
  # a float. Scoped to `d_func` (the inline `def f(p T) R := body` form); separate-clause
  # functions carry their param types in a sibling `d_sig` and are conservatively skipped
  # (a documented tail — the gate never false-rejects them, so v1==v2 is unaffected).
  # ── sig↔clause correlation (P3 d_clause widening) ──────────────────────────────────
  # The type gates run on `d_func` (inline `def f(p T) R := body`) AND separate-clause
  # functions: a `d_clause`'s param types + return live in its sibling `d_sig`, which
  # `sig_index` collects so `clause_env` can pair the clause's VARIABLE patterns with the
  # declared param types. A clause with no sibling sig is conservatively skipped (no types).
  type SigOpt := SNone | SSome(Vec(Tuple), String)

  def sig_index(Vec(Tuple)) Vec(Tuple)
  def sig_index([]) := []
  def sig_index([{:d_sig, _, name, params, ret, _} | rest]) := [{name, params, ret} | sig_index(rest)]
  def sig_index([_ | rest]) := sig_index(rest)

  def sig_lookup(Vec(Tuple), String) SigOpt
  def sig_lookup([], _) := SNone
  def sig_lookup([{n, params, ret} | rest], name)
    if n == name do
      SSome(params, ret)
    else
      sig_lookup(rest, name)
    end
  end

  # a VARIABLE pattern binds {name -> the sig's positional param type}; any other pattern
  # (literal/ctor/cons/wild) binds nothing — so its position infers `unknown` (conservative).
  def clause_env(Vec(Tuple), Vec(Tuple)) Vec(Tuple)
  def clause_env([], _) := []
  def clause_env(_, []) := []
  def clause_env([{:var, n} | ps], [{:par, _, _, t} | sps]) := [{n, t} | clause_env(ps, sps)]
  def clause_env([_ | ps], [_ | sps]) := clause_env(ps, sps)

  def first_num_mix(decls Vec(Tuple)) String := fnm(sig_index(decls), decls)

  def fnm(Vec(Tuple), Vec(Tuple)) String
  def fnm(_, []) := ""
  def fnm(sigs, [{:d_func, _, name, params, _, _, body} | rest])
    if func_mixes(params, body) do
      name
    else
      fnm(sigs, rest)
    end
  end
  def fnm(sigs, [{:d_clause, name, pats, expr} | rest]) := clause_mix_or(sigs, name, pats, expr, rest)
  def fnm(sigs, [{:d_clause_g, name, pats, _, expr} | rest]) := clause_mix_or(sigs, name, pats, expr, rest)
  def fnm(sigs, [{:d_mod, _, inner} | rest]) := combine_mix(first_num_mix(inner), sigs, rest)
  def fnm(sigs, [_ | rest]) := fnm(sigs, rest)

  def combine_mix(inner String, sigs Vec(Tuple), rest Vec(Tuple)) String
    if inner == "" do
      fnm(sigs, rest)
    else
      inner
    end
  end

  def clause_mix_or(sigs Vec(Tuple), name String, pats Vec(Tuple), expr Tuple, rest Vec(Tuple)) String
    case sig_lookup(sigs, name) do
      SSome(params, _) -> clause_mix_decide(clause_mixes(params, pats, expr), name, sigs, rest)
      SNone -> fnm(sigs, rest)
    end
  end

  def clause_mix_decide(bad Bool, name String, sigs Vec(Tuple), rest Vec(Tuple)) String
    if bad do
      name
    else
      fnm(sigs, rest)
    end
  end

  def clause_mixes(sigParams Vec(Tuple), pats Vec(Tuple), expr Tuple) Bool
    env := clause_env(pats, sigParams)
    Checker.num_mix(to_chk_block(lower_body(desugar_interp(env, expr))), tenv_dict(env), Prim.map_new())
  end

  # lower the body to driver Core, project it onto checker.rian's Core, and ask the
  # locked `Checker.num_mix` under the clause's typed-param env (an empty `ic`: a mix
  # whose operand is a call to a float-returning function is the documented `ic` tail).
  def func_mixes(params Vec(Tuple), body Tuple) Bool
    tenv := param_tenv(params)
    Checker.num_mix(to_chk_block(lower_body(desugar_interp(tenv, body))), tenv_dict(tenv), Prim.map_new())
  end

  # ── self-CHECKING gate: return-type mismatch (ADR-0064/0034, P3) ───────────────────
  # The FOURTH build-loop gate — the canonical type error — reusing the equivalence-locked
  # `Checker.ret_bad` (checker.rian, locked by checker_rettype_fixpoint_test): a `d_func`
  # whose body's inferred type contradicts its declared return (tuple position 5) is
  # REFUSED with `{:type_error, name}`. Same `d_func` scoping + collapsing-projection tail
  # as the numeric-mix gate — an `if`/`case`/block-BODIED return infers `unknown` under the
  # collapse and is conservatively skipped (never a false reject, so v1==v2 is unaffected).
  def first_ret_error(decls Vec(Tuple)) String := fre(sig_index(decls), decls)

  def fre(Vec(Tuple), Vec(Tuple)) String
  def fre(_, []) := ""
  def fre(sigs, [{:d_func, _, name, params, ret, _, body} | rest])
    if func_ret_bad(params, ret, body) do
      name
    else
      fre(sigs, rest)
    end
  end
  def fre(sigs, [{:d_clause, name, pats, expr} | rest]) := clause_ret_or(sigs, name, pats, expr, rest)
  def fre(sigs, [{:d_clause_g, name, pats, _, expr} | rest]) := clause_ret_or(sigs, name, pats, expr, rest)
  def fre(sigs, [{:d_mod, _, inner} | rest]) := combine_ret(first_ret_error(inner), sigs, rest)
  def fre(sigs, [_ | rest]) := fre(sigs, rest)

  def combine_ret(inner String, sigs Vec(Tuple), rest Vec(Tuple)) String
    if inner == "" do
      fre(sigs, rest)
    else
      inner
    end
  end

  def clause_ret_or(sigs Vec(Tuple), name String, pats Vec(Tuple), expr Tuple, rest Vec(Tuple)) String
    case sig_lookup(sigs, name) do
      SSome(params, ret) -> clause_ret_decide(clause_ret_bad(params, ret, pats, expr), name, sigs, rest)
      SNone -> fre(sigs, rest)
    end
  end

  def clause_ret_decide(bad Bool, name String, sigs Vec(Tuple), rest Vec(Tuple)) String
    if bad do
      name
    else
      fre(sigs, rest)
    end
  end

  def clause_ret_bad(sigParams Vec(Tuple), ret String, pats Vec(Tuple), expr Tuple) Bool
    env := clause_env(pats, sigParams)
    Checker.ret_bad(to_chk(block_result(lower_body(desugar_interp(env, expr)))), ret, tenv_dict(env), Prim.map_new())
  end

  # unlike num_mix (which WALKS the body for a mix anywhere), the return gate needs the
  # body's VALUE type — its result expression. We project the lowered block's last
  # expression (the common `def f(…) T := expr` is a one-statement block) and hand THAT to
  # `Checker.ret_bad`. A multi-statement block whose result depends on a local bind infers
  # `unknown` (the local isn't in the param env) → conservatively skipped — a documented tail.
  def func_ret_bad(params Vec(Tuple), ret String, body Tuple) Bool
    tenv := param_tenv(params)
    Checker.ret_bad(to_chk(block_result(lower_body(desugar_interp(tenv, body)))), ret, tenv_dict(tenv), Prim.map_new())
  end

  def block_result(Block) Core
  def block_result(Block(stmts)) := last_expr(stmts)

  def last_expr(Vec(Stmt)) Core
  def last_expr([]) := CId("")
  def last_expr([SExpr(e)]) := e
  def last_expr([SBind(_, e)]) := e
  def last_expr([STypedBind(_, _, e)]) := e
  def last_expr([_ | rest]) := last_expr(rest)

  # ── the THIRD type gate: typed-binding mismatch (Checker.binds_bad, ADR-0034/0064) ──
  # the self-built compiler REFUSES a `name Ann := value` whose value provably contradicts
  # `Ann` ({:type_error, name}). Mirrors `first_ret_error` but hands the body's FULL block
  # statements (structure-preserving `to_chk_stmts`, so the bind annotations survive) to
  # `Checker.binds_bad`, which walks them threading the param env.
  def first_bind_bad(decls Vec(Tuple)) String := fbb(sig_index(decls), decls)

  def fbb(Vec(Tuple), Vec(Tuple)) String
  def fbb(_, []) := ""
  def fbb(sigs, [{:d_func, _, name, params, _, _, body} | rest])
    if func_binds_bad(params, body) do
      name
    else
      fbb(sigs, rest)
    end
  end
  def fbb(sigs, [{:d_clause, name, pats, expr} | rest]) := clause_binds_or(sigs, name, pats, expr, rest)
  def fbb(sigs, [{:d_clause_g, name, pats, _, expr} | rest]) := clause_binds_or(sigs, name, pats, expr, rest)
  def fbb(sigs, [{:d_mod, _, inner} | rest]) := combine_binds(first_bind_bad(inner), sigs, rest)
  def fbb(sigs, [_ | rest]) := fbb(sigs, rest)

  def combine_binds(inner String, sigs Vec(Tuple), rest Vec(Tuple)) String
    if inner == "" do
      fbb(sigs, rest)
    else
      inner
    end
  end

  def clause_binds_or(sigs Vec(Tuple), name String, pats Vec(Tuple), expr Tuple, rest Vec(Tuple)) String
    case sig_lookup(sigs, name) do
      SSome(params, _) -> clause_binds_decide(clause_binds_bad(params, pats, expr), name, sigs, rest)
      SNone -> fbb(sigs, rest)
    end
  end

  def clause_binds_decide(bad Bool, name String, sigs Vec(Tuple), rest Vec(Tuple)) String
    if bad do
      name
    else
      fbb(sigs, rest)
    end
  end

  def clause_binds_bad(sigParams Vec(Tuple), pats Vec(Tuple), expr Tuple) Bool
    env := clause_env(pats, sigParams)
    Checker.binds_bad(block_stmts_chk(lower_body(desugar_interp(env, expr))), tenv_dict(env), Prim.map_new())
  end

  def func_binds_bad(params Vec(Tuple), body Tuple) Bool
    tenv := param_tenv(params)
    Checker.binds_bad(block_stmts_chk(lower_body(desugar_interp(tenv, body))), tenv_dict(tenv), Prim.map_new())
  end

  def block_stmts_chk(Block) Vec(Stmt)
  def block_stmts_chk(Block(stmts)) := to_chk_stmts(stmts)

  # ── the FOURTH type gate: protocol-bound violation (Checker.bounds_bad, ADR-0042 §2) ──
  # the self-built compiler REFUSES a call to a bounded generic `forall T: P` whose `T`
  # instantiates to a concrete type with no `impl P for it` ({:type_error, name}). Builds
  # the `fbounds` (bounded function -> tvars/param-types/bounds) and `impls` (protocol ->
  # implementing types) tables from the decls once, then walks each body with `bounds_bad`.
  def first_bound_bad(decls Vec(Tuple)) String := fbnd(sig_index(decls), fbound_tab(decls), impl_tab(decls), decls)

  def fbnd(Vec(Tuple), Dict(String, Tuple), Dict(String, Vec(String)), Vec(Tuple)) String
  def fbnd(_, _, _, []) := ""
  def fbnd(sigs, fb, im, [{:d_func, _, name, params, _, _, body} | rest])
    if func_bound_bad(params, body, fb, im) do
      name
    else
      fbnd(sigs, fb, im, rest)
    end
  end
  def fbnd(sigs, fb, im, [{:d_clause, name, pats, expr} | rest]) := clause_bound_or(sigs, fb, im, name, pats, expr, rest)
  def fbnd(sigs, fb, im, [{:d_clause_g, name, pats, _, expr} | rest]) := clause_bound_or(sigs, fb, im, name, pats, expr, rest)
  def fbnd(sigs, fb, im, [{:d_mod, _, inner} | rest]) := combine_bound(first_bound_bad(inner), sigs, fb, im, rest)
  def fbnd(sigs, fb, im, [_ | rest]) := fbnd(sigs, fb, im, rest)

  # NB: each gets a type SIG + an UNTYPED clause head. A named param whose type carries an
  # internal comma (`Dict(String, Tuple)`) mis-splits the self-hosted param parser (it drops
  # the params after it); a type-only sig splits correctly, and the untyped clause head is
  # then unambiguous. `clause_env`/`param_tenv` are pure, so computing them twice is fine.
  def combine_bound(String, Vec(Tuple), Dict(String, Tuple), Dict(String, Vec(String)), Vec(Tuple)) String
  def combine_bound(inner, sigs, fb, im, rest) := if inner == "" do fbnd(sigs, fb, im, rest) else inner end

  def clause_bound_or(Vec(Tuple), Dict(String, Tuple), Dict(String, Vec(String)), String, Vec(Tuple), Tuple, Vec(Tuple)) String
  def clause_bound_or(sigs, fb, im, name, pats, expr, rest) :=
    case sig_lookup(sigs, name) do
      SSome(params, _) -> bound_decide(clause_bound_bad(params, pats, expr, fb, im), name, sigs, fb, im, rest)
      SNone -> fbnd(sigs, fb, im, rest)
    end

  def bound_decide(Bool, String, Vec(Tuple), Dict(String, Tuple), Dict(String, Vec(String)), Vec(Tuple)) String
  def bound_decide(bad, name, sigs, fb, im, rest) := if bad do name else fbnd(sigs, fb, im, rest) end

  def clause_bound_bad(Vec(Tuple), Vec(Tuple), Tuple, Dict(String, Tuple), Dict(String, Vec(String))) Bool
  def clause_bound_bad(sigParams, pats, expr, fb, im) :=
    Checker.bounds_bad(to_chk_block(lower_body(desugar_interp(clause_env(pats, sigParams), expr))), tenv_dict(clause_env(pats, sigParams)), Prim.map_new(), fb, im)

  def func_bound_bad(Vec(Tuple), Tuple, Dict(String, Tuple), Dict(String, Vec(String))) Bool
  def func_bound_bad(params, body, fb, im) :=
    Checker.bounds_bad(to_chk_block(lower_body(desugar_interp(param_tenv(params), body))), tenv_dict(param_tenv(params)), Prim.map_new(), fb, im)

  # fbounds: every bounded generic (a `forall` tvar carrying protocol bounds) -> the
  # checker's `FBnd` tuple `{:fb, tvar-names, param-types, [{:p_bound, tvar, protos}]}`.
  def fbound_tab(Vec(Tuple)) Dict(String, Tuple)
  def fbound_tab(decls) := ftab(decls, Prim.map_new())

  def ftab(Vec(Tuple), Dict(String, Tuple)) Dict(String, Tuple)
  def ftab([], acc) := acc
  def ftab([{:d_func, _, name, params, _, tvars, _} | rest], acc) := ftab(rest, add_fbound(name, params, tvars, acc))
  def ftab([{:d_sig, _, name, params, _, tvars} | rest], acc) := ftab(rest, add_fbound(name, params, tvars, acc))
  def ftab([{:d_mod, _, inner} | rest], acc) := ftab(rest, ftab(inner, acc))
  def ftab([_ | rest], acc) := ftab(rest, acc)

  def add_fbound(String, Vec(Tuple), Vec(Tuple), Dict(String, Tuple)) Dict(String, Tuple)
  def add_fbound(name, params, tvars, acc) := add_fb(name, params, tvars, tv_bounds(tvars), acc)

  def add_fb(String, Vec(Tuple), Vec(Tuple), Vec(Tuple), Dict(String, Tuple)) Dict(String, Tuple)
  def add_fb(_, _, _, [], acc) := acc
  def add_fb(name, params, tvars, bounds, acc) := Prim.map_put(acc, name, {:fb, tv_names(tvars), param_types(params), bounds})

  def tv_bounds(Vec(Tuple)) Vec(Tuple)
  def tv_bounds([]) := []
  def tv_bounds([{:tv, _, []} | rest]) := tv_bounds(rest)
  def tv_bounds([{:tv, tn, protos} | rest]) := [{:p_bound, tn, protos} | tv_bounds(rest)]

  def tv_names(Vec(Tuple)) Vec(String)
  def tv_names([]) := []
  def tv_names([{:tv, tn, _} | rest]) := [tn | tv_names(rest)]

  def param_types(Vec(Tuple)) Vec(String)
  def param_types([]) := []
  def param_types([{:par, _, _, ty} | rest]) := [ty | param_types(rest)]

  # impls: protocol -> the list of types that `impl` it (from the `d_impl` facts).
  def impl_tab(Vec(Tuple)) Dict(String, Vec(String))
  def impl_tab(decls) := itab(decls, Prim.map_new())

  def itab(Vec(Tuple), Dict(String, Vec(String))) Dict(String, Vec(String))
  def itab([], acc) := acc
  def itab([{:d_impl, proto, ty, _} | rest], acc) := itab(rest, add_impl(proto, ty, acc))
  def itab([{:d_mod, _, inner} | rest], acc) := itab(rest, itab(inner, acc))
  def itab([_ | rest], acc) := itab(rest, acc)

  def add_impl(String, String, Dict(String, Vec(String))) Dict(String, Vec(String))
  def add_impl(proto, ty, acc) := if Prim.map_has(acc, proto) do Prim.map_put(acc, proto, [ty | Prim.map_get(acc, proto)]) else Prim.map_put(acc, proto, [ty]) end

  # an UNTYPED param carries type "" — omit it so the checker infers `unknown` for it
  # (conservative) rather than treating "" as a concrete type that unifies with nothing.
  def tenv_dict(Vec(Tuple)) Dict(String, String)
  def tenv_dict([]) := Prim.map_new()
  def tenv_dict([{_, ""} | rest]) := tenv_dict(rest)
  def tenv_dict([{n, t} | rest]) := Prim.map_put(tenv_dict(rest), n, t)

  # ── driver Core → checker.rian Core projection (for `Checker.num_mix`) ──────────
  # The driver's Core has 18 constructors and shapes (CIf over Blocks, Arm with a guard,
  # CDot/CRemote/CStruct/CMap, …) that checker.rian's leaner Core lacks. `num_mix` only
  # needs to (a) FIND `+`/`-`/`*` nodes and (b) infer their DIRECT operand types — so the
  # mix-bearing nodes (CBin/CUnary, the leaves, real `__prim_*` CCalls) are preserved with
  # checker's shape, while every structural node is collapsed to a `CCall("__x",
  # children)` that `num_mix` still walks. The collapse uses only the driver's OWN Core
  # constructors (whose runtime tags coincide with checker's for the preserved nodes), so
  # the result types as `Core` AND never invents a CBin — it can therefore never cause a
  # false rejection (v1==v2-safe). An operand that is itself an `if`/`case`/block infers
  # `unknown` under the collapse — the gate is merely more conservative there, never wrong.
  def to_chk(Core) Core
  def to_chk(CNum(s)) := CNum(s)
  def to_chk(CStr(s)) := CStr(s)
  def to_chk(CChar(c)) := CChar(c)
  def to_chk(CId(x)) := CId(x)
  def to_chk(CAtom(_)) := CCall("__atom", [])
  def to_chk(CUnary(op, x)) := CUnary(op, to_chk(x))
  def to_chk(CBin(op, l, r)) := CBin(op, to_chk(l), to_chk(r))
  def to_chk(CCall(f, args)) := CCall(f, to_chk_all(args))
  def to_chk(CLambda(_, body)) := CCall("__lam", [to_chk(body)])
  def to_chk(CApply(callee, args)) := CCall("__apply", [to_chk(callee) | to_chk_all(args)])
  def to_chk(CTuple(es)) := CCall("__tuple", to_chk_all(es))
  def to_chk(CList(es, tail)) := CCall("__list", cat_core(to_chk_all(es), to_chk_tail(tail)))
  def to_chk(CIf(c, t, e)) := CCall("__if", [to_chk(c), to_chk_block(t), to_chk_block(e)])
  def to_chk(CCase(scrut, arms)) := CCall("__case", [to_chk(scrut) | to_chk_arms(arms)])
  def to_chk(CDot(obj, _)) := CCall("__dot", [to_chk(obj)])
  def to_chk(CRemote(_, _, args)) := CCall("__remote", to_chk_all(args))
  def to_chk(CStruct(_, flds)) := CCall("__struct", to_chk_flds(flds))
  def to_chk(CMap(flds)) := CCall("__map", to_chk_flds(flds))

  def to_chk_all(Vec(Core)) Vec(Core)
  def to_chk_all([]) := []
  def to_chk_all([e | rest]) := [to_chk(e) | to_chk_all(rest)]

  def to_chk_block(Block) Core
  def to_chk_block(Block(stmts)) := CCall("__blk", to_chk_stmt_exprs(stmts))

  def to_chk_stmt_exprs(Vec(Stmt)) Vec(Core)
  def to_chk_stmt_exprs([]) := []
  def to_chk_stmt_exprs([SBind(_, e) | rest]) := [to_chk(e) | to_chk_stmt_exprs(rest)]
  def to_chk_stmt_exprs([STypedBind(_, _, e) | rest]) := [to_chk(e) | to_chk_stmt_exprs(rest)]
  def to_chk_stmt_exprs([SExpr(e) | rest]) := [to_chk(e) | to_chk_stmt_exprs(rest)]

  # STRUCTURE-preserving projection (unlike `to_chk_stmt_exprs`, which keeps only the
  # expressions for the num-mix walk): the binding gate needs each stmt's full shape —
  # the bind name + annotation survive so `Checker.binds_bad` sees the typed binds. The
  # driver's `Stmt` tuples are the checker's `Stmt` tuples, so only the VALUE is reprojected.
  def to_chk_stmts(Vec(Stmt)) Vec(Stmt)
  def to_chk_stmts([]) := []
  def to_chk_stmts([SBind(n, e) | rest]) := [SBind(n, to_chk(e)) | to_chk_stmts(rest)]
  def to_chk_stmts([STypedBind(n, ty, e) | rest]) := [STypedBind(n, ty, to_chk(e)) | to_chk_stmts(rest)]
  def to_chk_stmts([SExpr(e) | rest]) := [SExpr(to_chk(e)) | to_chk_stmts(rest)]

  def to_chk_arms(Vec(Arm)) Vec(Core)
  def to_chk_arms([]) := []
  def to_chk_arms([Arm(_, _, blk) | rest]) := [to_chk_block(blk) | to_chk_arms(rest)]

  def to_chk_tail(Tail) Vec(Core)
  def to_chk_tail(TClose) := []
  def to_chk_tail(TTail(e)) := [to_chk(e)]

  def to_chk_flds(Vec(SFld)) Vec(Core)
  def to_chk_flds([]) := []
  def to_chk_flds([SFld(_, v) | rest]) := [to_chk(v) | to_chk_flds(rest)]

  def cat_core(Vec(Core), Vec(Core)) Vec(Core)
  def cat_core([], ys) := ys
  def cat_core([x | xs], ys) := [x | cat_core(xs, ys)]
end
