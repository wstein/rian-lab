# ===========================================================================
# SELF-HOSTING SPIKE — the real type checker (inference), written in Rian
# ===========================================================================
# Goal (ADR-0063 §2, the type-checker stage): infer the type of an expression —
# a slice of the REAL `Rian.Check.infer/3` (not the toy-language `selfhost_check`
# checker). Fixpoint-locked against `Rian.Check.infer` in
# `test/rian/checker_infer_fixpoint_test.exs`.
#
# Inference rules (ADR-0064): a numeric literal is `Int53`, or `Float64` if it
# carries a `.`/`e`/`E`; a string is `String`, a char `Char`, `true`/`false` `Bool`;
# unary `-` passes the operand type through and `not` is `Bool`; a binary op's result
# is determined by the op — comparisons/`and`/`or` are `Bool`, `<>` is `String`, `/`
# is `Float64`, and `+ - * div rem` over integers are `Int53`. The determinate
# primitive intrinsics infer their result type (`__prim_char_code` → `Int53`,
# `__prim_int_to_float` → `Float64`, `__prim_str_to_atom` → `Symbol`,
# `__prim_char_to_string`/`__prim_str_concat_all` → `String`). An unbound identifier
# or a general (non-prim) call is `unknown` — the checker is deliberately
# conservative and does NOT guess.
#
# A typing ENVIRONMENT (name -> type) is threaded through inference: a bound
# variable resolves to its declared type (`infer_env/2`; `infer/1` is the empty-env
# convenience). Arithmetic is OPERAND-DIRECTED (Rian.Check's `arith_type`): an int
# literal adopts a concrete-integer neighbour's width, `Char` ordinals widen to
# `Int53`, float arithmetic is `Float64`, and a mismatch (`Int53 + Float64`) is
# `unknown`. `if` infers the LUB-join of its branches (each a single-expression
# block): the branches climb to their LUB via the full numeric-widening `join`
# (`Int8`⊔`Int53`=`Int53`, `Int53`⊔`Float64`=`Float64`, `UInt8`⊔`Int64`=`Int64`), an
# integer literal adopts a non-literal integer branch, and an incompatible pair is
# `unknown`. `case` infers the LUB-join of its arm bodies, each under the env
# flow-NARROWED by the arm pattern (a variable binds the scrutinee's type). A list
# literal infers `Vec(T)` when its elements (and any cons tail) LUB-join to a concrete
# `T`. A lambda infers its arrow type `Fn(arg.., body)` (an unannotated param is `_`),
# the body inferred under the param bindings. A general call resolves a function-typed
# env var (higher-order: `g(5)` with `g : Fn(Int64,Int64)` -> `Int64`), an applied
# constructor (`ic.ctors`), or a non-generic named function's return (`ic.funs`); a
# bare identifier resolves a nullary constructor's sum type (`ic.ctors`) when not a
# bound variable. Covered Core nodes (12, FULL): CNum/CStr/CChar/CId/CUnary/CBin/CCall/
# CIf/CBlock/CCase/CList/CLambda. Both a typing env AND an inference context `ic`
# (`:ctors`/`:funs`/`:fsigs`/`:tdefs`) are threaded through (`infer_ic/3`; `infer_env/2`
# and `infer/1` are empty-context conveniences). The join LUB is complete (numeric
# widening + the parametric covariant join). GENERIC function-return instantiation
# (`ic.fsigs` with type variables, ADR-0042 — unify declared params with inferred arg
# types, substitute the bound tvars in the return, else `unknown`) and constructor-
# pattern field narrowing (`ic.tdefs` — a `case` arm's ctor pattern binds each field
# variable to its declared field type) are now both implemented, matching
# Rian.Check.infer/3 over the whole inference-context axis. See ADR-0063.
# ---------------------------------------------------------------------------

mod Checker do
  type Core := CNum(String)
             | CStr(String)
             | CChar(Int53)
             | CId(String)
             | CUnary(String, Core)
             | CBin(String, Core, Core)
             | CCall(String, Vec(Core))
             | CIf(Core, Core, Core)
             | CBlock(Vec(Stmt))
             | CCase(Core, Vec(Arm))
             | CList(Vec(Core), Tail)
             | CLambda(Vec(Param), Core)
             | CAtom(String)
             | CTuple(Vec(Core))

  # a list literal's tail: closed (`[a, b]`) or a cons tail expression (`[h | t]`).
  type Tail := TClose | TCons(Core)
  # a lambda parameter: a name + an optional type annotation (absent -> `_`).
  type Param := LP(String, PType)
  type PType := PtNone | PtSome(String)

  # a block statement: a `name := e` bind (extends the env) or a bare expression;
  # the block's type is its last expression's (Rian.Check.infer_block).
  type Stmt := SBind(String, Core) | SExpr(Core) | STypedBind(String, String, Core)
  # a `case` arm: a pattern + a single-expression body (the guard is type-irrelevant).
  # The pattern flow-NARROWS the env: a variable binds the scrutinee's type.
  type Arm := CArm(Pat, Core)
  type Pat := PVar(String) | PCtor(String, Vec(Pat)) | POther
  # a generic function signature (ADR-0042): declared parameter types, return type,
  # and the `forall` type variables — the basis for instantiating a generic return.
  type FSig := FSig(Vec(String), String, Vec(String))
  type FsOpt := FsSome(FSig) | FsNone
  # one `tvar -> concrete type` binding accumulated while unifying params with args.
  type Bind := Bnd(String, String)
  # error set #4 (protocol bounds, ADR-0042 §2): a bounded generic's signature — its
  # `tvars`, declared param types, and `tvar: P + Q` bounds — keyed by function name in
  # `fbounds`; `ProtoBound` is one `tvar -> protocols` pair; `TyLk` is a bind-lookup result.
  type FBnd := FB(Vec(String), Vec(String), Vec(ProtoBound))
  type ProtoBound := PBound(String, Vec(String))
  type TyLk := TyHit(String) | TyMiss
  # error set #5 (`Result(T, E)` error-set check, ADR-0040 §4): the declared error-tag set of a
  # `Result(T, E)` return, or none when the return is not a `Result(T, E)`.
  type EsOpt := EsNone | EsSome(Vec(String))
  # collecting a maximal word-run while tokenizing a type string.
  type WordTake := WT(String, Vec(Int53))
  # a branch/arm with its inferred type, for the LUB join (branch_join).
  type BPair := BP(Core, String)
  # a numeric type decomposed into kind ("int"/"uint"/"float") + bit width, or none.
  type NumKind := NkNone | Nk(String, Int53)
  # a parametric type `Name(arg, …)` decomposed into its name + argument types, or none.
  type PpRes := PpNone | Pp(String, Vec(String))
  # error-set #2 (return type) helpers: an optional constant-integer value, an optional
  # `Vec(_)` element type, and a fixed-width integer's two's-complement bounds.
  type IntOpt := INone | ISome(Int53)
  type VecOpt := VNone | VSome(String)
  type BoundOpt := BNone | B(Int53, Int53)

  # A binary op's result type, keyed by the operator (the integer slice):
  # comparisons/`and`/`or`/`in` -> Bool, `<>` -> String, `/` -> Float64, the
  # arithmetic ops over integers -> Int53.
  def bin_ty(String) String
  def bin_ty("==") := "Bool"
  def bin_ty("!=") := "Bool"
  def bin_ty("<") := "Bool"
  def bin_ty("<=") := "Bool"
  def bin_ty(">") := "Bool"
  def bin_ty(">=") := "Bool"
  def bin_ty("and") := "Bool"
  def bin_ty("or") := "Bool"
  def bin_ty("in") := "Bool"
  def bin_ty("<>") := "String"
  def bin_ty("/") := "Float64"
  def bin_ty("+") := "Int53"
  def bin_ty("-") := "Int53"
  def bin_ty("*") := "Int53"
  def bin_ty("div") := "Int53"
  def bin_ty("rem") := "Int53"

  # A numeric literal: `Float64` if it carries a decimal point or an exponent marker
  # (`.`/`e`/`E`), else the portable `Int53` (ADR-0064 — mirrors Rian.Check's ENum).
  def num_ty(t String) String
  def num_ty(t)
    if float_mark(Prim.str_chars(t)) do
      "Float64"
    else
      "Int53"
    end
  end

  def float_mark(Vec(Int53)) Bool
  def float_mark([]) := false
  def float_mark([c | rest])
    if c == 46 or c == 101 or c == 69 do
      true
    else
      float_mark(rest)
    end
  end

  # ── operand-directed arithmetic result (ADR-0034/0036; mirrors Rian.Check.arith_type) ──
  # `+ - * div rem`. An integer-literal operand is width-flexible — it ADOPTS a
  # concrete-integer neighbour's width (`Int8 + 1` is `Int8`, not the literal's
  # default); two non-literal operands UNIFY their ordinal bases (`Char` → `Int53`,
  # so `'9' - '0'` is `Int53`); a mismatch (e.g. `Int53 + Float64`, no implicit
  # int→float) is conservatively `unknown`.
  def arith_op(op String) Bool := op == "+" or op == "-" or op == "*" or op == "div" or op == "rem"

  def arith_type(l Core, r Core, lt String, rt String) String
  def arith_type(l, r, lt, rt)
    if int_lit_expr(l) and int_type(rt) do
      ordinal_base(rt)
    else
      arith_type2(r, lt, rt)
    end
  end

  def arith_type2(r Core, lt String, rt String) String
  def arith_type2(r, lt, rt)
    if int_lit_expr(r) and int_type(lt) do
      ordinal_base(lt)
    else
      conservative(unify(ordinal_base(lt), ordinal_base(rt)))
    end
  end

  # a constant integer expression of literals (a bare int literal, negation, or
  # arithmetic of such) — the operand that may adopt a typed neighbour's width.
  def int_lit_expr(Core) Bool
  def int_lit_expr(CNum(t)) := int_literal(t)
  def int_lit_expr(CUnary("-", a)) := int_lit_expr(a)
  def int_lit_expr(CBin(op, l, r)) := arith_op(op) and int_lit_expr(l) and int_lit_expr(r)
  # an `if`/`case` branch is a single-expression block (`do 0 end`)
  def int_lit_expr(CBlock([SExpr(e)])) := int_lit_expr(e)
  def int_lit_expr(_) := false

  def int_literal(t String) Bool := not float_mark(Prim.str_chars(t))

  # a concrete integer type: `^U?Int\d*$` (`Int`, `Int8`…`Int128`, `UInt8`…).
  def int_type(t String) Bool := int_word(skip_u(Prim.str_chars(t)))

  def skip_u(Vec(Int53)) Vec(Int53)
  def skip_u(['U' | rest]) := rest
  def skip_u(cs) := cs

  def int_word(Vec(Int53)) Bool
  def int_word(['I', 'n', 't' | rest]) := all_digits(rest)
  def int_word(_) := false

  def all_digits(Vec(Int53)) Bool
  def all_digits([]) := true
  def all_digits([c | rest]) := c >= 48 and c <= 57 and all_digits(rest)

  # `Char`'s ordinal base is its codepoint width `Int53` (ADR-0036); else passthrough.
  def ordinal_base(t String) String
  def ordinal_base("Char") := "Int53"
  def ordinal_base(t) := t

  # the unification kernel (ADR-0033): equal types unify; `unknown` is the identity;
  # else a mismatch (`"mismatch"` sentinel). Fn-structural unify is out of scope here.
  def unify(a String, b String) String
  def unify(a, b)
    if a == b do
      a
    else
      unify_unknown(a, b)
    end
  end

  def unify_unknown(a String, b String) String
  def unify_unknown(a, b)
    if a == "unknown" do
      b
    else
      pick_b_or_mismatch(a, b)
    end
  end

  def pick_b_or_mismatch(a String, b String) String
  def pick_b_or_mismatch(a, b)
    if b == "unknown" do
      a
    else
      "mismatch"
    end
  end

  def conservative(t String) String := if t == "mismatch" do "unknown" else t end

  # Infer the type of a Core node in the empty env + empty inference context.
  pub def infer(Core) String
  pub def infer(c) := infer_ic(c, Prim.map_new(), Prim.map_new())

  # Infer under a typing env only (empty inference context).
  pub def infer_env(Core, Dict(String, String)) String
  pub def infer_env(c, env) := infer_ic(c, env, Prim.map_new())

  # Infer under a typing env AND an inference context `ic` (a map with `:ctors`
  # name->type and `:funs` name->return-type). A bound id resolves to its env type,
  # else a nullary constructor's sum type (`ic.ctors`), else `unknown`. A call
  # resolves a function-typed env var (higher-order), else an applied constructor
  # (`ic.ctors`), else a non-generic named function's return (`ic.funs`). (Generic-
  # return instantiation and constructor-pattern field narrowing — needing `ic.fsigs`
  # / `ic.tdefs` — are the remaining tail.)
  pub def infer_ic(Core, Dict(String, String), Dict(Symbol, Dict(String, String))) String
  pub def infer_ic(CNum(t), _, _) := num_ty(t)
  pub def infer_ic(CStr(_), _, _) := "String"
  pub def infer_ic(CChar(_), _, _) := "Char"
  pub def infer_ic(CId("true"), _, _) := "Bool"
  pub def infer_ic(CId("false"), _, _) := "Bool"
  pub def infer_ic(CId(x), env, ic) := id_ty(x, env, ic)
  pub def infer_ic(CUnary("not", _), _, _) := "Bool"
  pub def infer_ic(CUnary("-", x), env, ic) := infer_ic(x, env, ic)
  pub def infer_ic(CBin(op, l, r), env, ic)
    if arith_op(op) do
      arith_type(l, r, infer_ic(l, env, ic), infer_ic(r, env, ic))
    else
      bin_ty(op)
    end
  end
  pub def infer_ic(CCall("__prim_char_code", [_]), _, _) := "Int53"
  pub def infer_ic(CCall("__prim_int_to_float", [_]), _, _) := "Float64"
  pub def infer_ic(CCall("__prim_str_to_atom", [_]), _, _) := "Symbol"
  pub def infer_ic(CCall("__prim_char_to_string", [_]), _, _) := "String"
  pub def infer_ic(CCall("__prim_str_concat_all", _), _, _) := "String"
  pub def infer_ic(CCall(f, args), env, ic) := call_ty(f, args, env, ic)
  pub def infer_ic(CIf(_, t, e), env, ic) := branch_join([BP(t, infer_ic(t, env, ic)), BP(e, infer_ic(e, env, ic))])
  pub def infer_ic(CBlock(stmts), env, ic) := infer_block(stmts, env, ic)
  pub def infer_ic(CCase(scrut, arms), env, ic) := branch_join(arm_pairs(arms, infer_ic(scrut, env, ic), env, ic))
  pub def infer_ic(CList(elems, tail), env, ic) := list_ty(join_all(infer_all(elems, env, ic)), list_elem(infer_tail(tail, env, ic)))
  pub def infer_ic(CLambda(params, body), env, ic) := build_fn(param_types(params), infer_ic(body, extend_lenv(params, env), ic))
  pub def infer_ic(CAtom(_), _, _) := "Symbol"
  pub def infer_ic(CTuple(_), _, _) := "unknown"

  # a bare identifier: its env type if bound, else a nullary constructor's sum type
  # (`ic.ctors`), else `unknown` (Rian.Check's `Map.get(env,x) || ctor_type(ic,x)`).
  def id_ty(x String, env Dict(String, String), ic Dict(Symbol, Dict(String, String))) String
  def id_ty(x, env, ic)
    if Prim.map_has(env, x) do
      Prim.map_get(env, x)
    else
      ctor_type(ic, x)
    end
  end

  # a call's result: a function-typed env var yields its return type; else an applied
  # constructor's sum type (`ic.ctors`); else a non-generic named function's return
  # (`ic.funs`); else `unknown`.
  # precedence mirrors Rian.Check.infer(ECall): a function-typed env var yields its
  # return; else an applied constructor's sum type (`ic.ctors`); else `called_ret_with`
  # — a generic function's INSTANTIATED return (`ic.fsigs`) or a non-generic one's
  # declared return (`ic.funs`); else `unknown`.
  def call_ty(f String, args Vec(Core), env Dict(String, String), ic Dict(Symbol, Dict(String, String))) String
  def call_ty(f, args, env, ic)
    if Prim.map_has(env, f) do
      call_ret(Prim.map_get(env, f))
    else
      case ctor_type(ic, f) do
        "unknown" -> called_ret_with(f, args, env, ic)
        ty -> ty
      end
    end
  end

  # `ic.ctors[name]` (a nullary or applied constructor's sum type), else `unknown`.
  def ctor_type(ic Dict(Symbol, Dict(String, String)), name String) String := ic_lookup(ic, :ctors, name)

  # a generic function (`ic.fsigs[f]` with type variables) instantiates its return
  # from the call's argument types (ADR-0042); otherwise fall back to the non-generic
  # `ic.funs` return. Mirrors Rian.Check.called_ret_with.
  def called_ret_with(f String, args Vec(Core), env Dict(String, String), ic Dict(Symbol, Dict(String, String))) String
  def called_ret_with(f, args, env, ic)
    case fsig_lookup(ic, f) do
      FsSome(FSig(_, _, [])) -> called_ret(ic, f)
      FsSome(FSig(params, ret, tvars)) -> instantiate_ret(FSig(params, ret, tvars), infer_all(args, env, ic))
      FsNone -> called_ret(ic, f)
    end
  end

  # a non-generic named function's declared return type (`ic.funs[f]`); a return that
  # is *itself* a type variable (or mentions one) is `unknown` — only `fsigs` can pin
  # a generic return (Rian.Check.called_ret).
  def called_ret(ic Dict(Symbol, Dict(String, String)), f String) String
  def called_ret(ic, f)
    ret := ic_lookup(ic, :funs, f)
    if ret == "unknown" do
      "unknown"
    else
      if has_tvar(ret) do "unknown" else ret end
    end
  end

  # ── generic-return instantiation (port of Rian.Check.instantiate_ret) ──────
  # `ic.fsigs[f]` is "params|ret|tvars" (params/tvars comma-joined) — the port's
  # string encoding of `%{params, ret, tvars}`. Decode it, or FsNone when absent.
  def fsig_lookup(ic Dict(Symbol, Dict(String, String)), f String) FsOpt
  def fsig_lookup(ic, f)
    raw := ic_lookup(ic, :fsigs, f)
    if raw == "unknown" do
      FsNone
    else
      FsSome(decode_fsig(raw))
    end
  end

  def decode_fsig(raw String) FSig := mk_fsig(split_pipe(raw))

  def mk_fsig(Vec(String)) FSig
  def mk_fsig([params_str, ret, tvars_str]) := FSig(split_comma(params_str), ret, split_comma(tvars_str))
  def mk_fsig(_) := FSig([], "unknown", [])

  # unify each (declared-param-type, inferred-arg-type) to bind tvars, then substitute
  # them in `ret`. A `ret` tvar the args can't pin -> the whole call is `unknown`
  # (sound); a tvar absent from `ret` need not be pinned (`length(xs Vec(T)) Int53`).
  def instantiate_ret(FSig, Vec(String)) String
  def instantiate_ret(FSig(params, ret, tvars), arg_types)
    binds := bind_all(params, arg_types, tvars, [])
    if all_bound(filter_contained(tvars, ret), binds) do
      subst_all(binds, ret)
    else
      "unknown"
    end
  end

  def bind_all(Vec(String), Vec(String), Vec(String), Vec(Bind)) Vec(Bind)
  def bind_all([], _, _, acc) := acc
  def bind_all(_, [], _, acc) := acc
  def bind_all([p | ps], [a | as], tvars, acc) := bind_all(ps, as, tvars, bind_tvar(p, a, tvars, acc))

  # bind a bare tvar param to its arg type (first binding wins); recurse through a
  # `Vec(T)`/`Vec(X)` structural match; an `unknown` arg or concrete param is inert.
  def bind_tvar(p String, a String, tvars Vec(String), acc Vec(Bind)) Vec(Bind)
  def bind_tvar(p, a, tvars, acc)
    if a == "unknown" do
      acc
    else
      if member_str(p, tvars) do
        if has_bind(acc, p) do acc else [Bnd(p, a) | acc] end
      else
        if both_vec(p, a) do
          bind_tvar(inner(p), inner(a), tvars, acc)
        else
          acc
        end
      end
    end
  end

  def both_vec(p String, a String) Bool := starts_vec(Prim.str_chars(p)) and starts_vec(Prim.str_chars(a))

  # does the codepoint list begin with "Vec(" (86,101,99,40)?
  def starts_vec(Vec(Int53)) Bool
  def starts_vec([86, 101, 99, 40 | _]) := true
  def starts_vec(_) := false

  # the inner type of "Vec(X)" — drop the 4-char "Vec(" prefix and the trailing ")".
  def inner(s String) String := Prim.str_from_chars(drop_last(drop_n(4, Prim.str_chars(s))))

  def drop_n(Int53, Vec(Int53)) Vec(Int53)
  def drop_n(0, cs) := cs
  def drop_n(_, []) := []
  def drop_n(n, [_ | cs]) := drop_n(n - 1, cs)

  def drop_last(Vec(Int53)) Vec(Int53)
  def drop_last([]) := []
  def drop_last([_]) := []
  def drop_last([c | rest]) := [c | drop_last(rest)]

  # the `tvars` that actually appear (as whole tokens) in `ret` need binding.
  def filter_contained(Vec(String), String) Vec(String)
  def filter_contained([], _) := []
  def filter_contained([tv | rest], ret)
    if word_contains(tv, ret) do
      [tv | filter_contained(rest, ret)]
    else
      filter_contained(rest, ret)
    end
  end

  def all_bound(Vec(String), Vec(Bind)) Bool
  def all_bound([], _) := true
  def all_bound([tv | rest], binds) := has_bind(binds, tv) and all_bound(rest, binds)

  # substitute every binding's tvar (as a whole token) in `ret`.
  def subst_all(Vec(Bind), String) String
  def subst_all([], ret) := ret
  def subst_all([Bnd(tv, ty) | rest], ret) := subst_all(rest, word_replace(tv, ty, ret))

  def member_str(String, Vec(String)) Bool
  def member_str(_, []) := false
  def member_str(x, [y | rest]) := if x == y do true else member_str(x, rest) end

  def has_bind(Vec(Bind), String) Bool
  def has_bind([], _) := false
  def has_bind([Bnd(p, _) | rest], x) := if p == x do true else has_bind(rest, x) end

  # ── word-token utilities (word boundary == identifier-run boundary) ────────
  # tokenize a type string into maximal word-runs ([A-Za-z0-9_]) and single
  # non-word chars (kept verbatim), so substitution/containment is per-token.
  def word_contains(tv String, ret String) Bool := member_str(tv, toks(Prim.str_chars(ret)))
  def word_replace(tv String, repl String, ret String) String := concat_strs(map_replace(tv, repl, toks(Prim.str_chars(ret))))
  def has_tvar(ret String) Bool := any_tvar_tok(toks(Prim.str_chars(ret)))

  def any_tvar_tok(Vec(String)) Bool
  def any_tvar_tok([]) := false
  def any_tvar_tok([t | rest]) := if tvar(Prim.str_chars(t)) do true else any_tvar_tok(rest) end

  def map_replace(String, String, Vec(String)) Vec(String)
  def map_replace(_, _, []) := []
  def map_replace(tv, repl, [t | rest]) := [replace_one(tv, repl, t) | map_replace(tv, repl, rest)]

  def replace_one(tv String, repl String, t String) String := if t == tv do repl else t end

  def concat_strs(Vec(String)) String
  def concat_strs([]) := ""
  def concat_strs([x | rest]) := Prim.str_concat(x, concat_strs(rest))

  def toks(Vec(Int53)) Vec(String)
  def toks([]) := []
  def toks([c | rest])
    if word_char(c) do
      case take_word([c | rest], []) do
        WT(tok, more) -> [tok | toks(more)]
      end
    else
      [Prim.str_from_chars([c]) | toks(rest)]
    end
  end

  def take_word(Vec(Int53), Vec(Int53)) WordTake
  def take_word([], acc) := WT(Prim.str_from_chars(rev_i(acc, [])), [])
  def take_word([c | rest], acc)
    if word_char(c) do
      take_word(rest, [c | acc])
    else
      WT(Prim.str_from_chars(rev_i(acc, [])), [c | rest])
    end
  end

  # a word char: [0-9A-Za-z_] by codepoint.
  def word_char(c Int53) Bool := (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95

  # look `name` up in the `key` sub-map of `ic`; `unknown` if either is absent.
  def ic_lookup(ic Dict(Symbol, Dict(String, String)), key Symbol, name String) String
  def ic_lookup(ic, key, name)
    if Prim.map_has(ic, key) do
      sub_lookup(Prim.map_get(ic, key), name)
    else
      "unknown"
    end
  end

  def sub_lookup(m Dict(String, String), name String) String
  def sub_lookup(m, name)
    if Prim.map_has(m, name) do
      Prim.map_get(m, name)
    else
      "unknown"
    end
  end

  # a block's type is its LAST expression's; a `name := e` bind extends the env for
  # the rest (Rian.Check.infer_block). An empty block is `unknown`.
  def infer_block(Vec(Stmt), Dict(String, String), Dict(Symbol, Dict(String, String))) String
  def infer_block([], _, _) := "unknown"
  def infer_block([SExpr(e)], env, ic) := infer_ic(e, env, ic)
  def infer_block([SExpr(_) | rest], env, ic) := infer_block(rest, env, ic)
  def infer_block([SBind(n, e) | rest], env, ic) := infer_block(rest, Prim.map_put(env, n, infer_ic(e, env, ic)), ic)
  def infer_block([STypedBind(n, ann, e) | rest], env, ic) := infer_block(rest, Prim.map_put(env, n, ann), ic)

  # LUB-join of branch/arm types (ADR-0059). An integer-LITERAL branch is
  # width-flexible: when at least one branch is a non-literal, the literals adopt the
  # non-literals' join (if that is an integer); otherwise join ALL branches. (The
  # cross-width numeric widening of Rian.Check's `join` — `Int32`⊔`Int64` = `Int64` —
  # is the remaining tail; here a non-equal join is conservatively `unknown`.)
  def branch_join(Vec(BPair)) String
  def branch_join(typed)
    case non_lit_types(typed) do
      [] -> join_all(all_types(typed))
      non_lit -> adopt_or_join(join_all(non_lit), all_types(typed))
    end
  end

  def adopt_or_join(nlj String, all Vec(String)) String
  def adopt_or_join(nlj, all)
    if int_type(nlj) do
      nlj
    else
      join_all(all)
    end
  end

  def all_types(Vec(BPair)) Vec(String)
  def all_types([]) := []
  def all_types([BP(_, t) | rest]) := [t | all_types(rest)]

  def non_lit_types(Vec(BPair)) Vec(String)
  def non_lit_types([]) := []
  def non_lit_types([BP(e, t) | rest])
    if int_lit_expr(e) do
      non_lit_types(rest)
    else
      [t | non_lit_types(rest)]
    end
  end

  def join_all(Vec(String)) String
  def join_all(ts) := debottom(join_fold(ts, "bottom"))

  def join_fold(Vec(String), String) String
  def join_fold([], acc) := acc
  def join_fold([t | rest], acc) := join_fold(rest, join(acc, t))

  def debottom(t String) String := if t == "bottom" do "unknown" else t end

  # the join kernel (ADR-0059): bottom is the identity, equal types join to
  # themselves, anything with `unknown` is `unknown`, and two distinct NUMERIC types
  # climb to their least-upper-bound width/kind (Rian.Check.join). A non-numeric
  # non-equal pair is `unknown` (parametric covariant join — `Vec(A)`⊔`Vec(B)` — is
  # the remaining tail).
  def join(a String, b String) String
  def join("bottom", b) := b
  def join(a, "bottom") := a
  def join(a, b)
    if a == b do
      a
    else
      join_num(a, b)
    end
  end

  # a non-equal pair: a numeric pair widens; else fall to the parametric covariant
  # join (`Vec(A)`⊔`Vec(B)` = `Vec(A⊔B)`); a non-numeric non-parametric pair is unknown.
  def join_num(a String, b String) String
  def join_num(a, b)
    case num_kind(a) do
      NkNone -> parametric_join(a, b)
      Nk(ka, wa) -> join_num2(ka, wa, b)
    end
  end

  # same-constructor covariant join (Rian.Check.parametric_join): `Name(A..)` ⊔
  # `Name(B..)` = `Name((A⊔B)..)`; an `Fn(...)`, a different constructor, or a
  # non-parametric type ⇒ unknown.
  def parametric_join(a String, b String) String
  def parametric_join(a, b)
    if is_fn(a) or is_fn(b) do
      "unknown"
    else
      pj_parse(parse_parametric(a), b)
    end
  end

  def pj_parse(PpRes, String) String
  def pj_parse(PpNone, _) := "unknown"
  def pj_parse(Pp(na, fa), b)
    case parse_parametric(b) do
      PpNone -> "unknown"
      Pp(nb, fb) -> pj(na, fa, nb, fb)
    end
  end

  def pj(na String, fa Vec(String), nb String, fb Vec(String)) String
  def pj(na, fa, nb, fb)
    if na == nb and len(fa) == len(fb) do
      rebuild(na, join_args(fa, fb))
    else
      "unknown"
    end
  end

  def join_args(Vec(String), Vec(String)) Vec(String)
  def join_args([], []) := []
  def join_args([x | xs], [y | ys]) := [join(x, y) | join_args(xs, ys)]
  def join_args(_, _) := []

  def rebuild(name String, parts Vec(String)) String
  def rebuild(name, parts)
    if any_unknown(parts) do
      "unknown"
    else
      name <> "(" <> join_comma(parts) <> ")"
    end
  end

  def any_unknown(Vec(String)) Bool
  def any_unknown([]) := false
  def any_unknown([t | rest]) := if t == "unknown" do true else any_unknown(rest) end

  def len(Vec(String)) Int53
  def len([]) := 0
  def len([_ | rest]) := 1 + len(rest)

  # a call's result: a function-typed callee yields its return type, else unknown.
  def call_ret(ft String) String
  def call_ret(ft)
    if is_fn(ft) do
      fn_ret(ft)
    else
      "unknown"
    end
  end

  # the return type of an `Fn(arg.., ret)` string: its last component, with `_`
  # (and a type variable) reading back as `unknown` (Rian.Check.fn_ret).
  def fn_ret(ft String) String
  def fn_ret(ft)
    case parse_parametric(ft) do
      Pp(_, args) -> deplaceholder(last_str(args))
      PpNone -> "unknown"
    end
  end

  def last_str(Vec(String)) String
  def last_str([]) := "unknown"
  def last_str([s]) := s
  def last_str([_ | rest]) := last_str(rest)

  def deplaceholder(t String) String
  def deplaceholder("_") := "unknown"
  def deplaceholder(t) := concretize(t)

  def is_fn(s String) Bool := fn_pfx(Prim.str_chars(s))

  def fn_pfx(Vec(Int53)) Bool
  def fn_pfx(['F', 'n', '(' | _]) := true
  def fn_pfx(_) := false

  # `Name(inner)` -> Pp(name, top-level-comma-split args); else PpNone.
  def parse_parametric(s String) PpRes := pp_name(Prim.str_chars(s), [])

  def pp_name(Vec(Int53), Vec(Int53)) PpRes
  def pp_name([40 | rest], acc) := pp_close(rev(acc, []), rev(rest, []))
  def pp_name([c | rest], acc)
    if name_char(c) do
      pp_name(rest, [c | acc])
    else
      PpNone
    end
  end
  def pp_name([], _) := PpNone

  # `rest_rev` is the post-`(` chars reversed; require a trailing `)` and a non-empty
  # name, then split the inner on top-level commas.
  def pp_close(Vec(Int53), Vec(Int53)) PpRes
  def pp_close([], _) := PpNone
  def pp_close(name, [41 | inner_rev]) := Pp(Prim.str_from_chars(name), split_top(rev(inner_rev, [])))
  def pp_close(_, _) := PpNone

  def name_char(c Int53) Bool := (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or (c >= 48 and c <= 57) or c == 95

  # split on commas at paren-depth 0 (so `Vec(A),B` -> ["Vec(A)", "B"]).
  def split_top(cs Vec(Int53)) Vec(String) := st(cs, [], [], 0)

  def st(Vec(Int53), Vec(Int53), Vec(String), Int53) Vec(String)
  def st([], seg, segs, _) := rev_str(add_seg(seg, segs), [])
  def st([44 | rest], seg, segs, 0) := st(rest, [], add_seg(seg, segs), 0)
  def st([40 | rest], seg, segs, d) := st(rest, [40 | seg], segs, d + 1)
  def st([41 | rest], seg, segs, d) := st(rest, [41 | seg], segs, d - 1)
  def st([c | rest], seg, segs, d) := st(rest, [c | seg], segs, d)

  def add_seg(seg Vec(Int53), segs Vec(String)) Vec(String) := [Prim.str_from_chars(rev(seg, [])) | segs]

  def rev_str(Vec(String), Vec(String)) Vec(String)
  def rev_str([], out) := out
  def rev_str([s | rest], out) := rev_str(rest, [s | out])

  def join_num2(ka String, wa Int53, b String) String
  def join_num2(ka, wa, b)
    case num_kind(b) do
      NkNone -> "unknown"
      Nk(kb, wb) -> num_join(ka, wa, kb, wb)
    end
  end

  # same kind -> widest width; else the cross-kind rules (uint⊔int, int⊔float, …).
  def num_join(ka String, wa Int53, kb String, wb Int53) String
  def num_join(ka, wa, kb, wb)
    if ka == kb do
      kind_prefix(ka) <> Prim.int_to_string(max2(wa, wb))
    else
      num_join_mixed(ka, wa, kb, wb)
    end
  end

  def num_join_mixed(ka String, wa Int53, kb String, wb Int53) String
  def num_join_mixed("uint", wa, "int", wb) := uint_signed_join(wa, wb)
  def num_join_mixed("int", wa, "uint", wb) := uint_signed_join(wb, wa)
  def num_join_mixed("int", wa, "float", wb) := int_float_join(wa - 1, wb)
  def num_join_mixed("float", wa, "int", wb) := int_float_join(wb - 1, wa)
  def num_join_mixed("uint", wa, "float", wb) := int_float_join(wa, wb)
  def num_join_mixed("float", wa, "uint", wb) := int_float_join(wb, wa)
  def num_join_mixed(_, _, _, _) := "unknown"

  # `UIntᵤ ⊔ Intᵢ` = least Int width strictly wider than `u` (to hold the unsigned
  # range) and at least `i`; none ⇒ `unknown`.
  def uint_signed_join(u Int53, i Int53) String := find_int_width([8, 16, 32, 64, 128], u, i)

  def find_int_width(Vec(Int53), Int53, Int53) String
  def find_int_width([], _, _) := "unknown"
  def find_int_width([c | rest], u, i)
    if c > u and c >= i do
      "Int" <> Prim.int_to_string(c)
    else
      find_int_width(rest, u, i)
    end
  end

  # Int/UInt ⊔ Float = least Float width ≥ the float operand whose mantissa holds the
  # integer's `exact` bits; none ⇒ `unknown`.
  def int_float_join(exact Int53, fb Int53) String := find_float_width([32, 64], exact, fb)

  def find_float_width(Vec(Int53), Int53, Int53) String
  def find_float_width([], _, _) := "unknown"
  def find_float_width([c | rest], exact, fb)
    if c >= fb and float_mantissa(c) >= exact do
      "Float" <> Prim.int_to_string(c)
    else
      find_float_width(rest, exact, fb)
    end
  end

  def float_mantissa(Int53) Int53
  def float_mantissa(64) := 53
  def float_mantissa(32) := 24
  def float_mantissa(_) := 0

  def kind_prefix(k String) String
  def kind_prefix("int") := "Int"
  def kind_prefix("uint") := "UInt"
  def kind_prefix("float") := "Float"
  def kind_prefix(_) := ""

  def max2(a Int53, b Int53) Int53 := if a >= b do a else b end

  # decompose `UInt`/`Int`/`Float` + a non-empty all-digit width; else NkNone (so a
  # bare `Int` (arbitrary precision) / `Bool` / `Char` is not numeric here).
  def num_kind(t String) NumKind := nk(Prim.str_chars(t))

  def nk(Vec(Int53)) NumKind
  def nk(['U', 'I', 'n', 't' | rest]) := nk_width("uint", rest)
  def nk(['I', 'n', 't' | rest]) := nk_width("int", rest)
  def nk(['F', 'l', 'o', 'a', 't' | rest]) := nk_width("float", rest)
  def nk(_) := NkNone

  def nk_width(kind String, w Vec(Int53)) NumKind
  def nk_width(_, []) := NkNone
  def nk_width(kind, w)
    if all_digits(w) do
      Nk(kind, parse_digits(w, 0))
    else
      NkNone
    end
  end

  def parse_digits(Vec(Int53), Int53) Int53
  def parse_digits([], acc) := acc
  def parse_digits([c | rest], acc) := parse_digits(rest, acc * 10 + c - 48)

  # each arm -> a (body, type) pair, the body inferred under the narrowed env.
  def arm_pairs(Vec(Arm), String, Dict(String, String), Dict(Symbol, Dict(String, String))) Vec(BPair)
  def arm_pairs([], _, _, _) := []
  def arm_pairs([CArm(pat, body) | rest], st, env, ic) := [BP(body, infer_ic(body, narrow(pat, st, env, ic), ic)) | arm_pairs(rest, st, env, ic)]

  # flow narrowing (Rian.Check.narrow): a VARIABLE pattern binds the scrutinee's
  # (concretized) type; a CONSTRUCTOR pattern looks up its field types (`ic.tdefs`,
  # ";"-encoded) and narrows each argument against the field at its position (an
  # unknown ctor / missing field -> `unknown`); every other pattern is inert.
  def narrow(Pat, String, Dict(String, String), Dict(Symbol, Dict(String, String))) Dict(String, String)
  def narrow(PVar(x), st, env, _) := Prim.map_put(env, x, concretize(st))
  def narrow(PCtor(ctor, args), _, env, ic) := narrow_args(args, field_types(ic, ctor), env, ic)
  def narrow(POther, _, env, _) := env

  # narrow each constructor argument against the field type at its position; a field
  # beyond the declared list (unknown ctor / arity slack) narrows against `unknown`.
  def narrow_args(Vec(Pat), Vec(String), Dict(String, String), Dict(Symbol, Dict(String, String))) Dict(String, String)
  def narrow_args([], _, env, _) := env
  def narrow_args([p | ps], [t | ts], env, ic) := narrow_args(ps, ts, narrow(p, t, env, ic), ic)
  def narrow_args([p | ps], [], env, ic) := narrow_args(ps, [], narrow(p, "unknown", env, ic), ic)

  # `ic.tdefs[ctor]` is the ";"-joined field types (Rian.Decl stores a list; the
  # port encodes it as a string to keep `ic` a `Dict(String,String)`); split it, or
  # [] when the ctor is absent.
  def field_types(ic Dict(Symbol, Dict(String, String)), ctor String) Vec(String) := split_semi(ic_lookup(ic, :tdefs, ctor))

  # split on a codepoint separator into pieces, dropping empties (so "unknown"/"" ->
  # []). `split_semi`/`split_comma`/`split_pipe` are the ';'/','/'|' specializations.
  def split_semi(s String) Vec(String) := split_drop(59, s)
  def split_comma(s String) Vec(String) := split_drop(44, s)
  def split_pipe(s String) Vec(String) := split_drop(124, s)

  def split_drop(sep Int53, s String) Vec(String) := ss_parts(sep, Prim.str_chars(s), [], [])

  def ss_parts(Int53, Vec(Int53), Vec(Int53), Vec(Vec(Int53))) Vec(String)
  def ss_parts(_, [], cur, parts) := ss_finish(rev_i([rev_i(cur, []) | parts], []))
  def ss_parts(sep, [c | rest], cur, parts)
    if c == sep do
      ss_parts(sep, rest, [], [rev_i(cur, []) | parts])
    else
      ss_parts(sep, rest, [c | cur], parts)
    end
  end

  def ss_finish(Vec(Vec(Int53))) Vec(String)
  def ss_finish([]) := []
  def ss_finish([p | rest])
    if int_empty(p) do
      ss_finish(rest)
    else
      [Prim.str_from_chars(p) | ss_finish(rest)]
    end
  end

  def int_empty(Vec(Int53)) Bool
  def int_empty([]) := true
  def int_empty(_) := false

  def rev_i(Vec(Int53), Vec(Int53)) Vec(Int53)
  def rev_i([], acc) := acc
  def rev_i([x | xs], acc) := rev_i(xs, [x | acc])

  # a type *variable* (a single upper-case letter + optional digit, e.g. `T`/`T1`)
  # narrows to `unknown` — generics are not instantiated yet (conservative).
  def concretize(t String) String
  def concretize(t)
    if tvar(Prim.str_chars(t)) do
      "unknown"
    else
      t
    end
  end

  def tvar(Vec(Int53)) Bool
  def tvar([c]) := c >= 65 and c <= 90
  def tvar([c, d]) := c >= 65 and c <= 90 and d >= 48 and d <= 57
  def tvar(_) := false

  # ── list inference helpers (Rian.Check) ──
  def infer_all(Vec(Core), Dict(String, String), Dict(Symbol, Dict(String, String))) Vec(String)
  def infer_all([], _, _) := []
  def infer_all([e | rest], env, ic) := [infer_ic(e, env, ic) | infer_all(rest, env, ic)]

  def infer_tail(Tail, Dict(String, String), Dict(Symbol, Dict(String, String))) String
  def infer_tail(TClose, _, _) := "unknown"
  def infer_tail(TCons(e), env, ic) := infer_ic(e, env, ic)

  # the element type the list type carries: `Vec(T)` -> `T`; anything else -> unknown.
  def list_elem(t String) String := le(Prim.str_chars(t))

  def le(Vec(Int53)) String
  def le(['V', 'e', 'c', '(' | rest]) := Prim.str_from_chars(trim_rparens(rest))
  def le(_) := "unknown"

  # the list type for a concrete element; an `unknown` element yields `unknown`.
  def list_ty(elem_t String, tail_elem String) String
  def list_ty(elem_t, tail_elem)
    if tail_elem == "unknown" or tail_elem == elem_t do
      list_of(conservative(elem_t))
    else
      "unknown"
    end
  end

  def list_of(t String) String := if t == "unknown" do "unknown" else "Vec(" <> t <> ")" end

  # drop ALL trailing `)` (mirrors String.trim_trailing(rest, ")")) — reverse, skip
  # leading `)`, reverse back.
  def trim_rparens(cs Vec(Int53)) Vec(Int53) := rev(skip_rparen(rev(cs, [])), [])

  def rev(Vec(Int53), Vec(Int53)) Vec(Int53)
  def rev([], acc) := acc
  def rev([c | rest], acc) := rev(rest, [c | acc])

  def skip_rparen(Vec(Int53)) Vec(Int53)
  def skip_rparen([41 | rest]) := skip_rparen(rest)
  def skip_rparen(cs) := cs

  # ── lambda inference helpers (Rian.Check.build_fn) ──
  # extend the env with each param's type (an unannotated param binds `unknown`).
  def extend_lenv(Vec(Param), Dict(String, String)) Dict(String, String)
  def extend_lenv([], env) := env
  def extend_lenv([LP(n, PtSome(t)) | rest], env) := extend_lenv(rest, Prim.map_put(env, n, t))
  def extend_lenv([LP(n, PtNone) | rest], env) := extend_lenv(rest, Prim.map_put(env, n, "unknown"))

  def param_types(Vec(Param)) Vec(String)
  def param_types([]) := []
  def param_types([LP(_, PtSome(t)) | rest]) := [t | param_types(rest)]
  def param_types([LP(_, PtNone) | rest]) := ["unknown" | param_types(rest)]

  # `Fn(arg1,..,argN,ret)` — each component is its type or `_` for `unknown`.
  def build_fn(args Vec(String), ret String) String := "Fn(" <> join_comma(comps(cat_str(args, [ret]))) <> ")"

  def comps(Vec(String)) Vec(String)
  def comps([]) := []
  def comps([t | rest]) := [comp_str(t) | comps(rest)]

  def comp_str(t String) String := if t == "unknown" do "_" else t end

  def join_comma(Vec(String)) String
  def join_comma([]) := ""
  def join_comma([s]) := s
  def join_comma([s | rest]) := s <> "," <> join_comma(rest)

  def cat_str(Vec(String), Vec(String)) Vec(String)
  def cat_str([], ys) := ys
  def cat_str([x | xs], ys) := [x | cat_str(xs, ys)]

  # ── error set #1: numeric mix (ADR-0035) — the first SELF-CHECKING gate ──────────
  # The inference above never rejects; it infers `unknown` and moves on. This is the
  # first port of a Rian.Check ERROR SET — the boundary check that turns the compiler
  # from self-COMPILING into (partially) self-CHECKING. `Rian.Check.check_numeric_mix`:
  # a `+`/`-`/`*` whose two operands are concretely a different numeric KIND (one
  # int/uint, the other float) is REJECTED — a value never silently becomes a float.
  # `num_mix` walks one clause body's Core and returns true iff such a mix exists.
  # CONSERVATIVE: an operand inferred `unknown` (or non-numeric) never triggers — only a
  # PROVABLE int↔float mix. The env is FIXED across the walk (no case-narrow / block-bind
  # / lambda-extend as we descend), mirroring the reference's `scan_num_mix`.
  pub def num_mix(Core, Dict(String, String), Dict(Symbol, Dict(String, String))) Bool
  pub def num_mix(CNum(_), _, _) := false
  pub def num_mix(CStr(_), _, _) := false
  pub def num_mix(CChar(_), _, _) := false
  pub def num_mix(CId(_), _, _) := false
  pub def num_mix(CUnary(_, a), env, ic) := num_mix(a, env, ic)
  pub def num_mix(CBin(op, l, r), env, ic)
    if mix_op(op) and mixed_kind(ordinal_base(infer_ic(l, env, ic)), ordinal_base(infer_ic(r, env, ic))) do
      true
    else
      num_mix(l, env, ic) or num_mix(r, env, ic)
    end
  end
  pub def num_mix(CCall(_, args), env, ic) := num_mix_any(args, env, ic)
  pub def num_mix(CIf(c, t, e), env, ic) := num_mix(c, env, ic) or num_mix(t, env, ic) or num_mix(e, env, ic)
  pub def num_mix(CBlock(stmts), env, ic) := num_mix_stmts(stmts, env, ic)
  pub def num_mix(CCase(scrut, arms), env, ic) := num_mix(scrut, env, ic) or num_mix_arms(arms, env, ic)
  pub def num_mix(CList(elems, tail), env, ic) := num_mix_any(elems, env, ic) or num_mix_tail(tail, env, ic)
  pub def num_mix(CLambda(_, body), env, ic) := num_mix(body, env, ic)
  pub def num_mix(CAtom(_), _, _) := false
  pub def num_mix(CTuple(es), env, ic) := num_mix_any(es, env, ic)

  # the mix arithmetic ops are EXACTLY Rian.Check's @arith = `+ - *` (NOT div/rem, which
  # are integer-only; `arith_op`'s wider set is for inference, not this gate).
  def mix_op(op String) Bool := op == "+" or op == "-" or op == "*"

  # one operand int/uint-kind, the other float-kind, both concrete (Rian.Check.mixed_num?
  # / num_mix?). NkNone (a non-numeric type, or `unknown`) never mixes.
  def mixed_kind(lt String, rt String) Bool := km(num_kind(lt), num_kind(rt))
  def km(NumKind, NumKind) Bool
  def km(Nk(lk, _), Nk(rk, _)) := kind_mix(lk, rk)
  def km(_, _) := false
  def kind_mix(lk String, rk String) Bool := (lk == "float" and int_kind(rk)) or (rk == "float" and int_kind(lk))
  def int_kind(k String) Bool := k == "int" or k == "uint"

  def num_mix_any(Vec(Core), Dict(String, String), Dict(Symbol, Dict(String, String))) Bool
  def num_mix_any([], _, _) := false
  def num_mix_any([c | rest], env, ic) := num_mix(c, env, ic) or num_mix_any(rest, env, ic)

  def num_mix_stmts(Vec(Stmt), Dict(String, String), Dict(Symbol, Dict(String, String))) Bool
  def num_mix_stmts([], _, _) := false
  def num_mix_stmts([SBind(_, e) | rest], env, ic) := num_mix(e, env, ic) or num_mix_stmts(rest, env, ic)
  def num_mix_stmts([STypedBind(_, _, e) | rest], env, ic) := num_mix(e, env, ic) or num_mix_stmts(rest, env, ic)
  def num_mix_stmts([SExpr(e) | rest], env, ic) := num_mix(e, env, ic) or num_mix_stmts(rest, env, ic)

  def num_mix_arms(Vec(Arm), Dict(String, String), Dict(Symbol, Dict(String, String))) Bool
  def num_mix_arms([], _, _) := false
  def num_mix_arms([CArm(_, body) | rest], env, ic) := num_mix(body, env, ic) or num_mix_arms(rest, env, ic)

  def num_mix_tail(Tail, Dict(String, String), Dict(Symbol, Dict(String, String))) Bool
  def num_mix_tail(TClose, _, _) := false
  def num_mix_tail(TCons(e), env, ic) := num_mix(e, env, ic)

  # ── error set #2: return-type mismatch (ADR-0064/0034) — the canonical type error ──
  # Rian.Check.check_return: a clause body whose inferred type contradicts the declared
  # return is REJECTED. `ret_bad` returns true iff the body is a PROVABLE mismatch, in the
  # same three-way order as the reference: a GENERIC return (mentions a `forall` tvar) is
  # skipped; a constant-of-literals body that ADOPTS the declared width must FIT its range
  # (out-of-range is bad); otherwise the inferred body type must be ASSIGNABLE (directional
  # widening) to the return. CONSERVATIVE: an `unknown` body is assignable to anything (so
  # it never rejects), and an `Fn(...)` return is skipped (this `unify` has no Fn-structural
  # rule — a documented tail rather than a false reject).
  pub def ret_bad(body Core, ret String, env Dict(String, String), ic Dict(Symbol, Dict(String, String))) Bool
  pub def ret_bad(body, ret, env, ic)
    if has_tvar(ret) do
      false
    else
      ret_bad_concrete(body, ret, env, ic)
    end
  end

  def ret_bad_concrete(body Core, ret String, env Dict(String, String), ic Dict(Symbol, Dict(String, String))) Bool
  def ret_bad_concrete(body, ret, env, ic)
    if lit_adopts(body, ret) do
      lit_range_bad(body, ret)
    else
      assignable(infer_ic(body, env, ic), ret) == false
    end
  end

  # ── error set #3: typed-bind mismatch (Rian.Check.check_binds, ADR-0034/0064) ──
  # A clause's `name Ann := value` whose value provably contradicts `Ann`. Walks the
  # CBlock statements threading the growing env (a bind enters scope for the ones that
  # follow). With an empty `ic` (no `range` table) the oracle's `range` case never fires
  # — the conservative slice this port and its fixpoint cover. Reuses lit_adopts /
  # lit_range_bad / int_lit_expr / float_type / assignable from error set #2.
  pub def binds_bad(Vec(Stmt), Dict(String, String), Dict(Symbol, Dict(String, String))) Bool
  pub def binds_bad([], _, _) := false
  pub def binds_bad([STypedBind(n, ann, e) | rest], env, ic) :=
    if bind_bad(ann, e, env, ic) do true else binds_bad(rest, Prim.map_put(env, n, ann), ic) end
  pub def binds_bad([SBind(n, e) | rest], env, ic) :=
    binds_bad(rest, Prim.map_put(env, n, infer_ic(e, env, ic)), ic)
  pub def binds_bad([SExpr(_) | rest], env, ic) := binds_bad(rest, env, ic)

  # one typed bind's verdict (Rian.Check.bind_mismatch, empty-ic slice): a constant-of-
  # literals value must FIT the declared width (lit_range_bad); an integer literal never
  # adopts a float annotation; otherwise the inferred value type must be ASSIGNABLE to it.
  def bind_bad(ann String, e Core, env Dict(String, String), ic Dict(Symbol, Dict(String, String))) Bool
  def bind_bad(ann, e, env, ic)
    if lit_adopts(e, ann) do
      lit_range_bad(e, ann)
    else
      if int_lit_expr(e) and float_type(ann) do
        true
      else
        assignable(infer_ic(e, env, ic), ann) == false
      end
    end
  end

  # ── error set #4: protocol-bound violation (Rian.Check.check_bounds, ADR-0042 §2) ──
  # at each call to a bounded generic (`def g(x T) … forall T: P`), instantiate the
  # callee's tvars from the argument types (`bind_all`, reused from generic-return
  # inference) and check each bound `T: P`: a tvar pinned to a CONCRETE type with no
  # `impl P for that-type` is a proven violation. `fbounds` maps a bounded function to
  # its (tvars, param types, bounds); `impls` maps a protocol to its implementing types.
  # CONSERVATIVE: an `unknown`/still-generic instantiation never rejects. `bounds_bad`
  # walks one clause body for such a call, mirroring `num_mix`'s shape.
  pub def bounds_bad(Core, Dict(String, String), Dict(Symbol, Dict(String, String)), Dict(String, FBnd), Dict(String, Vec(String))) Bool
  pub def bounds_bad(CNum(_), _, _, _, _) := false
  pub def bounds_bad(CStr(_), _, _, _, _) := false
  pub def bounds_bad(CChar(_), _, _, _, _) := false
  pub def bounds_bad(CId(_), _, _, _, _) := false
  pub def bounds_bad(CUnary(_, a), env, ic, fb, im) := bounds_bad(a, env, ic, fb, im)
  pub def bounds_bad(CBin(_, l, r), env, ic, fb, im) := bounds_bad(l, env, ic, fb, im) or bounds_bad(r, env, ic, fb, im)
  pub def bounds_bad(CCall(g, args), env, ic, fb, im) := call_bound_bad(g, args, env, ic, fb, im) or bounds_any(args, env, ic, fb, im)
  pub def bounds_bad(CIf(c, t, e), env, ic, fb, im) := bounds_bad(c, env, ic, fb, im) or bounds_bad(t, env, ic, fb, im) or bounds_bad(e, env, ic, fb, im)
  pub def bounds_bad(CBlock(stmts), env, ic, fb, im) := bounds_stmts(stmts, env, ic, fb, im)
  pub def bounds_bad(CCase(s, arms), env, ic, fb, im) := bounds_bad(s, env, ic, fb, im) or bounds_arms(arms, env, ic, fb, im)
  pub def bounds_bad(CList(es, tail), env, ic, fb, im) := bounds_any(es, env, ic, fb, im) or bounds_tail(tail, env, ic, fb, im)
  pub def bounds_bad(CLambda(_, body), env, ic, fb, im) := bounds_bad(body, env, ic, fb, im)
  pub def bounds_bad(_, _, _, _, _) := false

  def bounds_any(Vec(Core), Dict(String, String), Dict(Symbol, Dict(String, String)), Dict(String, FBnd), Dict(String, Vec(String))) Bool
  def bounds_any([], _, _, _, _) := false
  def bounds_any([c | rest], env, ic, fb, im) := bounds_bad(c, env, ic, fb, im) or bounds_any(rest, env, ic, fb, im)

  def bounds_stmts(Vec(Stmt), Dict(String, String), Dict(Symbol, Dict(String, String)), Dict(String, FBnd), Dict(String, Vec(String))) Bool
  def bounds_stmts([], _, _, _, _) := false
  def bounds_stmts([SBind(_, e) | rest], env, ic, fb, im) := bounds_bad(e, env, ic, fb, im) or bounds_stmts(rest, env, ic, fb, im)
  def bounds_stmts([STypedBind(_, _, e) | rest], env, ic, fb, im) := bounds_bad(e, env, ic, fb, im) or bounds_stmts(rest, env, ic, fb, im)
  def bounds_stmts([SExpr(e) | rest], env, ic, fb, im) := bounds_bad(e, env, ic, fb, im) or bounds_stmts(rest, env, ic, fb, im)

  def bounds_arms(Vec(Arm), Dict(String, String), Dict(Symbol, Dict(String, String)), Dict(String, FBnd), Dict(String, Vec(String))) Bool
  def bounds_arms([], _, _, _, _) := false
  def bounds_arms([CArm(_, body) | rest], env, ic, fb, im) := bounds_bad(body, env, ic, fb, im) or bounds_arms(rest, env, ic, fb, im)

  def bounds_tail(Tail, Dict(String, String), Dict(Symbol, Dict(String, String)), Dict(String, FBnd), Dict(String, Vec(String))) Bool
  def bounds_tail(TClose, _, _, _, _) := false
  def bounds_tail(TCons(e), env, ic, fb, im) := bounds_bad(e, env, ic, fb, im)

  # check one call against the callee's bounds, if it targets a bounded generic.
  def call_bound_bad(g String, args Vec(Core), env Dict(String, String), ic Dict(Symbol, Dict(String, String)), fb Dict(String, FBnd), im Dict(String, Vec(String))) Bool
  def call_bound_bad(g, args, env, ic, fb, im)
    if Prim.map_has(fb, g) do
      fbound_violated(Prim.map_get(fb, g), infer_args(args, env, ic), im)
    else
      false
    end
  end

  def fbound_violated(FBnd, Vec(String), Dict(String, Vec(String))) Bool
  def fbound_violated(FB(tvars, params, bounds), arg_types, im) := violated(bounds, bind_all(params, arg_types, tvars, []), im)

  def infer_args(Vec(Core), Dict(String, String), Dict(Symbol, Dict(String, String))) Vec(String)
  def infer_args([], _, _) := []
  def infer_args([a | rest], env, ic) := [infer_ic(a, env, ic) | infer_args(rest, env, ic)]

  # each bound `tvar: P + Q`: if the tvar is pinned to a concrete type, every protocol
  # must have an impl for it; a missing one is a violation.
  def violated(Vec(ProtoBound), Vec(Bind), Dict(String, Vec(String))) Bool
  def violated([], _, _) := false
  def violated([PBound(tvar, protos) | rest], binds, im) := pbound_violated(tvar, protos, binds, im) or violated(rest, binds, im)

  def pbound_violated(tvar String, protos Vec(String), binds Vec(Bind), im Dict(String, Vec(String))) Bool
  def pbound_violated(tvar, protos, binds, im)
    case bind_lookup(binds, tvar) do
      TyHit(ty) -> if concrete_ty(ty) do missing_impl(protos, ty, im) else false end
      TyMiss -> false
    end
  end

  def concrete_ty(ty String) Bool := if ty == "unknown" do false else not has_tvar(ty) end

  def missing_impl(Vec(String), String, Dict(String, Vec(String))) Bool
  def missing_impl([], _, _) := false
  def missing_impl([p | rest], ty, im) := not impl_has(im, p, ty) or missing_impl(rest, ty, im)

  def impl_has(im Dict(String, Vec(String)), proto String, ty String) Bool
  def impl_has(im, proto, ty) := if Prim.map_has(im, proto) do member_str(ty, Prim.map_get(im, proto)) else false end

  def bind_lookup(Vec(Bind), String) TyLk
  def bind_lookup([], _) := TyMiss
  def bind_lookup([Bnd(tv, ty) | rest], x) := if tv == x do TyHit(ty) else bind_lookup(rest, x) end

  # ── error set #5: `Result(T, E)` error-set check (Rian.Check.check_error_set, ADR-0040 §4) ──
  # a function declared `Result(T, E)` must not RETURN an `{:error, Tag}` whose `Tag` (a PascalCase
  # constructor) is not in `E`'s set. `tsets` maps a named error type `E` to its variant
  # tags (a bare `E` -> `[E]`). CONSERVATIVE Phase-1 slice: only the tags DIRECTLY built in
  # the body are checked — callee-propagated error sets (`with`-without-`else`, the whole-
  # program call-graph fixpoint) are the tail; the corpus avoids propagation.
  pub def error_set_bad(body Core, ret String, tsets Dict(String, Vec(String))) Bool
  pub def error_set_bad(body, ret, tsets)
    case declared_set(ret, tsets) do
      EsNone -> false
      EsSome(declared) -> any_extra_tag(direct_tags(body), declared)
    end
  end

  # `Result(T, E)` -> the declared error-tag set (`tsets[E]`, else `[E]`); else `EsNone`
  # (the `Result(T, E)` return sugar was removed — ADR-0083). `parse_parametric` splits
  # `Result(ok, err)` on its top-level comma; a non-`Result` / wrong-arity return is `EsNone`.
  def declared_set(ret String, tsets Dict(String, Vec(String))) EsOpt
  def declared_set(ret, tsets) := decl_from_pp(parse_parametric(ret), tsets)

  def decl_from_pp(PpRes, Dict(String, Vec(String))) EsOpt
  def decl_from_pp(Pp(name, args), tsets) := decl_args(name, args, tsets)
  def decl_from_pp(_, _) := EsNone

  def decl_args(String, Vec(String), Dict(String, Vec(String))) EsOpt
  def decl_args("Result", [ok_str, err_str], tsets) := decl_when(first_tok(ok_str), first_tok(err_str), tsets)
  def decl_args(_, _, _) := EsNone

  def decl_when(String, String, Dict(String, Vec(String))) EsOpt
  def decl_when("", _, _) := EsNone
  def decl_when(_, "", _) := EsNone
  def decl_when(_, err, tsets) := EsSome(tags_of(err, tsets))

  def tags_of(err String, tsets Dict(String, Vec(String))) Vec(String) := if Prim.map_has(tsets, err) do Prim.map_get(tsets, err) else [err] end

  # the type string with surrounding spaces stripped (mirrors the reference's `String.trim`
  # of each `|`-split part) — `" DivErr"` -> `"DivErr"`, a leading `| E`'s ok part -> `""`.
  def first_tok(s String) String := Prim.str_from_chars(trim_sp(Prim.str_chars(s)))
  def trim_sp(cs Vec(Int53)) Vec(Int53) := rev_i(strip_sp(rev_i(strip_sp(cs), [])), [])
  def strip_sp(Vec(Int53)) Vec(Int53)
  def strip_sp([32 | rest]) := strip_sp(rest)
  def strip_sp(cs) := cs

  # every PascalCase tag DIRECTLY built as `{:error, Tag}` anywhere in the body (mirrors
  # Rian.Check.error_tags): a lowercase id in error position is a bound var re-propagating
  # an existing error (`{:error, e} -> {:error, e}`), NOT a newly-built tag, so it is skipped.
  def direct_tags(Core) Vec(String)
  def direct_tags(CTuple([CAtom("error"), tag])) := es_cat(tag_name(tag), direct_tags(tag))
  def direct_tags(CTuple(es)) := dt_any(es)
  def direct_tags(CUnary(_, a)) := direct_tags(a)
  def direct_tags(CBin(_, l, r)) := es_cat(direct_tags(l), direct_tags(r))
  def direct_tags(CCall(_, args)) := dt_any(args)
  def direct_tags(CIf(c, t, e)) := es_cat(direct_tags(c), es_cat(direct_tags(t), direct_tags(e)))
  def direct_tags(CBlock(stmts)) := dt_stmts(stmts)
  def direct_tags(CCase(s, arms)) := es_cat(direct_tags(s), dt_arms(arms))
  def direct_tags(CList(es, tail)) := es_cat(dt_any(es), dt_tail(tail))
  def direct_tags(CLambda(_, body)) := direct_tags(body)
  def direct_tags(_) := []

  def dt_any(Vec(Core)) Vec(String)
  def dt_any([]) := []
  def dt_any([c | rest]) := es_cat(direct_tags(c), dt_any(rest))

  def dt_stmts(Vec(Stmt)) Vec(String)
  def dt_stmts([]) := []
  def dt_stmts([SBind(_, e) | rest]) := es_cat(direct_tags(e), dt_stmts(rest))
  def dt_stmts([STypedBind(_, _, e) | rest]) := es_cat(direct_tags(e), dt_stmts(rest))
  def dt_stmts([SExpr(e) | rest]) := es_cat(direct_tags(e), dt_stmts(rest))

  def dt_arms(Vec(Arm)) Vec(String)
  def dt_arms([]) := []
  def dt_arms([CArm(_, body) | rest]) := es_cat(direct_tags(body), dt_arms(rest))

  def dt_tail(Tail) Vec(String)
  def dt_tail(TClose) := []
  def dt_tail(TCons(e)) := direct_tags(e)

  # a PascalCase constructor in error position is a tag; a lowercase bound var is not.
  def tag_name(Core) Vec(String)
  def tag_name(CId(n)) := if pascal_name(n) do [n] else [] end
  def tag_name(CCall(n, _)) := if pascal_name(n) do [n] else [] end
  def tag_name(_) := []

  def pascal_name(n String) Bool := pascal_first(Prim.str_chars(n))
  def pascal_first(Vec(Int53)) Bool
  def pascal_first([c | _]) := c >= 65 and c <= 90
  def pascal_first([]) := false

  def es_cat(Vec(String), Vec(String)) Vec(String)
  def es_cat([], b) := b
  def es_cat([x | xs], b) := [x | es_cat(xs, b)]

  # true iff some produced tag is NOT in the declared set (over-declaration is allowed).
  def any_extra_tag(Vec(String), Vec(String)) Bool
  def any_extra_tag([], _) := false
  def any_extra_tag([t | rest], declared) := if member_str(t, declared) do any_extra_tag(rest, declared) else true end

  # `from` is assignable to `to` (Rian.Check.assignable?): identical, either unknown, or an
  # `Fn(...)` on either side (skipped, see above); else for two numerics a lossless WIDENING;
  # else exact unification must not mismatch.
  def assignable(from String, to String) Bool
  def assignable(from, to)
    if from == to or from == "unknown" or to == "unknown" or is_fn(from) or is_fn(to) do
      true
    else
      assignable_num(num_kind(from), num_kind(to), from, to)
    end
  end

  def assignable_num(NumKind, NumKind, String, String) Bool
  def assignable_num(Nk(fk, fw), Nk(tk, tw), _, _) := num_widens(Nk(fk, fw), Nk(tk, tw))
  def assignable_num(_, _, from, to) := unify(from, to) != "mismatch"

  # the lossless numeric widening lattice (Rian.Check.num_widens?): `from ⊑ to`. Same-kind
  # int/uint/float widen to an equal-or-wider width; `uint ⊑ int` needs a strictly wider
  # signed width; `int/uint ⊑ float` only when exactly representable in the mantissa.
  def num_widens(NumKind, NumKind) Bool
  def num_widens(Nk(fk, fa), Nk(tk, tb)) := widen(fk, fa, tk, tb)
  def num_widens(_, _) := false

  def widen(String, Int53, String, Int53) Bool
  def widen("int", a, "int", b) := a <= b
  def widen("uint", a, "uint", b) := a <= b
  def widen("uint", a, "int", b) := a < b
  def widen("int", a, "float", b) := a - 1 <= mantissa(b)
  def widen("uint", a, "float", b) := a <= mantissa(b)
  def widen("float", a, "float", b) := a <= b
  def widen(_, _, _, _) := false

  def mantissa(Int53) Int53
  def mantissa(64) := 53
  def mantissa(32) := 24
  def mantissa(_) := 0

  # Rian.Check.body_literal_adopts?: a constant-of-literals body adopts the declared width
  # — an INTEGER literal adopts any `Int*`/`UInt*`, a FLOAT literal any `Float*` (cross-kind
  # does NOT adopt). Recurses through arithmetic, `if`/`case` branches, single-expr blocks,
  # and a closed list literal into `Vec(ElemT)`.
  def lit_adopts(Core, String) Bool
  def lit_adopts(CNum(t), ret) := lit_scalar_adopts(t, ret)
  def lit_adopts(CUnary("-", a), ret) := lit_adopts(a, ret)
  def lit_adopts(CBin(op, l, r), ret) := arith_op(op) and lit_adopts(l, ret) and lit_adopts(r, ret)
  def lit_adopts(CIf(_, t, e), ret) := lit_adopts(t, ret) and lit_adopts(e, ret)
  def lit_adopts(CCase(_, arms), ret) := arms_adopt(arms, ret)
  def lit_adopts(CBlock([SExpr(e)]), ret) := lit_adopts(e, ret)
  def lit_adopts(CList(elems, TClose), ret) := list_adopts(elems, ret)
  def lit_adopts(_, _) := false

  def lit_scalar_adopts(t String, ret String) Bool := if int_literal(t) do int_type(ret) else float_type(ret) end

  def arms_adopt(Vec(Arm), String) Bool
  def arms_adopt([], _) := false
  def arms_adopt([CArm(_, b) | rest], ret) := lit_adopts(b, ret) and rest_arms_adopt(rest, ret)

  def rest_arms_adopt(Vec(Arm), String) Bool
  def rest_arms_adopt([], _) := true
  def rest_arms_adopt([CArm(_, b) | rest], ret) := lit_adopts(b, ret) and rest_arms_adopt(rest, ret)

  def list_adopts(elems Vec(Core), ret String) Bool := list_adopts_v(elems, vec_elem_opt(ret))

  def list_adopts_v(Vec(Core), VecOpt) Bool
  def list_adopts_v(_, VNone) := false
  def list_adopts_v([], VSome(_)) := true
  def list_adopts_v([e | rest], VSome(et)) := lit_adopts(e, et) and list_adopts_v(rest, VSome(et))

  def float_type(t String) Bool := float_word(Prim.str_chars(t))

  def float_word(Vec(Int53)) Bool
  def float_word(['F', 'l', 'o', 'a', 't' | rest]) := all_digits(rest)
  def float_word(_) := false

  # Rian.Check.lit_range_error/oor_scan: a constant integer in the (literal) body that falls
  # outside the declared fixed-width range is bad. A `Vec(ElemT)` checks each element vs
  # `ElemT`; the `>Int53` widths (Int64/Int128/UInt64/UInt128) have no port range check yet
  # (`BNone`, a documented tail — their bounds would be bignums).
  def lit_range_bad(body Core, ret String) Bool
  def lit_range_bad(body, ret)
    case vec_elem_opt(ret) do
      VSome(et) -> lrb_list(list_elems(body), et)
      VNone -> lrb_scalar(body, ret)
    end
  end

  def lrb_list(Vec(Core), String) Bool
  def lrb_list([], _) := false
  def lrb_list([e | rest], et) := lit_range_bad(e, et) or lrb_list(rest, et)

  def lrb_scalar(body Core, ret String) Bool := lrb_bounds(body, width_bounds(ret))

  def lrb_bounds(Core, BoundOpt) Bool
  def lrb_bounds(_, BNone) := false
  def lrb_bounds(body, B(lo, hi)) := oor_scan(body, lo, hi)

  def oor_scan(Core, Int53, Int53) Bool
  def oor_scan(CIf(_, t, e), lo, hi) := oor_scan(t, lo, hi) or oor_scan(e, lo, hi)
  def oor_scan(CCase(_, arms), lo, hi) := oor_arms(arms, lo, hi)
  def oor_scan(CBlock([SExpr(e)]), lo, hi) := oor_scan(e, lo, hi)
  def oor_scan(e, lo, hi) := oor_leaf(const_int_opt(e), lo, hi)

  def oor_arms(Vec(Arm), Int53, Int53) Bool
  def oor_arms([], _, _) := false
  def oor_arms([CArm(_, b) | rest], lo, hi) := oor_scan(b, lo, hi) or oor_arms(rest, lo, hi)

  def oor_leaf(IntOpt, Int53, Int53) Bool
  def oor_leaf(ISome(v), lo, hi) := v < lo or v > hi
  def oor_leaf(INone, _, _) := false

  def const_int_opt(Core) IntOpt
  def const_int_opt(CNum(t)) := if int_literal(t) do ISome(int_value(t)) else INone end
  def const_int_opt(CUnary("-", a)) := neg_int(const_int_opt(a))
  def const_int_opt(_) := INone

  def neg_int(IntOpt) IntOpt
  def neg_int(ISome(v)) := ISome(0 - v)
  def neg_int(INone) := INone

  def int_value(t String) Int53 := parse_digits(only_digits(Prim.str_chars(t)), 0)

  def only_digits(Vec(Int53)) Vec(Int53)
  def only_digits([]) := []
  def only_digits([c | rest]) := if c >= 48 and c <= 57 do [c | only_digits(rest)] else only_digits(rest) end

  def list_elems(Core) Vec(Core)
  def list_elems(CList(elems, _)) := elems
  def list_elems(CBlock([SExpr(e)])) := list_elems(e)
  def list_elems(_) := []

  def vec_elem_opt(ret String) VecOpt := vopt(parse_parametric(ret))

  def vopt(PpRes) VecOpt
  def vopt(Pp(name, args)) := if name == "Vec" do vfirst(args) else VNone end
  def vopt(PpNone) := VNone

  def vfirst(Vec(String)) VecOpt
  def vfirst([]) := VNone
  def vfirst([x | _]) := VSome(x)

  def width_bounds(String) BoundOpt
  def width_bounds("Int8") := B(0 - 128, 127)
  def width_bounds("Int16") := B(0 - 32768, 32767)
  def width_bounds("Int32") := B(0 - 2147483648, 2147483647)
  def width_bounds("Int53") := B(0 - 9007199254740991, 9007199254740991)
  def width_bounds("UInt8") := B(0, 255)
  def width_bounds("UInt16") := B(0, 65535)
  def width_bounds("UInt32") := B(0, 4294967295)
  def width_bounds(_) := BNone
end
