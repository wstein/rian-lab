# ===========================================================================
# SELF-HOSTING SPIKE — the real type checker (inference), written in Rian
# ===========================================================================
# Goal (ADR-0063 §2, the type-checker stage): infer the type of an expression —
# a slice of the REAL `Rian.Check.infer/3` (not the toy-language `selfhost_check`
# checker). Fixpoint-locked against `Rian.Check.infer` in
# `test/rian/checker_infer_fixpoint_test.exs`.
#
# Inference rules (ADR-0064): a numeric literal is `Int53`, or `Float64` if it
# carries a `.`/`e`/`E`; a string is `String`, a char `Char`, `true`/`false` `Bool`;
# unary `-` passes the operand type through and `not` is `Bool`; a binary op's result
# is determined by the op — comparisons/`and`/`or` are `Bool`, `<>` is `String`, `/`
# is `Float64`, and `+ - * div rem` over integers are `Int53`. The determinate
# primitive intrinsics infer their result type (`__prim_char_code` → `Int53`,
# `__prim_int_to_float` → `Float64`, `__prim_str_to_atom` → `Symbol`,
# `__prim_char_to_string`/`__prim_str_concat_all` → `String`). An unbound identifier
# or a general (non-prim) call is `unknown` — the checker is deliberately
# conservative and does NOT guess.
#
# A typing ENVIRONMENT (name -> type) is threaded through inference: a bound
# variable resolves to its declared type (`infer_env/2`; `infer/1` is the empty-env
# convenience). Covered Core nodes (7): CNum/CStr/CChar/CId/CUnary/CBin/CCall. The
# `:partial` tail — user-function/ctor return types in the env, operand-directed
# arithmetic widths (Rian.Check's `arith_type`: `x + 1.0`, char ordinals), lambdas,
# `if`/`case` LUB-join, and lists — see ADR-0063 / docs/self-host-status.md.
# ---------------------------------------------------------------------------

mod SelfhostChecker do
  type Core := CNum(String)
             | CStr(String)
             | CChar(Int53)
             | CId(String)
             | CUnary(String, Core)
             | CBin(String, Core, Core)
             | CCall(String, Vec(Core))

  # A binary op's result type, keyed by the operator (the integer slice):
  # comparisons/`and`/`or`/`in` -> Bool, `<>` -> String, `/` -> Float64, the
  # arithmetic ops over integers -> Int53.
  def bin_ty(String) String
  def bin_ty("==") := "Bool"
  def bin_ty("!=") := "Bool"
  def bin_ty("<") := "Bool"
  def bin_ty("<=") := "Bool"
  def bin_ty(">") := "Bool"
  def bin_ty(">=") := "Bool"
  def bin_ty("and") := "Bool"
  def bin_ty("or") := "Bool"
  def bin_ty("in") := "Bool"
  def bin_ty("<>") := "String"
  def bin_ty("/") := "Float64"
  def bin_ty("+") := "Int53"
  def bin_ty("-") := "Int53"
  def bin_ty("*") := "Int53"
  def bin_ty("div") := "Int53"
  def bin_ty("rem") := "Int53"

  # A numeric literal: `Float64` if it carries a decimal point or an exponent marker
  # (`.`/`e`/`E`), else the portable `Int53` (ADR-0064 — mirrors Rian.Check's ENum).
  def num_ty(t String) String
  def num_ty(t)
    if float_mark(Prim.str_chars(t)) do
      "Float64"
    else
      "Int53"
    end
  end

  def float_mark(Vec(Int53)) Bool
  def float_mark([]) := false
  def float_mark([c | rest])
    if c == 46 or c == 101 or c == 69 do
      true
    else
      float_mark(rest)
    end
  end

  # Infer the type of a Core node in the empty env (closed expression).
  pub def infer(Core) String
  pub def infer(c) := infer_env(c, Prim.map_new())

  # Infer under a typing env (name -> type), threading it through sub-expressions —
  # a bound identifier resolves to its env type (ADR-0042; mirrors Rian.Check's
  # `Map.get(env, x)`), else `true`/`false` are `Bool`, else `unknown`.
  pub def infer_env(Core, Dict(String, String)) String
  pub def infer_env(CNum(t), _) := num_ty(t)
  pub def infer_env(CStr(_), _) := "String"
  pub def infer_env(CChar(_), _) := "Char"
  pub def infer_env(CId("true"), _) := "Bool"
  pub def infer_env(CId("false"), _) := "Bool"
  pub def infer_env(CId(x), env) := lookup(env, x)
  pub def infer_env(CUnary("not", _), _) := "Bool"
  pub def infer_env(CUnary("-", x), env) := infer_env(x, env)
  pub def infer_env(CBin(op, _, _), _) := bin_ty(op)
  # primitive intrinsics with a determinate result type (ADR-0036/0047/0069 — mirrors
  # Rian.Check's `__prim_*` clauses). A general call has no determinate type without
  # function/ctor return types in the env, so it is conservatively `unknown`.
  pub def infer_env(CCall("__prim_char_code", [_]), _) := "Int53"
  pub def infer_env(CCall("__prim_int_to_float", [_]), _) := "Float64"
  pub def infer_env(CCall("__prim_str_to_atom", [_]), _) := "Symbol"
  pub def infer_env(CCall("__prim_char_to_string", [_]), _) := "String"
  pub def infer_env(CCall("__prim_str_concat_all", _), _) := "String"
  pub def infer_env(CCall(_, _), _) := "unknown"

  # a bound name's type from the env, else `unknown` (the checker does not guess).
  def lookup(env Dict(String, String), x String) String
    if Prim.map_has(env, x) do
      Prim.map_get(env, x)
    else
      "unknown"
    end
  end
end
