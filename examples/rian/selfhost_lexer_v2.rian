# ===========================================================================
# SELF-HOSTING — porting the REAL Rian lexer to Rian (slices 1-5)
# ===========================================================================
# Grows the Rian-written lexer toward the *real* `Rian.Lexer`, one slice at a
# time, checked for agreement against the reference by `Rian.Fixpoint`.
#
#   Slice 1  identifiers + keywords (Char ordinals, digit runs)
#   Slice 2  comparison + word operators (`< > <= >= == !=`, and/or/not/in/rem/div)
#   Slice 3  string (`"…"`) and char (`'X'`) literals
#   Slice 4  number lexemes — `_` separators, decimals, exponents (`norm_num`)
#   Slice 5  **`tokenize/1` parity** — the full declaration stream `Rian.Decl`
#            consumes (not just the expression stream): **significant newlines**
#            (`{:nl}`, runs collapsed, leading/trailing dropped), `;` `,`,
#            **`@annot`**, brackets `[] {} %{`, line comments `# …`, and the full
#            operator set (`-> .. := |> <> <~ <- . | : &`, plus those above) —
#            every operator now a single `TOp(String)`, mirroring the reference's
#            `@multi`/`@single` longest-match.
#
# Still out of slice: heredocs (`"""`), escapes inside string bodies, and the
# `\u{…}` char escape. Char-class tests are inlined in `when` guards (BEAM guards
# cannot call a user function); names/numbers are accumulated as `Vec(Char)` and
# `Prim.str_from_chars`-ed (ADR-0047 portable prelude).
# ---------------------------------------------------------------------------

mod SelfhostLexerV2 do
  # The lexer's own token sum — projected onto `Rian.Lexer.tokenize/1` by the
  # fixpoint harness. Operators (single/multi/word) are all `TOp`; structural
  # punctuation and the significant newline get their own nullary variants.
  type Tok :=
      TNum(String) | TId(String) | TKw(String) | TOp(String) | TStr(String)
    | TChar(Int53) | TAnnot(String)
    | TLP | TRP | TLBracket | TRBracket | TLBrace | TRBrace | TMapOpen
    | TComma | TSemi | TNL

  # Full token stream with significant newlines collapsed — matches `tokenize/1`.
  pub def tokenize(src String) Vec(Tok) := collapse(lex(Prim.str_chars(src)))

  def lex(cs Vec(Char)) Vec(Tok)
  def lex([]) := []
  # whitespace (space, tab, carriage-return) — skipped
  def lex([c | rest]) when c == ' ' or c == '\t' or c == '\r' := lex(rest)
  # significant newline (collapsed later)
  def lex(['\n' | rest]) := [TNL | lex(rest)]
  # line comment to end-of-line (the newline survives, lexed next as TNL)
  def lex(['#' | rest]) := lex(skip_comment(rest))
  # map-open `%{` (the only use of `%`)
  def lex(['%', '{' | rest]) := [TMapOpen | lex(rest)]
  # string / char literals
  def lex(['"' | rest]) := scan_str(rest, [])
  def lex(['\'' | rest]) := scan_char(rest)
  # `@name` annotation
  def lex(['@' | rest]) := scan_annot(rest, [])
  # brackets & punctuation
  def lex(['(' | rest]) := [TLP | lex(rest)]
  def lex([')' | rest]) := [TRP | lex(rest)]
  def lex(['[' | rest]) := [TLBracket | lex(rest)]
  def lex([']' | rest]) := [TRBracket | lex(rest)]
  def lex(['{' | rest]) := [TLBrace | lex(rest)]
  def lex(['}' | rest]) := [TRBrace | lex(rest)]
  def lex([',' | rest]) := [TComma | lex(rest)]
  def lex([';' | rest]) := [TSemi | lex(rest)]
  # multi-char operators (longest match first)
  def lex(['-', '>' | rest]) := [TOp("->") | lex(rest)]
  def lex(['.', '.' | rest]) := [TOp("..") | lex(rest)]
  def lex([':', '=' | rest]) := [TOp(":=") | lex(rest)]
  def lex(['|', '>' | rest]) := [TOp("|>") | lex(rest)]
  def lex(['<', '>' | rest]) := [TOp("<>") | lex(rest)]
  def lex(['<', '~' | rest]) := [TOp("<~") | lex(rest)]
  def lex(['<', '-' | rest]) := [TOp("<-") | lex(rest)]
  def lex(['<', '=' | rest]) := [TOp("<=") | lex(rest)]
  def lex(['>', '=' | rest]) := [TOp(">=") | lex(rest)]
  def lex(['=', '=' | rest]) := [TOp("==") | lex(rest)]
  def lex(['!', '=' | rest]) := [TOp("!=") | lex(rest)]
  # single-char operators
  def lex(['+' | rest]) := [TOp("+") | lex(rest)]
  def lex(['-' | rest]) := [TOp("-") | lex(rest)]
  def lex(['*' | rest]) := [TOp("*") | lex(rest)]
  def lex(['/' | rest]) := [TOp("/") | lex(rest)]
  def lex(['<' | rest]) := [TOp("<") | lex(rest)]
  def lex(['>' | rest]) := [TOp(">") | lex(rest)]
  def lex(['.' | rest]) := [TOp(".") | lex(rest)]
  def lex(['|' | rest]) := [TOp("|") | lex(rest)]
  def lex([':' | rest]) := [TOp(":") | lex(rest)]
  def lex(['&' | rest]) := [TOp("&") | lex(rest)]
  # numbers (slice 4): accumulate the source lexeme
  def lex([c | rest]) when c >= '0' and c <= '9' := lex_int(rest, [c])
  # identifiers / keywords / word-operators (slices 1-2)
  def lex([c | rest]) when (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or c == '_' := lex_id([c | rest], [])
  # anything else: skip (the reference raises; the corpus avoids unknown bytes)
  def lex([_ | rest]) := lex(rest)

  # ── significant-newline collapse (matches Rian.Lexer.collapse_nl) ─────────
  # collapse runs to one TNL, then drop a leading and a trailing TNL.
  def collapse(toks Vec(Tok)) Vec(Tok) := drop_trailing_nl(drop_leading_nl(dedup_nl(toks)))

  def dedup_nl(toks Vec(Tok)) Vec(Tok)
  def dedup_nl([]) := []
  def dedup_nl([TNL, TNL | rest]) := dedup_nl([TNL | rest])
  def dedup_nl([t | rest]) := [t | dedup_nl(rest)]

  def drop_leading_nl(toks Vec(Tok)) Vec(Tok)
  def drop_leading_nl([TNL | rest]) := rest
  def drop_leading_nl(toks) := toks

  # at most one trailing TNL survives dedup; drop it via reverse / drop-lead / reverse
  def drop_trailing_nl(toks Vec(Tok)) Vec(Tok) := rev(drop_leading_nl(rev(toks, [])), [])

  # ── comment / annotation scanners ────────────────────────────────────────
  def skip_comment(cs Vec(Char)) Vec(Char)
  def skip_comment([]) := []
  def skip_comment(['\n' | rest]) := ['\n' | rest]
  def skip_comment([_ | rest]) := skip_comment(rest)

  def scan_annot(cs Vec(Char), chars Vec(Char)) Vec(Tok)
  def scan_annot([c | rest], chars) when (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_' := scan_annot(rest, [c | chars])
  def scan_annot(cs, chars) := [TAnnot(Prim.str_from_chars(rev(chars, []))) | lex(cs)]

  # ── numbers (slice 4): accumulate the lexeme (reversed), then str_from_chars ─
  def lex_int(cs Vec(Char), acc Vec(Char)) Vec(Tok)
  def lex_int([c | rest], acc) when (c >= '0' and c <= '9') or c == '_' := lex_int(rest, [c | acc])
  def lex_int(['.', d | rest], acc) when d >= '0' and d <= '9' := lex_frac(rest, [d, '.' | acc])
  def lex_int(['e', s, d | rest], acc) when (s == '+' or s == '-') and (d >= '0' and d <= '9') := lex_exp(rest, [d, s, 'e', '0', '.' | acc])
  def lex_int(['E', s, d | rest], acc) when (s == '+' or s == '-') and (d >= '0' and d <= '9') := lex_exp(rest, [d, s, 'e', '0', '.' | acc])
  def lex_int(['e', d | rest], acc) when d >= '0' and d <= '9' := lex_exp(rest, [d, 'e', '0', '.' | acc])
  def lex_int(['E', d | rest], acc) when d >= '0' and d <= '9' := lex_exp(rest, [d, 'e', '0', '.' | acc])
  def lex_int(cs, acc) := [TNum(Prim.str_from_chars(rev(acc, []))) | lex(cs)]

  def lex_frac(cs Vec(Char), acc Vec(Char)) Vec(Tok)
  def lex_frac([c | rest], acc) when (c >= '0' and c <= '9') or c == '_' := lex_frac(rest, [c | acc])
  def lex_frac([e, s, d | rest], acc) when (e == 'e' or e == 'E') and (s == '+' or s == '-') and (d >= '0' and d <= '9') := lex_exp(rest, [d, s, e | acc])
  def lex_frac([e, d | rest], acc) when (e == 'e' or e == 'E') and (d >= '0' and d <= '9') := lex_exp(rest, [d, e | acc])
  def lex_frac(cs, acc) := [TNum(Prim.str_from_chars(rev(acc, []))) | lex(cs)]

  def lex_exp(cs Vec(Char), acc Vec(Char)) Vec(Tok)
  def lex_exp([c | rest], acc) when c >= '0' and c <= '9' := lex_exp(rest, [c | acc])
  def lex_exp(cs, acc) := [TNum(Prim.str_from_chars(rev(acc, []))) | lex(cs)]

  # ── string / char literals (slice 3) ─────────────────────────────────────
  def scan_str(cs Vec(Char), acc Vec(Char)) Vec(Tok)
  def scan_str(['"' | rest], acc) := [TStr(Prim.str_from_chars(rev(acc, []))) | lex(rest)]
  def scan_str([c | rest], acc) := scan_str(rest, [c | acc])
  def scan_str([], acc) := [TStr(Prim.str_from_chars(rev(acc, [])))]

  # a char literal: `'a'` (one char + close quote) or `'\n'` (a backslash escape,
  # one char + close quote). The escape clause MUST precede the plain one.
  def scan_char(cs Vec(Char)) Vec(Tok)
  def scan_char(['\\', e, q | rest]) when q == '\'' := [TChar(char_esc(e)) | lex(rest)]
  def scan_char([c, q | rest]) when q == '\'' := [TChar(Prim.char_code(c)) | lex(rest)]

  # decode a single-character escape to its codepoint — the named set of
  # Rian.Lexer.char_escape (the `\xHH`/`\uHHHH` numeric escapes are out of slice).
  def char_esc(e Char) Int53
  def char_esc('a') := 7
  def char_esc('b') := 8
  def char_esc('d') := 127
  def char_esc('e') := 27
  def char_esc('f') := 12
  def char_esc('n') := 10
  def char_esc('r') := 13
  def char_esc('s') := 32
  def char_esc('t') := 9
  def char_esc('v') := 11
  def char_esc('0') := 0
  def char_esc('\\') := 92
  def char_esc('\'') := 39
  def char_esc('\"') := 34

  # ── identifiers / keyword classification (slices 1-2) ─────────────────────
  def lex_id(cs Vec(Char), chars Vec(Char)) Vec(Tok)
  def lex_id([c | rest], chars) when (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_' := lex_id(rest, [c | chars])
  def lex_id(cs, chars) := [classify(Prim.str_from_chars(rev(chars, []))) | lex(cs)]

  # word-operators are `{:op, w}` in the reference; the 16 keywords are `{:kw, w}`;
  # everything else is an identifier.
  def classify(name String) Tok
  def classify("and") := TOp("and")
  def classify("or") := TOp("or")
  def classify("not") := TOp("not")
  def classify("in") := TOp("in")
  def classify("rem") := TOp("rem")
  def classify("div") := TOp("div")
  def classify("if") := TKw("if")
  def classify("do") := TKw("do")
  def classify("else") := TKw("else")
  def classify("end") := TKw("end")
  def classify("def") := TKw("def")
  def classify("type") := TKw("type")
  def classify("range") := TKw("range")
  def classify("case") := TKw("case")
  def classify("when") := TKw("when")
  def classify("struct") := TKw("struct")
  def classify("alias") := TKw("alias")
  def classify("mod") := TKw("mod")
  def classify("pub") := TKw("pub")
  def classify("const") := TKw("const")
  def classify("macro") := TKw("macro")
  def classify("use") := TKw("use")
  def classify("with") := TKw("with")
  def classify(name) := TId(name)

  # reverse a Char list onto an accumulator (pure Rian, cons recursion)
  def rev(xs Vec(Char), acc Vec(Char)) Vec(Char)
  def rev([], acc) := acc
  def rev([x | xs], acc) := rev(xs, [x | acc])
end
