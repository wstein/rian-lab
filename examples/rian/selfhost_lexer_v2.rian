# ===========================================================================
# SELF-HOSTING — porting the REAL Rian lexer to Rian (slices 1-2)
# ===========================================================================
# The toy lexer (selfhost_lexer.rian) tokenized arithmetic only. This grows the
# Rian-written lexer toward the *real* `Rian.Lexer` token vocabulary, one slice
# at a time, checked for agreement against the reference by `Rian.Fixpoint`.
#
# Slice 1 added **identifiers and keywords** on top of numbers/operators/parens —
# writable because `Char` is a real ordinal type (ADR-0036): the scanner
# classifies bytes with `Char` comparisons (`c >= 'a' and c <= 'z'`) and folds
# digit runs with ordinal arithmetic (`acc * 10 + c - '0'`).
#
# Slice 2 adds **comparison operators** (`< > <= >= == !=`, with two-char
# longest-match via `[a, b | rest]` peeking), the **word-operators**
# (`and or not in rem div`, which the reference lexes as `{:op, w}` not keywords),
# and the **full 16-keyword set** of `Rian.Lexer.@keywords`.
#
# Slice 3 adds **string** (`"…"`) and **char** (`'X'`) literals — scanned
# char-by-char in Rian (`scan_str`/`scan_char`) over `Char` comparisons, with the
# string body rebuilt via `Prim.str_from_chars` and the char's codepoint via
# `Prim.char_code`.
#
# Slice 4 adds **number lexemes** — `_` separators, decimals, and exponents. The
# model changed: `TNum` now carries the source *lexeme* (a `String`), not a folded
# `Int64`, because the reference keeps the text (`1_000` stays `1_000`) and applies
# `norm_num` (a bare exponent gains `.0`: `1e9` -> `1.0e9`). The scanner
# accumulates the lexeme char-by-char (`lex_int`/`lex_frac`/`lex_exp`) mirroring
# `Rian.Lexer.@num_re`. Still out of slice: escapes inside literals, heredocs,
# `@annot`, brackets `[] {} %{`, the assignment/arrow operators, and significant
# newlines (the jump to the full `tokenize/1` stream `Rian.Decl` consumes).
#
# Char-class tests are *inlined* in `when` guards (BEAM guards cannot call a
# user function — this leaks the host's guard constraint into source and will
# be lifted once protocol-bounded predicates land per ADR-0042 part 2), and the
# name is built by accumulating `Char`s and `Prim.str_from_chars`-ing them
# (ADR-0047 §2 portable prelude; `Prim` is the target-internal namespace).
# ---------------------------------------------------------------------------

mod SelfhostLexerV2 do
  # The lexer's own token stream — projected onto `Rian.Lexer`'s tokens by the
  # fixpoint harness (TNum -> {:num}, TId -> {:id}, TKw -> {:kw}, TOp -> {:op}, …).
  type Tok := TNum(String) | TPlus | TMinus | TStar | TSlash | TLP | TRP | TId(String) | TKw(String) | TOp(String) | TStr(String) | TChar(Int64)

  pub def tokenize(src String) Vec(Tok) := lex(Prim.str_chars(src))

  def lex(cs Vec(Char)) Vec(Tok)
  def lex([]) := []
  def lex([c | rest]) when c == ' ' := lex(rest)
  # string literal: scan to the closing `"` (slice 3)
  def lex(['"' | rest]) := scan_str(rest, [])
  # char literal `'X'`: one codepoint between single quotes (slice 3, no escapes)
  def lex(['\'' | rest]) := scan_char(rest)
  # two-char comparison operators FIRST (longest match: `<=` before `<`)
  def lex(['<', '=' | rest]) := [TOp("<=") | lex(rest)]
  def lex(['>', '=' | rest]) := [TOp(">=") | lex(rest)]
  def lex(['=', '=' | rest]) := [TOp("==") | lex(rest)]
  def lex(['!', '=' | rest]) := [TOp("!=") | lex(rest)]
  def lex(['+' | rest]) := [TPlus | lex(rest)]
  def lex(['-' | rest]) := [TMinus | lex(rest)]
  def lex(['*' | rest]) := [TStar | lex(rest)]
  def lex(['/' | rest]) := [TSlash | lex(rest)]
  def lex(['<' | rest]) := [TOp("<") | lex(rest)]
  def lex(['>' | rest]) := [TOp(">") | lex(rest)]
  def lex(['(' | rest]) := [TLP | lex(rest)]
  def lex([')' | rest]) := [TRP | lex(rest)]
  def lex([c | rest]) when c >= '0' and c <= '9' := lex_int(rest, [c])
  def lex([c | rest]) when (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or c == '_' := lex_id([c | rest], [])
  def lex([_ | rest]) := lex(rest)

  # NUMBERS (slice 4) — accumulate the *lexeme* (reversed) rather than fold a
  # value, because the reference keeps the source text (underscores included).
  # The grammar mirrors `Rian.Lexer.@num_re`:
  #     \d[\d_]*  ( . \d[\d_]* )?  ( [eE][+-]? \d+ )?
  # and bakes in the `norm_num` rule: a BARE exponent (no decimal) gets `.0`
  # inserted and the marker lowercased (`1e9`/`1E9` -> `1.0e9`); a decimal keeps
  # its marker as written (`1.0E9` stays `1.0E9`). `acc` is the reversed lexeme;
  # `rev` + `Prim.str_from_chars` rebuild it in source order (portable, no FFI).

  # integer part (no decimal point seen yet)
  def lex_int(cs Vec(Char), acc Vec(Char)) Vec(Tok)
  def lex_int([c | rest], acc) when (c >= '0' and c <= '9') or c == '_' := lex_int(rest, [c | acc])
  def lex_int(['.', d | rest], acc) when d >= '0' and d <= '9' := lex_frac(rest, [d, '.' | acc])
  def lex_int(['e', s, d | rest], acc) when (s == '+' or s == '-') and (d >= '0' and d <= '9') := lex_exp(rest, [d, s, 'e', '0', '.' | acc])
  def lex_int(['E', s, d | rest], acc) when (s == '+' or s == '-') and (d >= '0' and d <= '9') := lex_exp(rest, [d, s, 'e', '0', '.' | acc])
  def lex_int(['e', d | rest], acc) when d >= '0' and d <= '9' := lex_exp(rest, [d, 'e', '0', '.' | acc])
  def lex_int(['E', d | rest], acc) when d >= '0' and d <= '9' := lex_exp(rest, [d, 'e', '0', '.' | acc])
  def lex_int(cs, acc) := [TNum(Prim.str_from_chars(rev(acc, []))) | lex(cs)]

  # fractional part (decimal point already consumed) — exponent marker case kept
  def lex_frac(cs Vec(Char), acc Vec(Char)) Vec(Tok)
  def lex_frac([c | rest], acc) when (c >= '0' and c <= '9') or c == '_' := lex_frac(rest, [c | acc])
  def lex_frac([e, s, d | rest], acc) when (e == 'e' or e == 'E') and (s == '+' or s == '-') and (d >= '0' and d <= '9') := lex_exp(rest, [d, s, e | acc])
  def lex_frac([e, d | rest], acc) when (e == 'e' or e == 'E') and (d >= '0' and d <= '9') := lex_exp(rest, [d, e | acc])
  def lex_frac(cs, acc) := [TNum(Prim.str_from_chars(rev(acc, []))) | lex(cs)]

  # exponent digits (\d+ only — no underscores, no decimal point)
  def lex_exp(cs Vec(Char), acc Vec(Char)) Vec(Tok)
  def lex_exp([c | rest], acc) when c >= '0' and c <= '9' := lex_exp(rest, [c | acc])
  def lex_exp(cs, acc) := [TNum(Prim.str_from_chars(rev(acc, []))) | lex(cs)]

  # a string literal: accumulate chars (reversed) until the closing `"`, then
  # rebuild in source order (portable, no host FFI). (Slice 3 — no escapes yet.)
  def scan_str(cs Vec(Char), acc Vec(Char)) Vec(Tok)
  def scan_str(['"' | rest], acc) := [TStr(Prim.str_from_chars(rev(acc, []))) | lex(rest)]
  def scan_str([c | rest], acc) := scan_str(rest, [c | acc])
  def scan_str([], acc) := [TStr(Prim.str_from_chars(rev(acc, [])))]

  # a char literal `'X'`: the codepoint of the single char, then the closing `'`.
  def scan_char(cs Vec(Char)) Vec(Tok)
  def scan_char([c, q | rest]) when q == '\'' := [TChar(Prim.char_code(c)) | lex(rest)]

  # a run of identifier chars -> the name string, classified as keyword / word-op
  # / id. `chars` accumulates in reverse, then `rev` + `Prim.str_from_chars`
  # rebuild the name in source order (portable: no host FFI).
  def lex_id(cs Vec(Char), chars Vec(Char)) Vec(Tok)
  def lex_id([c | rest], chars) when (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_' := lex_id(rest, [c | chars])
  def lex_id(cs, chars) := [classify(Prim.str_from_chars(rev(chars, []))) | lex(cs)]

  # the full keyword set (Rian.Lexer.@keywords); the word-operators
  # (and/or/not/in/rem/div) are `{:op, w}` in the reference, not keywords; the
  # rest is a plain identifier.
  def classify(name String) Tok
  def classify("and") := TOp("and")
  def classify("or") := TOp("or")
  def classify("not") := TOp("not")
  def classify("in") := TOp("in")
  def classify("rem") := TOp("rem")
  def classify("div") := TOp("div")
  def classify("if") := TKw("if")
  def classify("do") := TKw("do")
  def classify("else") := TKw("else")
  def classify("end") := TKw("end")
  def classify("def") := TKw("def")
  def classify("type") := TKw("type")
  def classify("range") := TKw("range")
  def classify("case") := TKw("case")
  def classify("when") := TKw("when")
  def classify("struct") := TKw("struct")
  def classify("alias") := TKw("alias")
  def classify("mod") := TKw("mod")
  def classify("pub") := TKw("pub")
  def classify("const") := TKw("const")
  def classify("macro") := TKw("macro")
  def classify("use") := TKw("use")
  def classify("with") := TKw("with")
  def classify(name) := TId(name)

  # reverse a Char list onto an accumulator (pure Rian, cons recursion)
  def rev(xs Vec(Char), acc Vec(Char)) Vec(Char)
  def rev([], acc) := acc
  def rev([x | xs], acc) := rev(xs, [x | acc])
end
