# ===========================================================================
# SELF-HOSTING — a Rian DECLARATION front-end, written in Rian (Stage 2)
# ===========================================================================
# Parses the declaration forms a program is made of into a `Decl` representation
# that, projected to `Rian.IR` (the test), matches what `Rian.Decl.parse` builds
# and is compiled + RUN by the real backend (`Rian.Beam.compile_ir/2`) — the
# Stage-2 thesis (ADR-0063): a Rian front-end producing IR the existing backend
# consumes, with no Elixir parse in the loop.
#
# Forms covered:
#   type Name := V1 | V2(T, …)                         sum declarations
#   struct Name(field Type, …)                         product (record) types
#   mod Name do … end                                  module nesting (incl. `pub def`)
#   def name(p [cap] Type, …) Ret [forall T, U: Bound] := expr   single typed clause
#   def name(pat, …) [when g] := expr                  pattern clause (multi-clause)
#   generics: `Ret forall T` / `Ret forall T, U: Eq + Ord` binders (ADR-0042),
#             carried as `tvars`/`bounds` on the function head
#   patterns: _ · var · Int literal · String/Char literal · Ctor(pat, …)
#             · cons/list [] / [h | t] (nested)
#   capabilities: val / iso / ref / tag (default val); parametric types `Vec(T)`
#   exprs: binops (precedence climbing) · prefix - / not · calls · `.field` access
#          · String/Char literals · labeled construction `Name(f: v)`
#          · list construction `[x | acc]` · map literal `%{k: v, …}` (kept as a
#            `MapE` node of `Label` fields; lowered to a Core map when emitting)
#          · `if COND do THEN else ELSE end` (single-expr branches; ADR-0063)
#          · `case SCRUT do PAT [when G] -> BODY … end` (single-expr arms; ADR-0063)
#          · `with C <- E [, …] do BODY [else ARMS] end` — kept as a `With` node
#            (preserving intent); the desugar to nested `case` is done when LOWERING
#            the AST to Core, not here (ADR-0039)
#
# Out of slice (the remaining long tail of Rian.Decl):
# negative-literal patterns, `alias`/`const`/`protocol`/`impl`,
# doc-comments, and multi-statement block (`do … end`) function bodies.
# ---------------------------------------------------------------------------

mod SelfhostDecl do
  type Tok :=
      TNum(String) | TStr(String) | TChar(Int53) | TId(String) | TKw(String) | TOp(String)
    | TAnnot(String) | TLP | TRP | TLBracket | TRBracket | TLBrace | TRBrace | TMapOpen | TComma | TNL

  # expression AST — Num/Id/Bin/Unary/Call lower to Rian.Pratt's surface tuples;
  # list construction is nil/cons (NilE / ConsE), flattened to `{:list_lit, …}` by
  # the projection (the cons `{:tail, …}` tag would otherwise collide with patterns).
  type Expr :=
      Num(String) | Str(String) | Char(Int53) | Id(String) | Atom(String) | Bin(String, Expr, Expr)
    | Unary(String, Expr) | Call(Expr, Vec(Expr))
    | Dot(Expr, String) | Label(String, Expr)
    | If(Expr, Expr, Expr)
    | Case(Expr, Vec(CaseArm))
    | With(Vec(WithClause), Expr, Vec(CaseArm))
    | BlockE(Vec(Stmt))
    | Tuple(Vec(Expr))
    | MapE(Vec(Expr))
    | NilE | ConsE(Expr, Expr) | EErr

  # a multi-statement block body (`def f() T <nl> b := e <nl> e <nl> end`): a
  # sequence of `name := expr` binds (SBind) and bare expressions (SExpr) ending in
  # a value. The projection (decl_fixpoint) lowers `BlockE` to Rian.Pratt's
  # `{:block, [{:bind, n, e} | {:expr, e}, …]}` (what `Pratt.parse_body` builds).
  type Stmt := SBind(String, Expr) | SExpr(Expr)

  # clause PATTERNS — Wild/Var/Lit/Ctor lower straight to Rian.Decl's tuples
  # (:wild / {:var,n} / {:lit,k} / {:ctor,c,ps}); list patterns are nil/cons
  # (NilP / ConsP), flattened to `{:list, elems, :close | {:tail,p}}` by the test.
  # StrP/CharP are literal patterns: a string pattern projects to `{:lit, s}` (like
  # an int `Lit`), a char pattern to `{:char_lit, cp}`.
  type Pat :=
      Wild | Var(String) | Lit(Int53) | StrP(String) | CharP(Int53) | AtomP(String) | Ctor(String, Vec(Pat))
    | TupleP(Vec(Pat))
    | NilP | ConsP(Pat, Pat)

  # a `case` arm — `pat [when guard] -> body`. Projects to Rian.Pratt's
  # `{pat, guard | nil, body}` (CArm → nil guard; CArmG → the guard expr).
  type CaseArm := CArm(Pat, Expr) | CArmG(Pat, Expr, Expr)

  # a `with` clause — `PAT <- EXPR`. A `with` carries an ordered list of these,
  # a body, and `else` arms (case-style). The desugar to nested `case` is a
  # lowering concern (ADR-0039), so the AST keeps the clauses intact.
  type WithClause := WC(Pat, Expr)

  type Variant := V(String, Vec(String))
  type Param := Par(String, String, String)
  type PType := PT(String, Vec(Tok))
  # a `forall` binder (ADR-0042): the tvar name + its protocol bounds (empty list
  # when unconstrained). `forall T: Eq + Ord` -> TV("T", ["Eq", "Ord"]).
  type TVar := TV(String, Vec(String))
  # `pub?` (a Bool) is carried on the function head (DFunc/DSig) so `pub def`
  # inside a `mod` projects to `Func.pub? = true` (exported on the BEAM); the
  # `Vec(TVar)` carries the `forall` generics (empty when none).
  type Decl :=
      DType(String, Vec(Variant))
    | DStruct(String, Vec(Param))
    | DFunc(Bool, String, Vec(Param), String, Vec(TVar), Expr)
    | DSig(Bool, String, Vec(Param), String, Vec(TVar))
    | DClause(String, Vec(Pat), Expr)
    | DClauseG(String, Vec(Pat), Expr, Expr)
    | DMod(String, Vec(Decl))
    | DExtern(String, String)
    | DDoc(String)
    | DTest
    | DTargets(Vec(String))
    | DPubType(String, Vec(Variant))
    | DUse(String)
    | DConst(String, String, String)
    | DRange(String, String, Int53, Int53)
    | DOpaque(String, String)
    | DProtocol(String, Vec(PMethod))
    | DImpl(String, String, Vec(IMethod))
    | DErr

  # a protocol method signature: name + detokenized parameter string + return type
  # string (the raw forms Rian.Decl stores, which are `Lexer.detokenize` output).
  type PMethod := PM(String, String, String)

  # an impl method clause: name + detokenized parameter string + detokenized body
  # string + guard string ("" = no guard — Rian has no nil, so "" is the sentinel
  # the projection maps back to a `nil` guard).
  type IMethod := IM(String, String, String, String)

  # a generated `protocol`/`impl` def (the desugar output of `Rian.Protocol.expand`):
  # the raw-def-map fields `Rian.Decl.build_func/1` consumes. Empty strings are the
  # `nil` sentinels for ret/guard/body (a bodiless dispatcher signature has body "").
  # `dispatch` is "dispatcher" | "impl"; the projection atomizes it.
  type GenFunc := GF(String, String, String, String, String, Bool, Vec(String), String, Bool)

  # collected protocol/impl declarations (the engine works over these, not raw Decls).
  type DProtoRec := DP(String, Vec(PMethod))
  type DImplRec := DI(String, String, Vec(IMethod))

  # result pairs (a value + the unconsumed tokens)
  type Parse := P(Expr, Vec(Tok))
  type Args := AP(Vec(Expr), Vec(Tok))
  type DeclRes := DR(Decl, Vec(Tok))
  type VarsRes := VR(Vec(Variant), Vec(Tok))
  type OneVar := OneV(Variant, Vec(Tok))
  type TypeList := TL(Vec(String), Vec(Tok))
  type ParamRes := PR(Param, Vec(Tok))
  type Paren := Paren(Vec(Tok), Vec(Tok))
  type PatRes := PP(Pat, Vec(Tok))
  type PatList := PL(Vec(Pat), Vec(Tok))
  type ModBody := MB(Vec(Tok), Vec(Tok))
  type BlockRes := BRes(Vec(Tok), Vec(Tok))
  type ArmRes := AR(CaseArm, Vec(Tok))
  type ArmsRes := ARs(Vec(CaseArm), Vec(Tok))
  type WClausesRes := WCs(Vec(WithClause), Vec(Tok))
  type Gen := GR(Vec(TVar), Vec(Tok))
  type LineRes := LR(Vec(Tok), Vec(Tok))
  type TVarRes := TVR(TVar, Vec(Tok))
  type BoundRes := BR(Vec(String), Vec(Tok))

  # ── program: declarations separated by significant newlines ──────────────
  pub def parse_program(ts Vec(Tok)) Vec(Decl)
  pub def parse_program([]) := []
  pub def parse_program([TNL | rest]) := parse_program(rest)
  pub def parse_program([TKw("type") | rest])
    case parse_type(rest) do
      DR(d, rest2) -> [d | parse_program(rest2)]
    end
  end
  # `pub type` — an exported sum type; parses like `type` but carries the `pub` flag
  # (Rian.IR.Type.pub?), so the projection marks it `pub?: true`.
  pub def parse_program([TKw("pub"), TKw("type") | rest])
    case parse_type(rest) do
      DR(d, rest2) -> [pub_type(d) | parse_program(rest2)]
    end
  end
  pub def parse_program([TKw("def") | rest])
    case parse_def(false, rest) do
      DR(d, rest2) -> [d | parse_program(rest2)]
    end
  end
  pub def parse_program([TKw("pub"), TKw("def") | rest])
    case parse_def(true, rest) do
      DR(d, rest2) -> [d | parse_program(rest2)]
    end
  end
  # `use Foo` — a module import (Rian.IR.Use); the projection collects it into the
  # enclosing module's `uses`. (Only the plain `use Path` form; `only:`/`as:` is tail.)
  pub def parse_program([TKw("use"), TId(path) | rest]) := [DUse(path) | parse_program(rest)]
  # `const NAME Type := <literal>` — a module constant (Rian.IR.Const; value is the
  # literal's source text). The plain single-literal form; a complex value expr is tail.
  pub def parse_program([TKw("const"), TId(name), TId(ty), TOp(":="), TNum(v) | rest]) := [DConst(name, ty, v) | parse_program(rest)]
  # `range Name := lo .. hi` — a bounded integer subrange (Rian.IR.Range; the int form
  # has base `Int64`). The projection collects it into the top-level `ranges`.
  pub def parse_program([TKw("range"), TId(name), TOp(":="), TNum(lo), TOp(".."), TNum(hi) | rest]) := [DRange(name, "Int64", str_to_int(lo), str_to_int(hi)) | parse_program(rest)]
  # `opaque Name := Base` — a nominal opaque wrapper (Rian.IR.Opaque); collected into
  # the top-level `opaques`.
  pub def parse_program([TKw("opaque"), TId(name), TOp(":="), TId(base) | rest]) := [DOpaque(name, base) | parse_program(rest)]
  # `alias Name := Base` — a transparent type alias. Rian.Decl CONSUMES it: it does
  # not appear in the output; instead `Name` is substituted by `Base` in every LATER
  # declaration's parameter/return types. So we parse the rest, then rewrite it (the
  # plain whole-type-name form; parametric `Vec(Name)` substitution is the tail).
  pub def parse_program([TKw("alias"), TId(name), TOp(":="), TId(base) | rest]) := subst_in(name, base, parse_program(rest))
  # `macro name(p, …) := body` — a term-rewriting macro. Rian.Decl CONSUMES it (no
  # output node) and EXPANDS every later `name(args)` call site to `body` with the
  # parameters substituted by the arguments. Parse the param names + body expression,
  # then expand it through the rest.
  pub def parse_program([TKw("macro"), TId(name), TLP | rest])
    case parse_typelist(rest) do
      TL(params, [TOp(":=") | body]) ->
        case parse_bp(0, skip_nl(body)) do
          P(b, rest2) -> expand_in(Mac(name, params, b), parse_program(rest2))
        end
      TL(_, other) -> parse_program(other)
    end
  end
  # `protocol Name do <method sigs> end` — a protocol declaration. Unlike a `def`,
  # its method signatures keep their parameter/return strings RAW (the detokenized
  # form Rian.Decl stores). No dispatcher is generated until an `impl` exists, so a
  # protocol on its own is just a `protocols` record (collected at the top level).
  pub def parse_program([TKw("protocol"), TId(name), TKw("do") | rest])
    case take_block(rest, 1, []) do
      BRes(body, after) -> [DProtocol(name, parse_pmethods(body)) | parse_program(after)]
    end
  end
  # `impl Proto for Type do <method defs> end` — `for` lexes as a plain id. The
  # method clauses carry RAW detokenized parameter/body strings (Rian.Decl defers
  # parsing them). The dispatcher + mangled impl functions are NOT generated here;
  # `expand_protocols` is the post-pass that desugars them (ADR-0042 §3).
  pub def parse_program([TKw("impl"), TId(proto), TId("for"), TId(ty), TKw("do") | rest])
    case take_block(rest, 1, []) do
      BRes(body, after) -> [DImpl(proto, ty, parse_imethods(body)) | parse_program(after)]
    end
  end
  pub def parse_program([TKw("struct") | rest])
    case parse_struct(rest) do
      DR(d, rest2) -> [d | parse_program(rest2)]
    end
  end
  pub def parse_program([TKw("mod"), TId(name), TKw("do") | rest])
    case take_mod_body(rest, []) do
      MB(inner, rest2) -> [DMod(name, parse_program(inner)) | parse_program(rest2)]
    end
  end
  # `@external(:target, "host code")` — an FFI annotation on the *following* bodiless
  # `def` (Rian.Decl.attach_external). It emits a `DExtern(target, code)` that the
  # projection folds into the next func's `externals` map (multiple stack). Modelled
  # as its own boundary token (`TAnnot`) so a preceding bodiless sig terminates here.
  pub def parse_program([TAnnot("external"), TLP, TOp(":"), TId(tgt), TComma, TStr(code), TRP | rest]) := [DExtern(tgt, code) | parse_program(rest)]
  # `@doc "text"` — a documentation annotation on the FOLLOWING declaration; emits a
  # DDoc that the projection folds into the next function's `doc` (Rian.Decl).
  pub def parse_program([TAnnot("doc"), TStr(text) | rest]) := [DDoc(text) | parse_program(rest)]
  # `@test` — marks the FOLLOWING `def` as a test; emits a DTest the projection folds
  # into the next function's `test?` flag (Rian.Decl).
  pub def parse_program([TAnnot("test") | rest]) := [DTest | parse_program(rest)]
  # `@targets(ex, js)` — restricts the FOLLOWING `mod` to a target set; emits a
  # DTargets the projection folds into the next module's `targets` (Rian.Decl). The
  # comma-separated id list reuses parse_typelist.
  pub def parse_program([TAnnot("targets"), TLP | rest])
    case parse_typelist(rest) do
      TL(tgts, rest2) -> [DTargets(tgts) | parse_program(rest2)]
    end
  end
  pub def parse_program([_ | rest]) := parse_program(rest)

  # ── alias substitution ────────────────────────────────────────────────────
  # An `alias Name := Base` is CONSUMED (no output node); `Name` is rewritten to
  # `Base` in every later declaration's parameter and return types — the plain
  # whole-type-name form. Mirrors Rian.Decl's transparent aliases.
  def subst_in(name String, base String, decls Vec(Decl)) Vec(Decl)
  def subst_in(_, _, []) := []
  def subst_in(name, base, [d | rest]) := [subst_decl(name, base, d) | subst_in(name, base, rest)]

  def subst_decl(name String, base String, d Decl) Decl
  def subst_decl(name, base, DFunc(pb, fn, ps, ret, tvs, body)) := DFunc(pb, fn, subst_params(name, base, ps), subst_ty(name, base, ret), tvs, body)
  def subst_decl(name, base, DSig(pb, fn, ps, ret, tvs)) := DSig(pb, fn, subst_params(name, base, ps), subst_ty(name, base, ret), tvs)
  def subst_decl(name, base, DStruct(sn, ps)) := DStruct(sn, subst_params(name, base, ps))
  def subst_decl(_, _, d) := d

  def subst_params(name String, base String, ps Vec(Param)) Vec(Param)
  def subst_params(_, _, []) := []
  def subst_params(name, base, [Par(pn, cap, ty) | rest]) := [Par(pn, cap, subst_ty(name, base, ty)) | subst_params(name, base, rest)]

  def subst_ty(name String, base String, ty String) String := if ty == name do base else ty end

  # ── macro expansion ───────────────────────────────────────────────────────
  # A macro carries its name, parameter names, and body template; `Subst` is one
  # param->argument binding for instantiating the template at a call site.
  type Macro := Mac(String, Vec(String), Expr)
  type Subst := SB(String, Expr)

  # walk every later declaration's function body, rewriting `name(args)` call sites
  # to the template body with the parameters substituted (the arguments are first
  # themselves expanded, so nested macro calls resolve).
  def expand_in(m Macro, decls Vec(Decl)) Vec(Decl)
  def expand_in(_, []) := []
  def expand_in(m, [d | rest]) := [expand_decl(m, d) | expand_in(m, rest)]

  def expand_decl(m Macro, d Decl) Decl
  def expand_decl(m, DFunc(pb, fn, ps, ret, tvs, body)) := DFunc(pb, fn, ps, ret, tvs, expand_e(m, body))
  def expand_decl(_, d) := d

  def expand_e(m Macro, e Expr) Expr
  def expand_e(Mac(mn, mp, mt), Call(Id(f), args))
    eargs := expand_es(Mac(mn, mp, mt), args)
    if f == mn do
      subst_e(zip_env(mp, eargs), mt)
    else
      Call(Id(f), eargs)
    end
  end
  def expand_e(m, Call(callee, args)) := Call(expand_e(m, callee), expand_es(m, args))
  def expand_e(m, Bin(op, l, r)) := Bin(op, expand_e(m, l), expand_e(m, r))
  def expand_e(m, Unary(op, x)) := Unary(op, expand_e(m, x))
  def expand_e(m, Dot(e, fld)) := Dot(expand_e(m, e), fld)
  def expand_e(m, Label(l, v)) := Label(l, expand_e(m, v))
  def expand_e(m, If(c, t, el)) := If(expand_e(m, c), expand_e(m, t), expand_e(m, el))
  def expand_e(m, Case(s, arms)) := Case(expand_e(m, s), expand_arms(m, arms))
  def expand_e(m, With(cs, b, els)) := With(expand_wclauses(m, cs), expand_e(m, b), expand_arms(m, els))
  def expand_e(m, BlockE(stmts)) := BlockE(expand_stmts(m, stmts))
  def expand_e(m, Tuple(es)) := Tuple(expand_es(m, es))
  def expand_e(m, MapE(es)) := MapE(expand_es(m, es))
  def expand_e(m, ConsE(h, t)) := ConsE(expand_e(m, h), expand_e(m, t))
  def expand_e(_, e) := e

  def expand_es(m Macro, es Vec(Expr)) Vec(Expr)
  def expand_es(_, []) := []
  def expand_es(m, [e | rest]) := [expand_e(m, e) | expand_es(m, rest)]

  def expand_arms(m Macro, arms Vec(CaseArm)) Vec(CaseArm)
  def expand_arms(_, []) := []
  def expand_arms(m, [CArm(p, b) | rest]) := [CArm(p, expand_e(m, b)) | expand_arms(m, rest)]
  def expand_arms(m, [CArmG(p, g, b) | rest]) := [CArmG(p, expand_e(m, g), expand_e(m, b)) | expand_arms(m, rest)]

  def expand_wclauses(m Macro, cs Vec(WithClause)) Vec(WithClause)
  def expand_wclauses(_, []) := []
  def expand_wclauses(m, [WC(p, e) | rest]) := [WC(p, expand_e(m, e)) | expand_wclauses(m, rest)]

  def expand_stmts(m Macro, ss Vec(Stmt)) Vec(Stmt)
  def expand_stmts(_, []) := []
  def expand_stmts(m, [SBind(n, e) | rest]) := [SBind(n, expand_e(m, e)) | expand_stmts(m, rest)]
  def expand_stmts(m, [SExpr(e) | rest]) := [SExpr(expand_e(m, e)) | expand_stmts(m, rest)]

  # instantiate the template: substitute each `Id(param)` by its bound argument.
  def zip_env(ps Vec(String), args Vec(Expr)) Vec(Subst)
  def zip_env([], _) := []
  def zip_env(_, []) := []
  def zip_env([p | ps], [a | as]) := [SB(p, a) | zip_env(ps, as)]

  def lookup_subst(env Vec(Subst), name String) Expr
  def lookup_subst([], name) := Id(name)
  def lookup_subst([SB(p, a) | rest], name) := if p == name do a else lookup_subst(rest, name) end

  def subst_e(env Vec(Subst), e Expr) Expr
  def subst_e(env, Id(name)) := lookup_subst(env, name)
  def subst_e(env, Bin(op, l, r)) := Bin(op, subst_e(env, l), subst_e(env, r))
  def subst_e(env, Unary(op, x)) := Unary(op, subst_e(env, x))
  def subst_e(env, Call(c, args)) := Call(subst_e(env, c), subst_es(env, args))
  def subst_e(env, Dot(e, fld)) := Dot(subst_e(env, e), fld)
  def subst_e(env, Label(l, v)) := Label(l, subst_e(env, v))
  def subst_e(env, If(c, t, el)) := If(subst_e(env, c), subst_e(env, t), subst_e(env, el))
  def subst_e(env, Case(s, arms)) := Case(subst_e(env, s), subst_arms(env, arms))
  def subst_e(env, With(cs, b, els)) := With(subst_wclauses(env, cs), subst_e(env, b), subst_arms(env, els))
  def subst_e(env, BlockE(stmts)) := BlockE(subst_stmts(env, stmts))
  def subst_e(env, Tuple(es)) := Tuple(subst_es(env, es))
  def subst_e(env, MapE(es)) := MapE(subst_es(env, es))
  def subst_e(env, ConsE(h, t)) := ConsE(subst_e(env, h), subst_e(env, t))
  def subst_e(_, e) := e

  def subst_es(env Vec(Subst), es Vec(Expr)) Vec(Expr)
  def subst_es(_, []) := []
  def subst_es(env, [e | rest]) := [subst_e(env, e) | subst_es(env, rest)]

  def subst_arms(env Vec(Subst), arms Vec(CaseArm)) Vec(CaseArm)
  def subst_arms(_, []) := []
  def subst_arms(env, [CArm(p, b) | rest]) := [CArm(p, subst_e(env, b)) | subst_arms(env, rest)]
  def subst_arms(env, [CArmG(p, g, b) | rest]) := [CArmG(p, subst_e(env, g), subst_e(env, b)) | subst_arms(env, rest)]

  def subst_wclauses(env Vec(Subst), cs Vec(WithClause)) Vec(WithClause)
  def subst_wclauses(_, []) := []
  def subst_wclauses(env, [WC(p, e) | rest]) := [WC(p, subst_e(env, e)) | subst_wclauses(env, rest)]

  def subst_stmts(env Vec(Subst), ss Vec(Stmt)) Vec(Stmt)
  def subst_stmts(_, []) := []
  def subst_stmts(env, [SBind(n, e) | rest]) := [SBind(n, subst_e(env, e)) | subst_stmts(env, rest)]
  def subst_stmts(env, [SExpr(e) | rest]) := [SExpr(subst_e(env, e)) | subst_stmts(env, rest)]

  # ── protocol method parsing ───────────────────────────────────────────────
  # parse the `def name(params) Ret` method signatures inside a `protocol` block.
  # Each method's parameter and return strings are kept RAW via `detok` (matching
  # Rian.Decl, which stores `Lexer.detokenize` output). Non-`def` lines (blank /
  # associated-type `type Elem`) are skipped — assoc parsing is a documented tail.
  def parse_pmethods(ts Vec(Tok)) Vec(PMethod)
  def parse_pmethods([]) := []
  def parse_pmethods([TNL | rest]) := parse_pmethods(rest)
  def parse_pmethods([TKw("def"), TId(name), TLP | rest])
    case take_parens(rest, 0, []) do
      Paren(inside, after) ->
        case take_line(after, []) do
          LR(ret_toks, rest2) -> [PM(name, detok(inside), detok(ret_toks)) | parse_pmethods(rest2)]
        end
    end
  end
  def parse_pmethods([_ | rest]) := parse_pmethods(rest)

  # collect tokens up to (and consuming) the next newline.
  def take_line(ts Vec(Tok), acc Vec(Tok)) LineRes
  def take_line([], acc) := LR(rev_tok(acc, []), [])
  def take_line([TNL | rest], acc) := LR(rev_tok(acc, []), rest)
  def take_line([t | rest], acc) := take_line(rest, [t | acc])

  # render a token list back to source text, space-joined — a port of
  # `Rian.Lexer.detokenize` (which is `Enum.map_join(" ", …)`). String escaping and
  # `Char` source rendering are the documented tail (they don't appear in the type
  # signatures / impl bodies the protocol port reconstructs).
  def detok(ts Vec(Tok)) String
  def detok([]) := ""
  def detok([t]) := tok_text(t)
  def detok([t | rest]) := Prim.str_concat(tok_text(t), Prim.str_concat(" ", detok(rest)))

  def tok_text(t Tok) String
  def tok_text(TId(s)) := s
  def tok_text(TKw(s)) := s
  def tok_text(TNum(s)) := s
  def tok_text(TOp(s)) := s
  def tok_text(TStr(s)) := Prim.str_concat(Prim.str_from_chars(['"']), Prim.str_concat(s, Prim.str_from_chars(['"'])))
  def tok_text(TAnnot(s)) := Prim.str_concat("@", s)
  def tok_text(TLP) := "("
  def tok_text(TRP) := ")"
  def tok_text(TLBracket) := "["
  def tok_text(TRBracket) := "]"
  def tok_text(TLBrace) := "{"
  def tok_text(TRBrace) := "}"
  def tok_text(TComma) := ","
  def tok_text(TNL) := " "
  # the wildcard covers `TChar` — its `'c'` source rendering is the documented tail
  # (chars don't appear in the type signatures / impl bodies the port reconstructs).
  def tok_text(_) := "?"

  # ── impl method parsing ───────────────────────────────────────────────────
  # `def name(params) := body` clauses inside an `impl` block. The parameter and
  # body strings are kept RAW via `detok`. `when` guards / block bodies are a
  # documented tail (the guard sentinel "" means none).
  def parse_imethods(ts Vec(Tok)) Vec(IMethod)
  def parse_imethods([]) := []
  def parse_imethods([TNL | rest]) := parse_imethods(rest)
  def parse_imethods([TKw("def"), TId(name), TLP | rest])
    case take_parens(rest, 0, []) do
      Paren(inside, [TOp(":=") | body_rest]) ->
        case take_line(body_rest, []) do
          LR(body_toks, rest2) -> [IM(name, detok(inside), detok(body_toks), "") | parse_imethods(rest2)]
        end
      Paren(_, after) -> parse_imethods(after)
    end
  end
  def parse_imethods([_ | rest]) := parse_imethods(rest)

  # ── protocol/impl desugar (port of Rian.Protocol.expand) ──────────────────
  # Generate the guarded dispatcher + mangled impl functions for every protocol
  # method that has a matching impl. The result is raw-def-map data (GenFunc) the
  # projection feeds to Rian.Decl.build_func — the engine (mangling, guard synthesis,
  # parameter assembly) is ported here; turning raw maps into Func is reused, exactly
  # as the backend Beam.compile_ir is reused.
  pub def expand_protocols(decls Vec(Decl)) Vec(GenFunc)
  pub def expand_protocols(decls) := join_gfs(dispatchers(collect_protocols(decls), collect_impls(decls)), impl_funcs(collect_impls(decls), collect_protocols(decls)))

  def join_gfs(a Vec(GenFunc), b Vec(GenFunc)) Vec(GenFunc)
  def join_gfs([], b) := b
  def join_gfs([x | xs], b) := [x | join_gfs(xs, b)]

  # ── collect the protocol/impl declarations ────────────────────────────────
  def collect_protocols(decls Vec(Decl)) Vec(DProtoRec)
  def collect_protocols([]) := []
  def collect_protocols([DProtocol(name, ms) | rest]) := [DP(name, ms) | collect_protocols(rest)]
  def collect_protocols([_ | rest]) := collect_protocols(rest)

  def collect_impls(decls Vec(Decl)) Vec(DImplRec)
  def collect_impls([]) := []
  def collect_impls([DImpl(proto, ty, ms) | rest]) := [DI(proto, ty, ms) | collect_impls(rest)]
  def collect_impls([_ | rest]) := collect_impls(rest)

  # ── dispatchers: one guarded clause per matching impl, headed by a bodiless sig ─
  def dispatchers(protos Vec(DProtoRec), impls Vec(DImplRec)) Vec(GenFunc)
  def dispatchers([], _) := []
  def dispatchers([DP(pname, ms) | rest], impls) := join_gfs(disp_methods(pname, ms, impls), dispatchers(rest, impls))

  def disp_methods(pname String, ms Vec(PMethod), impls Vec(DImplRec)) Vec(GenFunc)
  def disp_methods(_, [], _) := []
  def disp_methods(pname, [PM(mname, mparams, mret) | rest], impls) := join_gfs(one_dispatcher(pname, mname, mparams, mret, impls), disp_methods(pname, rest, impls))

  # a method's dispatcher: bodiless sig (params renamed to v0.., ret kept, Self
  # listed as a tvar, synthetic) followed by one guarded clause per matching impl.
  # No matching impl -> no dispatcher (a bodiless sig with no clauses is not a func).
  def one_dispatcher(pname String, mname String, mparams String, mret String, impls Vec(DImplRec)) Vec(GenFunc)
  def one_dispatcher(pname, mname, mparams, mret, impls)
    arity := len(split_commas(mparams))
    vars := gen_vars(0, arity)
    matching := disp_clauses(pname, mname, vars, impls)
    if is_empty(matching) do
      []
    else
      [GF(mname, dispatcher_params(split_commas(mparams), vars), mret, "", "", true, ["Self"], "dispatcher", true) | matching]
    end
  end

  def disp_clauses(pname String, mname String, vars Vec(String), impls Vec(DImplRec)) Vec(GenFunc)
  def disp_clauses(_, _, _, []) := []
  def disp_clauses(pname, mname, vars, [DI(iproto, ity, _) | rest])
    if iproto == pname do
      [GF(mname, join_commas(vars), "", guard_for(ity), Prim.str_concat(mangle(pname, ity, mname), Prim.str_concat("(", Prim.str_concat(join_commas(vars), ")"))), false, [], "dispatcher", false) | disp_clauses(pname, mname, vars, rest)]
    else
      disp_clauses(pname, mname, vars, rest)
    end
  end

  # ── impl methods: one mangled single-clause function per impl method ──────
  def impl_funcs(impls Vec(DImplRec), protos Vec(DProtoRec)) Vec(GenFunc)
  def impl_funcs([], _) := []
  def impl_funcs([DI(proto, ty, ms) | rest], protos) := join_gfs(impl_methods(proto, ty, ms, protos), impl_funcs(rest, protos))

  def impl_methods(proto String, ty String, ms Vec(IMethod), protos Vec(DProtoRec)) Vec(GenFunc)
  def impl_methods(_, _, [], _) := []
  def impl_methods(proto, ty, [IM(mname, mparams, mbody, mguard) | rest], protos) := [one_impl(proto, ty, mname, mparams, mbody, mguard, find_sig(proto, mname, protos)) | impl_methods(proto, ty, rest, protos)]

  # build a mangled single-clause impl function: the impl's parameter NAMES carry the
  # protocol's parameter TYPES (Self substituted to the impl type).
  def one_impl(proto String, ty String, mname String, mparams String, mbody String, mguard String, sig PMethod) GenFunc
  def one_impl(proto, ty, mname, mparams, mbody, mguard, PM(_, sparams, sret)) := GF(mangle(proto, ty, mname), zip_params(split_commas(mparams), subst_self_all(map_param_type(split_commas(sparams)), ty)), subst_self(sret, ty), mguard, mbody, false, [], "impl", false)

  # the protocol method signature with the given name, or PM("","","") if absent.
  def find_sig(proto String, mname String, protos Vec(DProtoRec)) PMethod
  def find_sig(_, _, []) := PM("", "", "")
  def find_sig(proto, mname, [DP(pname, ms) | rest])
    if pname == proto do
      find_in(mname, ms, find_sig(proto, mname, rest))
    else
      find_sig(proto, mname, rest)
    end
  end

  def find_in(mname String, ms Vec(PMethod), fallback PMethod) PMethod
  def find_in(_, [], fallback) := fallback
  def find_in(mname, [PM(n, p, r) | rest], fallback) := if n == mname do PM(n, p, r) else find_in(mname, rest, fallback) end

  # ── small list/string utilities for the desugar ───────────────────────────
  def rev(xs Vec(T), acc Vec(T)) Vec(T) forall T
  def rev([], acc) := acc
  def rev([x | xs], acc) := rev(xs, [x | acc])

  def len(xs Vec(T)) Int53 forall T
  def len([]) := 0
  def len([_ | rest]) := 1 + len(rest)

  def is_empty(xs Vec(T)) Bool forall T
  def is_empty([]) := true
  def is_empty(_) := false

  # `v0, v1, …, v(n-1)` — the dispatch variable names for an arity-`n` method.
  def gen_vars(i Int53, n Int53) Vec(String)
  def gen_vars(i, n) := if i >= n do [] else [Prim.str_concat("v", Prim.int_to_string(i)) | gen_vars(i + 1, n)] end

  def join_commas(xs Vec(String)) String
  def join_commas([]) := ""
  def join_commas([x]) := x
  def join_commas([x | rest]) := Prim.str_concat(x, Prim.str_concat(", ", join_commas(rest)))

  # the receiver type-test guard over `v0` (port of guard_for!). Primitives only;
  # sum/struct dispatch (tag/struct guards needing the type registry) is the tail.
  def guard_for(ty String) String
  def guard_for("Bool") := "is_boolean(v0)"
  def guard_for("String") := "is_binary(v0)"
  def guard_for("Char") := "is_integer(v0)"
  def guard_for("Int") := "is_integer(v0)"
  def guard_for("Int8") := "is_integer(v0)"
  def guard_for("Int16") := "is_integer(v0)"
  def guard_for("Int32") := "is_integer(v0)"
  def guard_for("Int53") := "is_integer(v0)"
  def guard_for("Int64") := "is_integer(v0)"
  def guard_for("Int128") := "is_integer(v0)"
  def guard_for("UInt8") := "is_integer(v0)"
  def guard_for("UInt16") := "is_integer(v0)"
  def guard_for("UInt32") := "is_integer(v0)"
  def guard_for("UInt64") := "is_integer(v0)"
  def guard_for("UInt128") := "is_integer(v0)"
  def guard_for("Float") := "is_float(v0)"
  def guard_for("Float32") := "is_float(v0)"
  def guard_for("Float64") := "is_float(v0)"
  def guard_for(_) := "is_integer(v0)"

  # `impl_<proto>_<type>_<method>` (lowercased proto/type), port of `mangle`.
  def mangle(proto String, ty String, method String) String := Prim.str_concat("impl_", Prim.str_concat(downcase(proto), Prim.str_concat("_", Prim.str_concat(downcase(ty), Prim.str_concat("_", method)))))

  def downcase(s String) String := concat_strs(map_lower(Prim.str_chars(s)))

  def concat_strs(xs Vec(String)) String
  def concat_strs([]) := ""
  def concat_strs([x | rest]) := Prim.str_concat(x, concat_strs(rest))

  def map_lower(cs Vec(Char)) Vec(String)
  def map_lower([]) := []
  def map_lower([c | rest]) := [lower_char_str(c) | map_lower(rest)]

  # there is no int->char prim, so map each upper-case letter to its lower-case
  # STRING by literal; any other char renders as itself.
  def lower_char_str(c Char) String
  def lower_char_str('A') := "a"
  def lower_char_str('B') := "b"
  def lower_char_str('C') := "c"
  def lower_char_str('D') := "d"
  def lower_char_str('E') := "e"
  def lower_char_str('F') := "f"
  def lower_char_str('G') := "g"
  def lower_char_str('H') := "h"
  def lower_char_str('I') := "i"
  def lower_char_str('J') := "j"
  def lower_char_str('K') := "k"
  def lower_char_str('L') := "l"
  def lower_char_str('M') := "m"
  def lower_char_str('N') := "n"
  def lower_char_str('O') := "o"
  def lower_char_str('P') := "p"
  def lower_char_str('Q') := "q"
  def lower_char_str('R') := "r"
  def lower_char_str('S') := "s"
  def lower_char_str('T') := "t"
  def lower_char_str('U') := "u"
  def lower_char_str('V') := "v"
  def lower_char_str('W') := "w"
  def lower_char_str('X') := "x"
  def lower_char_str('Y') := "y"
  def lower_char_str('Z') := "z"
  def lower_char_str(c) := Prim.str_from_chars([c])

  # the dispatcher signature: keep each protocol param's TYPE, rename to `v0, v1, …`.
  def dispatcher_params(params Vec(String), vars Vec(String)) String := join_commas(zip_disp(params, vars))

  def zip_disp(params Vec(String), vars Vec(String)) Vec(String)
  def zip_disp([], _) := []
  def zip_disp(_, []) := []
  def zip_disp([p | ps], [v | vs]) := [Prim.str_concat(v, Prim.str_concat(" ", param_type(p))) | zip_disp(ps, vs)]

  # the impl-method parameters: zip the impl's parameter NAMES with the protocol's
  # parameter TYPES (Self already substituted), as `name type`.
  def zip_params(names Vec(String), types Vec(String)) String := join_commas(zip_nt(names, types))

  def zip_nt(names Vec(String), types Vec(String)) Vec(String)
  def zip_nt([], _) := []
  def zip_nt(_, []) := []
  def zip_nt([n | ns], [t | ts]) := [Prim.str_concat(n, Prim.str_concat(" ", t)) | zip_nt(ns, ts)]

  def map_param_type(ps Vec(String)) Vec(String)
  def map_param_type([]) := []
  def map_param_type([p | rest]) := [param_type(p) | map_param_type(rest)]

  # the TYPE of a `name Type` (or bare `Type`) parameter — the last space token.
  def param_type(p String) String := last_token(split_spaces(p))

  def last_token(xs Vec(String)) String
  def last_token([]) := ""
  def last_token([x]) := x
  def last_token([_ | rest]) := last_token(rest)

  # whole-word `Self` -> the impl type. Embedded `Self` (e.g. `Vec(Self)`) is the tail.
  def subst_self(t String, ty String) String := if t == "Self" do ty else t end

  def subst_self_all(ts Vec(String), ty String) Vec(String)
  def subst_self_all([], _) := []
  def subst_self_all([t | rest], ty) := [subst_self(t, ty) | subst_self_all(rest, ty)]

  # split a parameter string on TOP-LEVEL commas (a comma inside `(…)` is part of one
  # parameter's parametric type); each piece trimmed, empties dropped — port of
  # Rian.TypeStr.split_top_commas.
  def split_commas(s String) Vec(String) := reject_empty(parts_to_str(sc(Prim.str_chars(s), 0, [], [])))

  def sc(cs Vec(Char), depth Int53, cur Vec(Char), parts Vec(Vec(Char))) Vec(Vec(Char))
  def sc([], _, cur, parts) := rev([rev(cur, []) | parts], [])
  def sc([c | rest], depth, cur, parts)
    if (c == ',') and (depth == 0) do
      sc(rest, 0, [], [rev(cur, []) | parts])
    else
      sc(rest, next_depth(c, depth), [c | cur], parts)
    end
  end

  def next_depth(c Char, d Int53) Int53
  def next_depth('(', d) := d + 1
  def next_depth(')', d) := d - 1
  def next_depth(_, d) := d

  # split on (runs of) spaces — empties dropped, so leading/trailing/multiple spaces
  # collapse (matching `String.split(~r/\s+/)` for the space case).
  def split_spaces(s String) Vec(String) := reject_empty(parts_to_str(sp(Prim.str_chars(s), [], [])))

  def sp(cs Vec(Char), cur Vec(Char), parts Vec(Vec(Char))) Vec(Vec(Char))
  def sp([], cur, parts) := rev([rev(cur, []) | parts], [])
  def sp([' ' | rest], cur, parts) := sp(rest, [], [rev(cur, []) | parts])
  def sp([c | rest], cur, parts) := sp(rest, [c | cur], parts)

  def parts_to_str(ps Vec(Vec(Char))) Vec(String)
  def parts_to_str([]) := []
  def parts_to_str([p | rest]) := [Prim.str_from_chars(p) | parts_to_str(rest)]

  def reject_empty(xs Vec(String)) Vec(String)
  def reject_empty([]) := []
  def reject_empty([x | rest]) := if x == "" do reject_empty(rest) else [x | reject_empty(rest)] end

  # parse a standalone EXPRESSION from a token list (the driver uses this to inline
  # an `@external(:ex, "host expr")` body, ADR-0068). Trailing tokens are ignored.
  pub def parse_expr(ts Vec(Tok)) Expr
  pub def parse_expr(ts)
    case parse_bp(0, ts) do
      P(e, _) -> e
    end
  end

  # struct Name(field Type, …) — a product type; fields reuse the param grammar.
  def parse_struct(ts Vec(Tok)) DeclRes
  def parse_struct([TId(name), TLP | rest])
    case take_parens(rest, 0, []) do
      Paren(inside, after) -> DR(DStruct(name, parse_params(inside)), after)
    end
  end
  def parse_struct(ts) := DR(DErr, ts)

  # collect a `mod` body up to its matching `end` (a block `end` from a nested
  # `if`/`case` is balanced by its `do`); returns (inner-tokens, rest).
  def take_mod_body(ts Vec(Tok), acc Vec(Tok)) ModBody
  def take_mod_body([TKw("do") | rest], acc) := take_mod_body_do(rest, [TKw("do") | acc], 1)
  def take_mod_body([TKw("end") | rest], acc) := MB(rev_tok(acc, []), rest)
  def take_mod_body([t | rest], acc) := take_mod_body(rest, [t | acc])
  def take_mod_body([], acc) := MB(rev_tok(acc, []), [])

  # inside a nested do-block: track depth so the block's `end` doesn't close the mod.
  def take_mod_body_do(ts Vec(Tok), acc Vec(Tok), depth Int53) ModBody
  def take_mod_body_do([TKw("do") | rest], acc, depth) := take_mod_body_do(rest, [TKw("do") | acc], depth + 1)
  def take_mod_body_do([TKw("end") | rest], acc, 1) := take_mod_body(rest, [TKw("end") | acc])
  def take_mod_body_do([TKw("end") | rest], acc, depth) := take_mod_body_do(rest, [TKw("end") | acc], depth - 1)
  def take_mod_body_do([t | rest], acc, depth) := take_mod_body_do(rest, [t | acc], depth)
  def take_mod_body_do([], acc, depth) := MB(rev_tok(acc, []), [])

  # ── type Name := variant ('|' variant)* ──────────────────────────────────
  def parse_type(ts Vec(Tok)) DeclRes
  def parse_type([TId(name), TOp(":=") | rest])
    case parse_variants(rest) do
      VR(vs, rest2) -> DR(DType(name, vs), rest2)
    end
  end
  def parse_type(ts) := DR(DErr, ts)

  # mark a parsed `type` as `pub` (DType -> DPubType); a parse error passes through.
  def pub_type(Decl) Decl
  def pub_type(DType(name, vs)) := DPubType(name, vs)
  def pub_type(d) := d

  # a sum's variants, `|`-separated. The `|` may begin on the NEXT line (a multi-line
  # `type X := A\n  | B\n  | C`, P1), so skip newlines before looking for it; the
  # non-`|` tail keeps its original tokens (the newline separates the next decl).
  def parse_variants(ts Vec(Tok)) VarsRes
  def parse_variants(ts)
    case parse_variant(ts) do
      OneV(v, after) ->
        case skip_nl(after) do
          [TOp("|") | rest] ->
            case parse_variants(rest) do
              VR(more, rest2) -> VR([v | more], rest2)
            end
          _ -> VR([v], after)
        end
    end
  end

  def parse_variant(ts Vec(Tok)) OneVar
  def parse_variant([TId(ctor), TLP | rest])
    case parse_typelist(rest) do
      TL(types, rest2) -> OneV(V(ctor, types), rest2)
    end
  end
  def parse_variant([TId(ctor) | rest]) := OneV(V(ctor, []), rest)
  def parse_variant(ts) := OneV(V("", []), ts)

  # a variant's argument types, comma-separated up to `)`. Each element is a full
  # type via `parse_ptype`, so a parametric arg like `Vec(Ty)` counts as ONE type
  # (not truncated) — the arity the exhaustiveness gate reads must be correct.
  def parse_typelist(ts Vec(Tok)) TypeList
  def parse_typelist([TRP | rest]) := TL([], rest)
  def parse_typelist(ts)
    case parse_ptype(ts) do
      PT(t, [TComma | rest]) ->
        case parse_typelist(rest) do
          TL(more, r) -> TL([t | more], r)
        end
      PT(t, [TRP | rest]) -> TL([t], rest)
      PT(t, rest) -> TL([t], rest)
    end
  end

  # ── def: split the parenthesized head, then classify by what follows ──────
  def parse_def(pb Bool, ts Vec(Tok)) DeclRes
  def parse_def(pb, [TId(name), TLP | rest])
    case take_parens(rest, 0, []) do
      Paren(inside, after) -> classify_def(pb, name, inside, after)
    end
  end
  def parse_def(pb, ts) := DR(DErr, ts)

  # collect tokens up to the matching `)` (depth 0), returning (inside, rest).
  def take_parens(ts Vec(Tok), depth Int53, acc Vec(Tok)) Paren
  def take_parens([TRP | rest], 0, acc) := Paren(rev_tok(acc, []), rest)
  def take_parens([TRP | rest], depth, acc) := take_parens(rest, depth - 1, [TRP | acc])
  def take_parens([TLP | rest], depth, acc) := take_parens(rest, depth + 1, [TLP | acc])
  def take_parens([t | rest], depth, acc) := take_parens(rest, depth, [t | acc])
  def take_parens([], depth, acc) := Paren(rev_tok(acc, []), [])

  # `(pats) when g := body` / `(pats) := body` -> a pattern clause; `(params) Ret
  # := body` -> a typed single clause; `(params) Ret` -> a bodiless signature.
  def classify_def(pb Bool, name String, inside Vec(Tok), after Vec(Tok)) DeclRes
  def classify_def(pb, name, inside, [TKw("when") | rest])
    case parse_bp(0, rest) do
      P(g, [TOp(":=") | body]) ->
        case parse_bp(0, skip_nl(body)) do
          P(b, rest2) -> DR(DClauseG(name, parse_pats(inside), g, b), rest2)
        end
      P(_, other) -> DR(DErr, other)
    end
  end
  def classify_def(pb, name, inside, [TOp(":=") | body])
    case parse_bp(0, skip_nl(body)) do
      P(b, rest) -> DR(DClause(name, parse_pats(inside), b), rest)
    end
  end
  def classify_def(pb, name, inside, [TId(rb) | rb_rest])
    case parse_ptype([TId(rb) | rb_rest]) do
      PT(ret, after) -> finish_sig(pb, name, inside, ret, after)
    end
  end
  # an UNTYPED clause with a multi-statement block body: `def f(pats) <nl> stmts end`
  # (no `:=`, no return type — the dominant form for a multi-clause function's
  # clauses). Collect the block to its matching `end` and parse its statements.
  def classify_def(pb, name, inside, [TNL | rest])
    case take_block(rest, 1, []) do
      BRes(block, after) -> DR(DClause(name, parse_pats(inside), BlockE(parse_stmts(block))), after)
    end
  end
  def classify_def(pb, name, inside, after) := DR(DErr, after)

  # after the return type comes an optional `forall T, U: Bound` binder list, then
  # either `:= body` (a typed single clause) or nothing (a bodiless signature).
  def finish_sig(pb Bool, name String, inside Vec(Tok), ret String, after Vec(Tok)) DeclRes
  def finish_sig(pb, name, inside, ret, after)
    case parse_forall(after) do
      GR(tvs, [TOp(":=") | body]) ->
        case parse_bp(0, skip_nl(body)) do
          P(b, rest) -> DR(DFunc(pb, name, parse_params(inside), ret, tvs, b), rest)
        end
      GR(tvs, rest) -> finish_body(pb, name, parse_params(inside), ret, tvs, rest)
    end
  end

  # No `:=` after the head: either a multi-statement block body (`<nl> stmts end`)
  # or a bodiless signature (a multi-clause head). Mirrors Rian.Decl.take_head: a
  # newline followed by a declaration boundary is a bodiless sig; otherwise collect
  # the block to its matching `end` and parse the statements.
  def finish_body(pb Bool, name String, ps Vec(Param), ret String, tvs Vec(TVar), ts Vec(Tok)) DeclRes
  def finish_body(pb, name, ps, ret, tvs, [TNL | rest])
    if starts_decl(rest) do
      DR(DSig(pb, name, ps, ret, tvs), [TNL | rest])
    else
      case take_block(rest, 1, []) do
        BRes(block, after) -> DR(DFunc(pb, name, ps, ret, tvs, BlockE(parse_stmts(block))), after)
      end
    end
  end
  def finish_body(pb, name, ps, ret, tvs, ts) := DR(DSig(pb, name, ps, ret, tvs), ts)

  # collect a block body up to its matching `end` (depth 1 = the implicit body
  # block); a nested `do … end` (`if`/`case`) is balanced. Returns (body, rest).
  def take_block(ts Vec(Tok), depth Int53, acc Vec(Tok)) BlockRes
  def take_block([TKw("do") | rest], depth, acc) := take_block(rest, depth + 1, [TKw("do") | acc])
  def take_block([TKw("end") | rest], 1, acc) := BRes(rev_tok(acc, []), rest)
  def take_block([TKw("end") | rest], depth, acc) := take_block(rest, depth - 1, [TKw("end") | acc])
  def take_block([t | rest], depth, acc) := take_block(rest, depth, [t | acc])
  def take_block([], depth, acc) := BRes(rev_tok(acc, []), [])

  # a declaration boundary (Rian.Decl.decl_boundary?): a decl keyword or `end`.
  def starts_decl(ts Vec(Tok)) Bool
  def starts_decl([TKw(k) | _]) :=
    k == "def" or k == "type" or k == "struct" or k == "pub" or k == "mod" or
      k == "end" or k == "alias" or k == "const" or k == "macro" or k == "use" or
      k == "import" or k == "protocol" or k == "impl" or k == "opaque" or k == "abstract"
  # an `@`-annotation (`@external`) begins the next declaration: a bodiless sig must
  # terminate at it rather than swallow it as a block body.
  def starts_decl([TAnnot(_) | _]) := true
  def starts_decl(ts) := false

  # parse the collected block tokens into statements: `name := expr` is a bind, any
  # other leading token starts a bare expression. `parse_bp` stops at the block-level
  # newline that separates statements (it climbs only over operators).
  def parse_stmts(ts Vec(Tok)) Vec(Stmt)
  def parse_stmts([]) := []
  def parse_stmts([TNL | rest]) := parse_stmts(rest)
  def parse_stmts([TId(n), TOp(":=") | rest])
    case parse_bp(0, rest) do
      P(e, rest2) -> [SBind(n, e) | parse_stmts(rest2)]
    end
  end
  def parse_stmts(ts)
    case parse_bp(0, ts) do
      P(e, rest2) -> [SExpr(e) | parse_stmts(rest2)]
    end
  end

  # `forall T` / `forall T, U: Eq + Ord` -> the binder list (each tvar with its
  # bounds); absent -> no binders. Mirrors Rian.Decl.split_forall (ADR-0042).
  def parse_forall(ts Vec(Tok)) Gen
  def parse_forall([TId("forall") | rest]) := parse_tvars(rest)
  def parse_forall(ts) := GR([], ts)

  def parse_tvars(ts Vec(Tok)) Gen
  def parse_tvars(ts)
    case parse_tvar(ts) do
      TVR(tv, [TComma | rest]) ->
        case parse_tvars(rest) do
          GR(more, r) -> GR([tv | more], r)
        end
      TVR(tv, rest) -> GR([tv], rest)
    end
  end

  # one binder: `T` (unconstrained) or `T: Proto (+ Proto)*`.
  def parse_tvar(ts Vec(Tok)) TVarRes
  def parse_tvar([TId(name), TOp(":") | rest])
    case parse_bounds(rest) do
      BR(bs, r) -> TVR(TV(name, bs), r)
    end
  end
  def parse_tvar([TId(name) | rest]) := TVR(TV(name, []), rest)
  def parse_tvar(ts) := TVR(TV("", []), ts)

  # bounds after a `:` — `Proto` chained with `+`, stopping at `,`/`:=`/end.
  def parse_bounds(ts Vec(Tok)) BoundRes
  def parse_bounds([TId(p), TOp("+") | rest])
    case parse_bounds(rest) do
      BR(more, r) -> BR([p | more], r)
    end
  end
  def parse_bounds([TId(p) | rest]) := BR([p], rest)
  def parse_bounds(ts) := BR([], ts)

  # ── parameters: `name [cap] Type` (cap in val/iso/ref/tag, default val) ────
  def parse_params(ts Vec(Tok)) Vec(Param)
  def parse_params([]) := []
  def parse_params(ts)
    case parse_param(ts) do
      PR(p, [TComma | rest]) -> [p | parse_params(rest)]
      PR(p, _) -> [p]
    end
  end

  # `name [cap] Type` where cap in val/iso/ref/tag (default val) and Type may be a
  # simple id or a single-arg parametric type `Base(Arg)` (e.g. `Vec(Int53)`).
  def parse_param(ts Vec(Tok)) ParamRes
  def parse_param([TId(n), TId("val") | rest])
    case parse_ptype(rest) do
      PT(t, r) -> PR(Par(n, "val", t), r)
    end
  end
  def parse_param([TId(n), TId("iso") | rest])
    case parse_ptype(rest) do
      PT(t, r) -> PR(Par(n, "iso", t), r)
    end
  end
  def parse_param([TId(n), TId("ref") | rest])
    case parse_ptype(rest) do
      PT(t, r) -> PR(Par(n, "ref", t), r)
    end
  end
  def parse_param([TId(n), TId("tag") | rest])
    case parse_ptype(rest) do
      PT(t, r) -> PR(Par(n, "tag", t), r)
    end
  end
  def parse_param([TId(n) | rest])
    case parse_ptype(rest) do
      PT(t, r) -> PR(Par(n, "val", t), r)
    end
  end
  def parse_param(ts) := PR(Par("", "val", ""), ts)

  # a type: simple `Id`, or single-arg parametric `Base(Arg)` rebuilt as the string
  # `"Base(Arg)"` (matches Rian.Decl's collapsed spacing).
  def parse_ptype(ts Vec(Tok)) PType
  def parse_ptype([TId(base), TLP, TId(arg), TRP | rest]) := PT(Prim.str_concat(base, Prim.str_concat("(", Prim.str_concat(arg, ")"))), rest)
  def parse_ptype([TId(t) | rest]) := PT(t, rest)
  def parse_ptype(ts) := PT("", ts)

  # ── clause patterns ───────────────────────────────────────────────────────
  def parse_pats(ts Vec(Tok)) Vec(Pat)
  def parse_pats([]) := []
  def parse_pats(ts)
    case parse_pat(ts) do
      PP(p, [TComma | rest]) -> [p | parse_pats(rest)]
      PP(p, _) -> [p]
    end
  end

  def parse_pat(ts Vec(Tok)) PatRes
  def parse_pat([TId("_") | rest]) := PP(Wild, rest)
  def parse_pat([TNum(s) | rest]) := PP(Lit(str_to_int(s)), rest)
  def parse_pat([TStr(s) | rest]) := PP(StrP(s), rest)
  def parse_pat([TChar(cp) | rest]) := PP(CharP(cp), rest)
  def parse_pat([TOp(":"), TId(name) | rest]) := PP(AtomP(name), rest)
  def parse_pat([TOp(":"), TStr(name) | rest]) := PP(AtomP(name), rest)
  def parse_pat([TLBrace | rest])
    case parse_tuple_pat(rest) do
      PL(ps, rest2) -> PP(TupleP(ps), rest2)
    end
  end
  def parse_pat([TLBracket | rest]) := parse_list_pat(rest)
  def parse_pat([TId(ctor), TLP | rest])
    case parse_patlist(rest) do
      PL(args, rest2) -> PP(Ctor(ctor, args), rest2)
    end
  end
  def parse_pat([TId(x) | rest])
    if is_upper(x) do
      PP(Ctor(x, []), rest)
    else
      PP(Var(x), rest)
    end
  end
  def parse_pat(ts) := PP(Wild, ts)

  # list pattern as a nil/cons chain: `[]` -> NilP, `[a, b]` -> ConsP(a, ConsP(b,
  # NilP)), `[h | t]` -> ConsP(h, t).
  def parse_list_pat(ts Vec(Tok)) PatRes
  def parse_list_pat([TRBracket | rest]) := PP(NilP, rest)
  def parse_list_pat(ts)
    case parse_pat(ts) do
      PP(h, [TComma | rest]) ->
        case parse_list_pat(rest) do
          PP(t, r) -> PP(ConsP(h, t), r)
        end
      PP(h, [TOp("|") | rest]) ->
        case parse_pat(rest) do
          PP(t, [TRBracket | r]) -> PP(ConsP(h, t), r)
          PP(t, other) -> PP(ConsP(h, t), other)
        end
      PP(h, [TRBracket | rest]) -> PP(ConsP(h, NilP), rest)
      PP(h, rest) -> PP(ConsP(h, NilP), rest)
    end
  end

  def parse_patlist(ts Vec(Tok)) PatList
  def parse_patlist([TRP | rest]) := PL([], rest)
  def parse_patlist(ts)
    case parse_pat(ts) do
      PP(p, [TComma | rest]) ->
        case parse_patlist(rest) do
          PL(more, r) -> PL([p | more], r)
        end
      PP(p, [TRP | rest]) -> PL([p], rest)
      PP(p, rest) -> PL([p], rest)
    end
  end

  # tuple pattern elements: comma-separated patterns terminated by `}` (mirrors
  # parse_patlist, brace-closed). `{:ok, m, bin}` -> TupleP([AtomP, Var, Var]).
  def parse_tuple_pat(ts Vec(Tok)) PatList
  def parse_tuple_pat([TRBrace | rest]) := PL([], rest)
  def parse_tuple_pat(ts)
    case parse_pat(ts) do
      PP(p, [TComma | rest]) ->
        case parse_tuple_pat(rest) do
          PL(more, r) -> PL([p | more], r)
        end
      PP(p, [TRBrace | rest]) -> PL([p], rest)
      PP(p, rest) -> PL([p], rest)
    end
  end

  # ── expression parser (precedence climbing — mirrors Rian.Pratt) ──────────
  def parse_bp(min_bp Int53, ts Vec(Tok)) Parse
  def parse_bp(min_bp, ts)
    case parse_prefix(ts) do
      P(lhs, rest) -> climb(min_bp, lhs, rest)
    end
  end

  def climb(min_bp Int53, lhs Expr, ts Vec(Tok)) Parse
  def climb(min_bp, lhs, [TOp(op) | rest])
    if lbp(op) >= min_bp do
      # the RHS may begin on the next line (a trailing binary operator continues the
      # expression, P1): `a or <nl> b`. Skip the newline so the RHS parses.
      case parse_bp(rbp(op), skip_nl(rest)) do
        P(rhs, rest2) -> climb(min_bp, Bin(op, lhs, rhs), rest2)
      end
    else
      P(lhs, [TOp(op) | rest])
    end
  end
  def climb(min_bp, lhs, ts) := P(lhs, ts)

  def parse_prefix(ts Vec(Tok)) Parse
  def parse_prefix([TOp("-") | rest])
    case parse_bp(110, rest) do
      P(x, rest2) -> P(Unary("-", x), rest2)
    end
  end
  def parse_prefix([TOp("not") | rest])
    case parse_bp(110, rest) do
      P(x, rest2) -> P(Unary("not", x), rest2)
    end
  end
  def parse_prefix(ts) := parse_primary(ts)

  def parse_primary(ts Vec(Tok)) Parse
  def parse_primary([TNum(n) | rest]) := parse_postfix(Num(n), rest)
  def parse_primary([TStr(s) | rest]) := parse_postfix(Str(s), rest)
  def parse_primary([TChar(cp) | rest]) := parse_postfix(Char(cp), rest)
  def parse_primary([TOp(":"), TId(name) | rest]) := parse_postfix(Atom(name), rest)
  def parse_primary([TOp(":"), TStr(name) | rest]) := parse_postfix(Atom(name), rest)
  def parse_primary([TId(x) | rest]) := parse_postfix(Id(x), rest)
  def parse_primary([TLBrace | rest])
    case parse_tuple_expr(rest) do
      AP(es, rest2) -> parse_postfix(Tuple(es), rest2)
    end
  end
  def parse_primary([TMapOpen | rest])
    case parse_map_expr(skip_nl(rest)) do
      AP(es, rest2) -> parse_postfix(MapE(es), rest2)
    end
  end
  def parse_primary([TLBracket | rest]) := parse_list_expr(rest)
  def parse_primary([TKw("if") | rest]) := parse_if(rest)
  def parse_primary([TKw("case") | rest]) := parse_case(rest)
  def parse_primary([TKw("with") | rest]) := parse_with(rest)
  def parse_primary([TLP | rest])
    case parse_bp(0, rest) do
      P(e, [TRP | rest2]) -> parse_postfix(e, rest2)
      P(_, other) -> P(EErr, other)
    end
  end
  def parse_primary(ts) := P(EErr, ts)

  # `if COND do THEN else ELSE end` — each part is a full sub-expression. The
  # projection (decl_fixpoint) wraps THEN/ELSE in `{:block, [{:expr, …}]}` to match
  # Rian.Pratt's `{:if, c, {:block, …}, {:block, …}}`. Single-expression branches.
  # `if` branches may each begin on the next line (`do <nl> body <nl> else <nl> body
  # <nl> end`), the selfhost_decl idiom — skip newlines at every boundary so the
  # branch bodies (single expressions) parse and `else`/`end` are seen.
  def parse_if(ts Vec(Tok)) Parse
  def parse_if(ts)
    case parse_bp(0, ts) do
      P(cnd, [TKw("do") | r2]) -> parse_if_then(cnd, skip_nl(r2))
    end
  end

  def parse_if_then(cnd Expr, ts Vec(Tok)) Parse
  def parse_if_then(cnd, ts)
    case parse_bp(0, ts) do
      P(thn, rest) ->
        case skip_nl(rest) do
          [TKw("else") | r3] -> parse_if_else(cnd, thn, skip_nl(r3))
        end
    end
  end

  def parse_if_else(cnd Expr, thn Expr, ts Vec(Tok)) Parse
  def parse_if_else(cnd, thn, ts)
    case parse_bp(0, ts) do
      P(els, rest) ->
        case skip_nl(rest) do
          [TKw("end") | r4] -> parse_postfix(If(cnd, thn, els), r4)
        end
    end
  end

  # `case SCRUT do <nl> PAT [when G] -> BODY <nl> … end` — the scrutinee, then
  # newline-separated arms up to `end`. Each arm is a pattern, an optional `when`
  # guard, `->`, and a single-expression body (parse_bp stops at the next `<nl>`/
  # `end`/`->`). Projects to Rian.Pratt's `{:case, scrut, [{pat, guard|nil, body}]}`.
  def parse_case(ts Vec(Tok)) Parse
  def parse_case(ts)
    case parse_bp(0, ts) do
      P(scrut, [TKw("do") | r2]) ->
        case parse_arms(r2, []) do
          ARs(arms, r3) -> parse_postfix(Case(scrut, arms), r3)
        end
    end
  end

  def parse_arms(ts Vec(Tok), acc Vec(CaseArm)) ArmsRes
  def parse_arms([TNL | rest], acc) := parse_arms(rest, acc)
  def parse_arms([TKw("end") | rest], acc) := ARs(rev_arms(acc, []), rest)
  def parse_arms(ts, acc)
    case parse_arm(ts) do
      AR(arm, rest) -> parse_arms(rest, [arm | acc])
    end
  end

  def parse_arm(ts Vec(Tok)) ArmRes
  def parse_arm(ts)
    case parse_pat(ts) do
      PP(pat, [TKw("when") | r1]) ->
        case parse_bp(0, r1) do
          P(g, [TOp("->") | r2]) ->
            case parse_bp(0, skip_nl(r2)) do
              P(body, r3) -> AR(CArmG(pat, g, body), r3)
            end
        end
      PP(pat, [TOp("->") | r1]) ->
        case parse_bp(0, skip_nl(r1)) do
          P(body, r2) -> AR(CArm(pat, body), r2)
        end
    end
  end

  # `with C1 <- E1 [, C2 <- E2 …] do BODY [else ARMS] end` — parsed into a `With`
  # node carrying the clause list, body, and `else` arms (empty when absent). The
  # intent is kept here; the desugar to nested `case` happens at lowering (ADR-0039).
  def parse_with(ts Vec(Tok)) Parse
  def parse_with(ts)
    case parse_wclauses(ts, []) do
      WCs(clauses, [TKw("do") | r2]) ->
        case parse_bp(0, skip_nl(r2)) do
          P(body, r3) -> parse_with_else(clauses, body, skip_nl(r3))
        end
    end
  end

  # the `<-` clause list, comma-separated, up to `do`.
  def parse_wclauses(ts Vec(Tok), acc Vec(WithClause)) WClausesRes
  def parse_wclauses(ts, acc)
    case parse_pat(ts) do
      PP(pat, [TOp("<-") | r1]) ->
        case parse_bp(0, r1) do
          P(src, [TComma | r2]) -> parse_wclauses(skip_nl(r2), [WC(pat, src) | acc])
          P(src, rest) -> WCs(rev_wclauses([WC(pat, src) | acc], []), rest)
        end
    end
  end

  # `else ARMS end` -> the arms; a bare `end` -> no `else` (empty arms).
  def parse_with_else(cs Vec(WithClause), body Expr, ts Vec(Tok)) Parse
  def parse_with_else(cs, body, [TKw("else") | r4])
    case parse_arms(r4, []) do
      ARs(arms, r5) -> parse_postfix(With(cs, body, arms), r5)
    end
  end
  def parse_with_else(cs, body, [TKw("end") | r4]) := parse_postfix(With(cs, body, []), r4)

  def rev_wclauses(Vec(WithClause), Vec(WithClause)) Vec(WithClause)
  def rev_wclauses([], out) := out
  def rev_wclauses([c | rest], out) := rev_wclauses(rest, [c | out])

  # an arm body may begin on the next line (`PAT -> <nl> body`); skip the newline(s)
  # so `parse_bp` sees the body, not an empty expression.
  def skip_nl(ts Vec(Tok)) Vec(Tok)
  def skip_nl([TNL | rest]) := skip_nl(rest)
  def skip_nl(ts) := ts

  def rev_arms(Vec(CaseArm), Vec(CaseArm)) Vec(CaseArm)
  def rev_arms([], out) := out
  def rev_arms([a | rest], out) := rev_arms(rest, [a | out])

  # list construction as a nil/cons chain (mirrors parse_list_pat): `[x | acc]` ->
  # ConsE(x, acc); elements are full expressions.
  def parse_list_expr(ts Vec(Tok)) Parse
  def parse_list_expr([TRBracket | rest]) := P(NilE, rest)
  def parse_list_expr(ts)
    case parse_bp(0, ts) do
      P(h, [TComma | rest]) ->
        case parse_list_expr(rest) do
          P(t, r) -> P(ConsE(h, t), r)
        end
      P(h, [TOp("|") | rest]) ->
        case parse_bp(0, rest) do
          P(t, [TRBracket | r]) -> P(ConsE(h, t), r)
          P(t, other) -> P(ConsE(h, t), other)
        end
      P(h, [TRBracket | rest]) -> P(ConsE(h, NilE), rest)
      P(h, rest) -> P(ConsE(h, NilE), rest)
    end
  end

  # tuple construction: comma-separated expressions terminated by `}` (reuses the
  # `Args`/`AP` result type). `{:ok, m, bin}` -> Tuple([Atom("ok"), Id("m"), Id("bin")]).
  def parse_tuple_expr(ts Vec(Tok)) Args
  def parse_tuple_expr([TRBrace | rest]) := AP([], rest)
  def parse_tuple_expr(ts)
    case parse_bp(0, ts) do
      P(e, [TComma | rest]) ->
        case parse_tuple_expr(rest) do
          AP(more, r) -> AP([e | more], r)
        end
      P(e, [TRBrace | rest]) -> AP([e], rest)
      P(e, rest) -> AP([e], rest)
    end
  end

  # map literal body := ε | (Id ':' expr) (',' Id ':' expr)*  — each pair a `Label`,
  # so map fields reuse the labeled-construction machinery (expand/subst, lowering).
  def parse_map_expr(ts Vec(Tok)) Args
  def parse_map_expr([TRBrace | rest]) := AP([], rest)
  def parse_map_expr([TId(k), TOp(":") | rest])
    case parse_bp(0, rest) do
      P(v, [TComma | r2]) ->
        case parse_map_expr(skip_nl(r2)) do
          AP(more, r) -> AP([Label(k, v) | more], r)
        end
      P(v, [TRBrace | r2]) -> AP([Label(k, v)], r2)
      P(v, rest2) -> AP([Label(k, v)], rest2)
    end
  end

  # postfix := '.' field (field access) | '(' args ')' (call), repeated
  def parse_postfix(node Expr, ts Vec(Tok)) Parse
  def parse_postfix(node, [TOp("."), TId(field) | rest]) := parse_postfix(Dot(node, field), rest)
  def parse_postfix(node, [TLP | rest])
    case parse_args(rest) do
      AP(args, rest2) -> parse_postfix(Call(node, args), rest2)
    end
  end
  def parse_postfix(node, ts) := P(node, ts)

  # args := ε | arg (',' arg)*  where arg := Id ':' expr (labeled) | expr
  def parse_args(ts Vec(Tok)) Args
  def parse_args([TRP | rest]) := AP([], rest)
  def parse_args([TId(name), TOp(":") | rest])
    case parse_bp(0, rest) do
      P(v, after) -> finish_arg(Label(name, v), after)
    end
  end
  def parse_args(ts)
    case parse_bp(0, ts) do
      P(a, rest) -> finish_arg(a, rest)
    end
  end

  def finish_arg(a Expr, ts Vec(Tok)) Args
  def finish_arg(a, [TComma | rest])
    case parse_args(rest) do
      AP(more, rest2) -> AP([a | more], rest2)
    end
  end
  def finish_arg(a, [TRP | rest]) := AP([a], rest)
  def finish_arg(a, ts) := AP([a], ts)

  # ── binding powers (mirror Rian.Pratt.bp) ────────────────────────────────
  def lbp(op String) Int53 := bp_base(level(op)) + left_off(op)
  def rbp(op String) Int53 := bp_base(level(op)) + right_off(op)
  def bp_base(lvl Int53) Int53 := (13 - lvl) * 10

  def left_off(op String) Int53
  def left_off("<>") := 1
  def left_off(op) := 0

  def right_off(op String) Int53
  def right_off("<>") := 0
  def right_off(op) := 1

  def level(op String) Int53
  def level("*") := 3
  def level("/") := 3
  def level("rem") := 3
  def level("div") := 3
  def level("+") := 4
  def level("-") := 4
  def level("<>") := 5
  def level("<") := 8
  def level("<=") := 8
  def level(">") := 8
  def level(">=") := 8
  def level("==") := 9
  def level("!=") := 9
  def level("and") := 10
  def level("or") := 11
  def level(other) := 100

  # ── small helpers ─────────────────────────────────────────────────────────
  def is_upper(s String) Bool := upper_first(Prim.str_chars(s))

  def upper_first(cs Vec(Char)) Bool
  def upper_first([c | _]) := c >= 'A' and c <= 'Z'
  def upper_first([]) := false

  def str_to_int(s String) Int53 := digits(Prim.str_chars(s), 0)

  def digits(cs Vec(Char), acc Int53) Int53
  def digits([], acc) := acc
  def digits([c | rest], acc) := digits(rest, acc * 10 + c - '0')

  def rev_tok(xs Vec(Tok), acc Vec(Tok)) Vec(Tok)
  def rev_tok([], acc) := acc
  def rev_tok([x | xs], acc) := rev_tok(xs, [x | acc])
end
