# ===========================================================================
# 13 — Protocols & impls: bounded, opted-in, totality-safe (ADR-0042 part 2)
# ===========================================================================
# Character: a `protocol` names method *signatures*; an `impl P for T` supplies
# them for one concrete type. Dispatch is on the FIRST argument (the Elixir-
# protocol convention) and **static where the type is known** — on the BEAM the
# dispatcher is a guarded `def`, selecting the impl by the receiver's runtime
# type. Protocols add NO case-arms and touch NO exhaustiveness (ADR-0042 §6):
# dispatch is a separate mechanism from `case`.
#
# Coherence (the Rust orphan rule, ADR-0042 §5): exactly one impl per
# (protocol, type) — duplicate impls, method-set mismatches, and two impl types
# sharing a runtime guard are all rejected at compile time.
#
# Impls dispatch over PRIMITIVE types (Int64 / Bool / String / Float64 / Char),
# SUM types (by constructor tag), and STRUCTS (by `:__struct__`). The generic
# `forall T: Bound` call path and the Rust/JS lowerings are deferred (BEAM-first).
#
# ADRs: 0042 (protocols/generics) · 0035 (no hidden control flow) · 0033 (vocab)
# ---------------------------------------------------------------------------

# `Show` — a one-method protocol; `Self` is the implementing type.
protocol Show do
  def show(self Self) String
end

# Each impl supplies the body for one type. The parameter types come from the
# protocol signature (`Self` -> the impl type), so the impl writes just names.
impl Show for Bool do
  def show(b) := if b do "true" else "false" end
end

impl Show for Int64 do
  def show(n) := "an integer"
end

impl Show for String do
  def show(s) := s
end

# A two-argument protocol dispatches on its first argument.
protocol Eq do
  def eq(a Self, b Self) Bool
end

impl Eq for Int64 do
  def eq(a, b) := a == b
end

impl Eq for Bool do
  def eq(a, b) := a == b
end

# A BOUNDED generic (ADR-0042 §2): `forall T: Eq` means "T has an `Eq` impl". The
# compiler ENFORCES it at the call site — `members(xs, x)` below type-checks only
# because `Int64` has `impl Eq`. Calling it with a type that lacks `Eq` is a
# compile error (`requires T: Eq, but … has no impl Eq for …`). Bounds add no
# case-arms and touch no exhaustiveness (ADR-0042 §6).
def equal3(a T, b T, c T) Bool forall T: Eq := eq(a, b) and eq(b, c)

# `equal3(1, 1, 1)` type-checks (Int64: Eq) and runs to `true`.
def all_one() Bool := equal3(1, 1, 1)

# Dispatch also works over a SUM type — by the runtime constructor tag. This is
# the shape the compiler's own data takes (`Token`, `Expr`), so a real `Show`
# can be written over it.
type Expr := Num(n Int64) | Add(a Int64, b Int64) | Zero

impl Show for Expr do
  def show(e)
    case e do
      Num(n) -> "num"
      Add(a, b) -> "add"
      Zero -> "zero"
    end
  end
end

# `show(true)` -> "true" · `show(42)` -> "an integer" · `eq(3, 3)` -> true ·
# `show(Num(5))` -> "num" · `show(Zero)` -> "zero". One BEAM module; the `show`
# dispatcher now selects Bool / Int64 / String / Expr by runtime shape.
