# ===========================================================================
# SELF-HOSTING SPIKE — a Rian lexer, written in Rian
# ===========================================================================
# Goal (ADR-0027/0031): tokenize a small arithmetic grammar entirely in Rian,
# typing its OWN data (the `Token` sum), recursing over a list with `[h | t]`
# patterns, and running on the BEAM. Evidence for SELFHOST.md, not a demo.
#
# Char literals (ADR-0036): clauses match `'+'`/`'('`/`'0'` directly — `Char` is
# a distinct type, lowered native per target (codepoint integer on BEAM, BigInt
# in JS, native `char` on Rust). Ordinal comparisons (`==`/`>=`/`<=`) work on
# every target; codepoint arithmetic is an explicit `Prim.char_code(c) : Int64`
# (no hidden widening). (Former B2 crutch removed.)
#
# `String -> Vec(Char)` goes through the **portable prelude primitive**
# `Prim.str_chars` (ADR-0047 §2 — `Prim` is the target-internal namespace),
# not host FFI — so the lexer source carries no BEAM-only call and lowers to
# every backend through the same machinery.
# ---------------------------------------------------------------------------

mod SelfhostLexer do
  # The lexer's own typed token stream — a sealed sum (ADR-0034).
  type Token := TNum(Int64) | TPlus | TMinus | TStar | TSlash | TLParen | TRParen

  pub def tokenize(src String) Vec(Token) := lex(Prim.str_chars(src))

  # Recurse over the `Char` list. Specific char clauses first; the final
  # `[_ | rest]` makes the match total (unknown chars are skipped). Char
  # comparisons (`==`, `>=`, `<=`) are ordinal and work on every target.
  def lex(cs Vec(Char)) Vec(Token)
  def lex([]) := []
  def lex([c | rest]) when c == ' ' := lex(rest)
  def lex(['+' | rest]) := [TPlus | lex(rest)]
  def lex(['-' | rest]) := [TMinus | lex(rest)]
  def lex(['*' | rest]) := [TStar | lex(rest)]
  def lex(['/' | rest]) := [TSlash | lex(rest)]
  def lex(['(' | rest]) := [TLParen | lex(rest)]
  def lex([')' | rest]) := [TRParen | lex(rest)]
  def lex([c | rest]) when c >= '0' and c <= '9' := lex_num([c | rest], 0)
  def lex([_ | rest]) := lex(rest)

  # Accumulate a run of digits into one `TNum`, then resume lexing the rest.
  # `Prim.char_code(c) : Int64` is the explicit `Char` → codepoint conversion
  # (ADR-0036 — arithmetic widens to the base, no hidden coercion).
  def lex_num(cs Vec(Char), acc Int64) Vec(Token)
  def lex_num([c | rest], acc) when c >= '0' and c <= '9' := lex_num(rest, acc * 10 + Prim.char_code(c) - Prim.char_code('0'))
  def lex_num(cs, acc) := [TNum(acc) | lex(cs)]
end
