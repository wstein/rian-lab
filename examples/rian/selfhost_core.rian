# ===========================================================================
# SELF-HOSTING SPIKE — the surface→Core lowering (FULL), written in Rian
# ===========================================================================
# Goal (ADR-0063 §2, the stage after the parser; ADR-0050): translate the whole
# `Rian.Pratt` surface expression/pattern AST into the typed **Core IR** — the
# Rian-written counterpart of `Rian.Core.from_expr`/`from_pat`, fixpoint-locked
# against them in `test/rian/core_fixpoint_test.exs`.
#
# Coverage is the FULL surface front-door: every node `Rian.Pratt` produces —
# literals, identifiers, atoms, unary/binary, calls (incl. labelled args), dot,
# `if`, tuples, lists (with tails), maps, blocks (`:=`/typed binds/exprs), `case`
# (with guards), lambdas, captures (`&(…)`/`&f/n`), `with`; and every pattern —
# wild/var/lit/char/atom/tuple/ctor/list/as/pin/struct/map. The Lower-internal
# resolved nodes (`variant_lit`/`struct_lit`/`const_ref`) and the decl-resolved
# `str_interp` / Rust-baked `rpat` are not surface, so they are out of scope.
#
# Each node is rendered to a canonical s-expression string; the fixpoint test
# renders the reference `Rian.Core` struct to the same string and diffs.
# ---------------------------------------------------------------------------

mod SelfhostCore do
  # ── surface expression AST (mirrors Rian.Pratt tuples) ──
  type Surface := SNum(String)
                | SStr(String)
                | SChar(Int53)
                | SId(String)
                | SAtom(String)
                | SUnary(String, Surface)
                | SBin(String, Surface, Surface)
                | SCall(Surface, Vec(Surface))
                | SLabel(String, Surface)
                | SDot(Surface, String)
                | SIf(Surface, Surface, Surface)
                | STuple(Vec(Surface))
                | SList(Vec(Surface), STail)
                | SMap(Vec(SPair))
                | SBlock(Vec(SStmt))
                | SCase(Surface, Vec(SArm))
                | SLambda(Vec(SParam), Surface)
                | SCapArg(Int53)
                | SCapture(Surface)
                | SCaptureNamed(Surface, Int53)
                | SWith(Vec(SClause), Surface, Vec(SArm))

  type STail := TClose | TTail(Surface)
  type SPair := SP(String, Surface)
  type SStmt := SBind(String, Surface) | STypedBind(String, String, Surface) | SExpr(Surface)
  type SGuard := GNone | GSome(Surface)
  type SArm := SArm(SPat, SGuard, Surface)
  type SClause := SClause(SPat, Surface)
  type SParamTy := PtNone | PtSome(String)
  type SParam := SParam(String, SParamTy)

  # ── surface pattern AST (mirrors Rian.Pratt patterns) ──
  # `as`/pin patterns are not produced by the shared pattern parser, and `rpat` is
  # a Lower-internal Rust artifact — so they are not surface-reachable.
  type SPat := PWild
             | PVar(String)
             | PLitInt(Int53)
             | PLitStr(String)
             | PPChar(Int53)
             | PPAtom(String)
             | PPTuple(Vec(SPat))
             | PCtor(String, Vec(SPat))
             | PPList(Vec(SPat), PTail)
             | PPStruct(String, Vec(PPair))
             | PPMap(Vec(PPair))

  type PTail := PtlClose | PtlTail(SPat)
  type PPair := PPr(String, SPat)

  # ── expression → canonical s-expression ──
  pub def emit(Surface) String
  pub def emit(SNum(t)) := "(num " <> t <> ")"
  pub def emit(SStr(s)) := "(str " <> s <> ")"
  pub def emit(SChar(c)) := "(char " <> Prim.int_to_string(c) <> ")"
  pub def emit(SId(n)) := "(id " <> n <> ")"
  pub def emit(SAtom(a)) := "(atom " <> a <> ")"
  pub def emit(SUnary(op, x)) := "(unary " <> op <> " " <> emit(x) <> ")"
  pub def emit(SBin(op, l, r)) := "(bin " <> op <> " " <> emit(l) <> " " <> emit(r) <> ")"
  pub def emit(SCall(f, args)) := "(call " <> emit(f) <> " [" <> emit_list(args) <> "])"
  pub def emit(SLabel(n, e)) := "(label " <> n <> " " <> emit(e) <> ")"
  pub def emit(SDot(h, n)) := "(dot " <> emit(h) <> " " <> n <> ")"
  pub def emit(SIf(c, t, e)) := "(if " <> emit(c) <> " " <> emit(t) <> " " <> emit(e) <> ")"
  pub def emit(STuple(es)) := "(tuple [" <> emit_list(es) <> "])"
  pub def emit(SList(es, tl)) := "(list [" <> emit_list(es) <> "] " <> emit_tail(tl) <> ")"
  pub def emit(SMap(ps)) := "(map [" <> emit_pairs(ps) <> "])"
  pub def emit(SBlock(ss)) := "(block [" <> emit_stmts(ss) <> "])"
  pub def emit(SCase(s, arms)) := "(case " <> emit(s) <> " [" <> emit_arms(arms) <> "])"
  pub def emit(SLambda(ps, b)) := "(lambda [" <> emit_params(ps) <> "] " <> emit(b) <> ")"
  pub def emit(SCapArg(n)) := "(cap_arg " <> Prim.int_to_string(n) <> ")"
  pub def emit(SCapture(b)) := "(capture " <> emit(b) <> ")"
  pub def emit(SCaptureNamed(p, a)) := "(capture_named " <> emit(p) <> " " <> Prim.int_to_string(a) <> ")"
  pub def emit(SWith(cs, b, els)) :=
    "(with [" <> emit_clauses(cs) <> "] " <> emit(b) <> " [" <> emit_arms(els) <> "])"

  def emit_list(Vec(Surface)) String
  def emit_list([]) := ""
  def emit_list([x]) := emit(x)
  def emit_list([x | rest]) := emit(x) <> " " <> emit_list(rest)

  def emit_tail(STail) String
  def emit_tail(TClose) := "close"
  def emit_tail(TTail(e)) := "(tail " <> emit(e) <> ")"

  def emit_pairs(Vec(SPair)) String
  def emit_pairs([]) := ""
  def emit_pairs([SP(k, v)]) := "(" <> k <> " " <> emit(v) <> ")"
  def emit_pairs([SP(k, v) | rest]) := "(" <> k <> " " <> emit(v) <> ") " <> emit_pairs(rest)

  def emit_stmts(Vec(SStmt)) String
  def emit_stmts([]) := ""
  def emit_stmts([s]) := emit_stmt(s)
  def emit_stmts([s | rest]) := emit_stmt(s) <> " " <> emit_stmts(rest)

  def emit_stmt(SStmt) String
  def emit_stmt(SBind(n, e)) := "(bind " <> n <> " " <> emit(e) <> ")"
  def emit_stmt(STypedBind(n, t, e)) := "(typed_bind " <> n <> " " <> t <> " " <> emit(e) <> ")"
  def emit_stmt(SExpr(e)) := "(expr " <> emit(e) <> ")"

  def emit_arms(Vec(SArm)) String
  def emit_arms([]) := ""
  def emit_arms([a]) := emit_arm(a)
  def emit_arms([a | rest]) := emit_arm(a) <> " " <> emit_arms(rest)

  def emit_arm(SArm) String
  def emit_arm(SArm(p, g, b)) := "(arm " <> emit_pat(p) <> " " <> emit_guard(g) <> " " <> emit(b) <> ")"

  def emit_guard(SGuard) String
  def emit_guard(GNone) := "nil"
  def emit_guard(GSome(e)) := emit(e)

  def emit_clauses(Vec(SClause)) String
  def emit_clauses([]) := ""
  def emit_clauses([c]) := emit_clause(c)
  def emit_clauses([c | rest]) := emit_clause(c) <> " " <> emit_clauses(rest)

  def emit_clause(SClause) String
  def emit_clause(SClause(p, e)) := "(clause " <> emit_pat(p) <> " " <> emit(e) <> ")"

  def emit_params(Vec(SParam)) String
  def emit_params([]) := ""
  def emit_params([p]) := emit_param(p)
  def emit_params([p | rest]) := emit_param(p) <> " " <> emit_params(rest)

  def emit_param(SParam) String
  def emit_param(SParam(n, PtNone)) := "(" <> n <> ")"
  def emit_param(SParam(n, PtSome(t))) := "(" <> n <> " " <> t <> ")"

  # ── pattern → canonical s-expression ──
  pub def emit_pat(SPat) String
  pub def emit_pat(PWild) := "(pwild)"
  pub def emit_pat(PVar(n)) := "(pvar " <> n <> ")"
  pub def emit_pat(PLitInt(v)) := "(plit_int " <> Prim.int_to_string(v) <> ")"
  pub def emit_pat(PLitStr(v)) := "(plit_str " <> v <> ")"
  pub def emit_pat(PPChar(c)) := "(pchar " <> Prim.int_to_string(c) <> ")"
  pub def emit_pat(PPAtom(a)) := "(patom " <> a <> ")"
  pub def emit_pat(PPTuple(ps)) := "(ptuple [" <> emit_pat_list(ps) <> "])"
  pub def emit_pat(PCtor(c, args)) := "(pctor " <> c <> " [" <> emit_pat_list(args) <> "])"
  pub def emit_pat(PPList(ps, tl)) := "(plist [" <> emit_pat_list(ps) <> "] " <> emit_ptail(tl) <> ")"
  pub def emit_pat(PPStruct(n, fs)) := "(pstruct " <> n <> " [" <> emit_ppairs(fs) <> "])"
  pub def emit_pat(PPMap(fs)) := "(pmap [" <> emit_ppairs(fs) <> "])"

  def emit_pat_list(Vec(SPat)) String
  def emit_pat_list([]) := ""
  def emit_pat_list([p]) := emit_pat(p)
  def emit_pat_list([p | rest]) := emit_pat(p) <> " " <> emit_pat_list(rest)

  def emit_ptail(PTail) String
  def emit_ptail(PtlClose) := "close"
  def emit_ptail(PtlTail(p)) := "(tail " <> emit_pat(p) <> ")"

  def emit_ppairs(Vec(PPair)) String
  def emit_ppairs([]) := ""
  def emit_ppairs([PPr(k, p)]) := "(" <> k <> " " <> emit_pat(p) <> ")"
  def emit_ppairs([PPr(k, p) | rest]) := "(" <> k <> " " <> emit_pat(p) <> ") " <> emit_ppairs(rest)
end
