# ===========================================================================
# 10 — Function forms: every way to write a function body
# ===========================================================================
# Character: a `def` body is one of two things, and the choice is purely about
# size — there is no semantic difference, both yield a value (implicit return):
#
#   1.  := expr                      single-expression body  (the one-liner)
#   2.  <newline> stmts.. expr end   BLOCK body               (multiline)
#
# Lambdas `(x) -> e` are the third, anonymous form. Both single-clause and
# multi-clause functions may use EITHER body form, and a multi-clause group
# may MIX them clause by clause.
#
# Spec: docs/spec/clauses-guards.md §1-2 · docs/spec/expressions.md §1
# ---------------------------------------------------------------------------

# --- (1) single-expression body: `:= expr` --------------------------------
# Best when the whole function is one expression. This is the form `show`
# uses in the capstone.
def double(n Int53) Int53 := n * 2

# --- (2) block body: multiline, implicit return ---------------------------
# Opens after the return type, closes with `end`. Statements are `:=`
# bindings (single-assignment); the LAST expression is the returned value.
# There is no `return` keyword — the final expression is the value.
def norm(v val Vec(Float64)) Float64
  total := v |> sum            # binding
  n     := len(v)             # binding
  total / n                   # final expression = the function's value
end

# A block body can contain `if`/`case` expressions, more bindings, and
# (capability permitting) local mutation with `<~`. Here a running total is
# threaded through bindings — shadowing, the immutable default.
def stats(xs val Vec(Int53)) Int53
  s := :lists.sum(xs)
  n := len(xs)
  if n == 0 do 0 else s div n end   # the `if` expression is the value
end

# --- multi-clause group MIXING both body forms ----------------------------
# A bodiless signature line, then contiguous pattern clauses. Some clauses are
# one-liners; the recursive arm uses a block body to introduce a local binding.
type Tree(T) := Leaf | Node(left Tree(T), value T, right Tree(T))

def depth(Tree(T)) Int53
def depth(Leaf) := 0                 # (1) one-liner clause
def depth(Node(l, _, r))             # (2) block-body clause
  dl := depth(l)
  dr := depth(r)
  1 + max2(dl, dr)
end

def max2(Int53, Int53) Int53
def max2(a, b) when a >= b := a
def max2(a, b)             := b

# --- (3) lambdas / closures: `(x) -> e` -----------------------------------
# Anonymous, single-expression. Passed to higher-order functions (usually via
# FFI). For multi-step logic inside a lambda, the body can be a block
# EXPRESSION (`if .. do a := ..; .. else .. end` — a lambda body is value
# position, so the `if` needs `else`), or factor it into a named `def`.
def map_double(xs val Vec(Int53)) Vec(Int53) := Enum.map(xs, (x) -> x * 2)
def clamp_each(xs val Vec(Int53)) Vec(Int53) :=
  Enum.map(xs, (x) -> if x < 0 do 0 else x end)   # block-expression lambda body

# --- the same `show`, written with block-body clauses ---------------------
# Purely a style choice vs. the capstone's one-liners — identical meaning.
def show2(e val Expr) String
def show2(Lit(n)) := Integer.to_string(n)
def show2(Add(a, b))                  # block body: name the parts, then join
  ls := show2(a)
  rs := show2(b)
  "(" <> ls <> " + " <> rs <> ")"
end

# --- (4) functions as VALUES: the `Fn(…)` type (ADR-0042) -----------------
# A function value has a type, written `Fn(Arg1, …, ArgN, Ret)` — the argument
# types followed by the return type. THE LAST ELEMENT IS ALWAYS THE RETURN.
#
#   Fn(Int53, Bool)            a one-arg fn: takes Int53, returns Bool
#   Fn(Int53, Int53, Int53)    a two-arg fn: (Int53, Int53) -> Int53
#   Fn(Bool)                   a NULLARY fn: () -> Bool  (just the return)
#
# This is the type you give a parameter that receives a lambda `(x) -> e` or a
# capture `&name/arity`. Applying such a parameter (`f(x)`) yields its return
# type, so the checker types higher-order code instead of giving up.

# A higher-order function: `f` is itself a function. Applying it twice is typed
# end to end — `f(x)` is Int53, so `f(f(x))` is Int53, matching the return.
def apply_twice(f Fn(Int53, Int53), x Int53) Int53 := f(f(x))

# The canonical generic `map`: `f` maps each `T` to a `U`, `xs` is a `Vec(T)`,
# the result is a `Vec(U)`. `forall T, U` binds the type variables (ADR-0042).
def map(f Fn(T, U), xs Vec(T)) Vec(U) forall T, U
def map(_, [])      := []
def map(f, [h | t]) := [f(h) | map(f, t)]

# A function may RETURN a function (a closure over its parameters). The declared
# return type is an `Fn(…)`; the lambda body is checked against it.
def adder(n Int53) Fn(Int53, Int53) := (x) -> x + n

# Both a lambda literal and a named-function capture are values of an `Fn(…)`
# type, so either can be passed where an `Fn(…)` parameter is expected.
def doubled(xs val Vec(Int53)) Vec(Int53) := map((x) -> x * 2, xs)
def doubled_cap(xs val Vec(Int53)) Vec(Int53) := map(&double/1, xs)
