# ===========================================================================
# SELF-HOSTING — porting Rian.Pratt to Rian, fixpoint-locked (rung 2)
# ===========================================================================
# The earlier spike (selfhost_parser.rian) parsed arithmetic into its OWN `Expr`
# sum and only *ran*. This rung makes the port a **checked equivalence**: the
# parser's output is diffed against the reference `Rian.Pratt.parse` over a
# corpus (test/rian/parse_fixpoint_test.exs) — the same method as the lexer
# fixpoint, AST projection instead of token projection.
#
# The trick that makes the diff exact: the AST constructors are named so their
# BEAM lowering IS `Rian.Pratt`'s surface-tuple shape —
#     Num(s)       -> {:num, s}
#     Id(s)        -> {:id, s}
#     Bin(op,l,r)  -> {:bin, op, l, r}
# so `parse(tokens)` term-EQUALS `Rian.Pratt.parse(source)` with no projection.
# `EErr` keeps every clause total (the reference raises on a parse error instead;
# the corpus is well-formed, so `EErr` never appears in a checked run).
#
# Slice: precedence climbing over `+ - * /` (multiplicative tighter than additive,
# both left-associative — Rian.Pratt's levels for these ops), identifiers, integer
# literals, and parentheses. Calls / comparisons / pipes are later slices.
#
#   add  := mul (('+' | '-') mul)*
#   mul  := atom (('*' | '/') atom)*
#   atom := Num | Id | '(' add ')'
# ---------------------------------------------------------------------------

mod SelfhostParse do
  # The token stream this parser consumes — the reference `Rian.Lexer` tokens,
  # injected into this sum by the test (`{:num,s}` -> `TNum(s)`, `{:op,o}` ->
  # `TOp(o)`, `{:lparen}` -> `TLP`, …). `TOp` carries the operator string, so the
  # parser branches on `TOp("+")` etc.
  type Tok := TNum(String) | TId(String) | TOp(String) | TLP | TRP

  # Output AST — constructor names chosen so the lowered term matches Rian.Pratt.
  type Expr := Num(String) | Id(String) | Bin(String, Expr, Expr) | EErr

  # One parse step: the node built so far + the unconsumed tokens (a pair without
  # tuple types — a single-constructor sum).
  type Parse := P(Expr, Vec(Tok))

  pub def parse(ts Vec(Tok)) Expr
  pub def parse(ts)
    case parse_add(ts) do
      P(e, _) -> e
    end
  end

  # add := mul (('+' | '-') mul)*  — fold additive operators left to right.
  def parse_add(ts Vec(Tok)) Parse
  def parse_add(ts)
    case parse_mul(ts) do
      P(left, rest) -> parse_add_tail(left, rest)
    end
  end

  def parse_add_tail(left Expr, ts Vec(Tok)) Parse
  def parse_add_tail(left, [TOp("+") | rest])
    case parse_mul(rest) do
      P(right, rest2) -> parse_add_tail(Bin("+", left, right), rest2)
    end
  end
  def parse_add_tail(left, [TOp("-") | rest])
    case parse_mul(rest) do
      P(right, rest2) -> parse_add_tail(Bin("-", left, right), rest2)
    end
  end
  def parse_add_tail(left, ts) := P(left, ts)

  # mul := atom (('*' | '/') atom)*  — fold multiplicative operators.
  def parse_mul(ts Vec(Tok)) Parse
  def parse_mul(ts)
    case parse_atom(ts) do
      P(left, rest) -> parse_mul_tail(left, rest)
    end
  end

  def parse_mul_tail(left Expr, ts Vec(Tok)) Parse
  def parse_mul_tail(left, [TOp("*") | rest])
    case parse_atom(rest) do
      P(right, rest2) -> parse_mul_tail(Bin("*", left, right), rest2)
    end
  end
  def parse_mul_tail(left, [TOp("/") | rest])
    case parse_atom(rest) do
      P(right, rest2) -> parse_mul_tail(Bin("/", left, right), rest2)
    end
  end
  def parse_mul_tail(left, ts) := P(left, ts)

  # atom := Num | Id | '(' add ')'  — a literal, a variable, or a parenthesized
  # subexpression; anything else (or a missing `)`) is a total `EErr`.
  def parse_atom(ts Vec(Tok)) Parse
  def parse_atom([TNum(n) | rest]) := P(Num(n), rest)
  def parse_atom([TId(x) | rest]) := P(Id(x), rest)
  def parse_atom([TLP | rest])
    case parse_add(rest) do
      P(e, [TRP | rest2]) -> P(e, rest2)
      P(_, other) -> P(EErr, other)
    end
  end
  def parse_atom(ts) := P(EErr, ts)
end
