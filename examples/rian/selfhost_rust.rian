# ===========================================================================
# SELF-HOSTING — the Rust text backend (whole module), written in Rian
# ===========================================================================
# Goal (ADR-0063 §2 backend rung; ADR-0049/0055/0061): emit a whole Rust module
# from the IR — the Rian-written counterpart of `Rian.Lower.rust_program`'s
# emission, fixpoint-locked against it in `test/rian/rust_module_fixpoint_test.exs`.
#
# Rust dispatches multi-clause functions with a `match` over the tuple of params;
# sum types become `enum`s. The emitter is precedence-aware (the reference's
# `emit/2 -> {string, prec}` + `p/3`). The stage consumes Core that is already
# RESOLVED (variant construction -> `Enum::Ctor`, ctor patterns carry their enum)
# and capability-LOWERED (params carry their Rust type) — resolution is the
# parser/Core stage's job and capability lowering is the (self-hosted) capability
# stage's. Structs (decl/construction/field access) and closed + cons lists are
# now covered, as are generic `<T: Clone>` signatures + a bare-tvar return clone
# (`-> T` clones the borrowed body) and list PATTERNS (`[h | t]` -> the slice
# rest-pattern `[h, t @ ..]`) with the slice-element clone rebind (a used head
# binder is `let h = h.clone();`-rebound to an owned value). The non-generic
# call-site owned→borrow coercion is also in: an owned `vec![…]` argument passed to
# a `&`-typed parameter is `&`-wrapped (`takes(&vec![1, 2])`, via `borrow_prog`). The
# REST of the owned↔borrow coercion — the generic `borrowed`-set branch (clone-or-`&`
# over a clause's `&`-bound vars), owned-`String`/owned-returning-call arg producers,
# and mid-body clones of borrowed values in list elements — and parametric-type
# monomorphization (`Vec(Pair)` -> `Vec<Pair<K, V>>`, see `render_inst` below), plus
# maps, String-return coercion, the Elixir text target, and struct *patterns* (a
# reference gap — `Rian.Lower` raises) remain out of scope.
# ---------------------------------------------------------------------------

mod SelfhostRust do
  type Core := CNum(String)
             | CStr(String)
             | CId(String)
             | CUnary(String, Core)
             | CBin(String, Core, Core)
             | CCall(String, Vec(Core))
             | CIf(Core, Core, Core)
             | CTuple(Vec(Core))
             | COk(Core)
             | CErr(Core)
             | CVariant(String, String, Bool, Vec(VPair))
             | CStruct(String, Vec(VPair))
             | CDot(Core, String)
             | CList(Vec(Core), LTail)

  type VPair := VP(String, Core)
  # a list is closed (`[…]` -> `vec![…]`) or has a cons tail (`[e | t]` -> a block
  # that `to_vec()`s the tail and prepends).
  type LTail := LClose | LCons(Core)
  # a `struct` declaration: name + (label, Rust-type) fields (reuses `Param`).
  type StructDef := StructDef(String, Vec(Param))

  # resolved patterns (ctor patterns carry their enum/ctor/named + labels).
  type RPat := RWild
             | RVar(String)
             | RInt(Int53)
             | RStr(String)
             | RCtorP(String, String, Bool, Vec(String), Vec(RPat))
             | RTupleP(Vec(RPat))
             | ROkP(RPat)
             | RErrP(RPat)
             | RListP(Vec(RPat), LPTail)

  # the tail of a list pattern: `[]`/`[a, b]` is LpClose; `[h | t]` is LpVar("t");
  # `[h | _]` is LpWild (the binder is dropped). A non-empty tail becomes the Rust
  # slice rest-pattern `t @ ..` / `..`.
  type LPTail := LpClose | LpVar(String) | LpWild

  type Guard := GNone | GSome(Core)
  type Param := Param(String, String)
  type Clause := Clause(Vec(RPat), Guard, Core)
  # a function carries its `forall` type variables (names); a bare-tvar return
  # (`-> T`) clones the borrowed arm body (`T: Clone`, ADR-0061).
  type Func := Func(String, Bool, Vec(String), Vec(Param), String, Vec(Clause))
  type EVar := EVar(String, Vec(String), Bool, Vec(String))
  type EnumDef := EnumDef(String, Vec(EVar))

  struct Em(s String, pr Int53)

  # `Rian.Lower.rust_program` emits structs, then enums, then functions.
  pub def compile_prog(structs Vec(StructDef), enums Vec(EnumDef), funcs Vec(Func)) String :=
    join_nn(join_nn(struct_decls(structs), enum_decls(enums)), fn_decls(borrow_prog(funcs)))

  # ── struct decl ──
  def struct_decls(Vec(StructDef)) String
  def struct_decls([]) := ""
  def struct_decls([s]) := struct_decl(s)
  def struct_decls([s | rest]) := struct_decl(s) <> "\n\n" <> struct_decls(rest)

  def struct_decl(StructDef) String
  def struct_decl(StructDef(name, fields)) :=
    "#[derive(Clone, Debug, PartialEq)]\nstruct " <> name <> " { " <> param_decls(fields) <> " }"

  def join_nn(String, String) String
  def join_nn("", b) := b
  def join_nn(a, "") := a
  def join_nn(a, b) := a <> "\n\n" <> b

  # ── sum type -> enum ──
  def enum_decls(Vec(EnumDef)) String
  def enum_decls([]) := ""
  def enum_decls([e]) := enum_decl(e)
  def enum_decls([e | rest]) := enum_decl(e) <> "\n\n" <> enum_decls(rest)

  def enum_decl(EnumDef) String
  def enum_decl(EnumDef(name, variants)) :=
    "#[derive(Clone, Debug, PartialEq)]\nenum " <> name <> " {\n" <> variant_lines(variants) <> "}"

  def variant_lines(Vec(EVar)) String
  def variant_lines([]) := ""
  def variant_lines([v | rest]) := "    " <> variant_decl(v) <> ",\n" <> variant_lines(rest)

  # `true`/`false` are variable patterns in a clause head, so dispatch on `named`
  # with `if`, not literal clauses.
  def variant_decl(EVar) String
  def variant_decl(EVar(ctor, [], _, _)) := ctor
  def variant_decl(EVar(ctor, types, named, labels))
    if named do
      ctor <> " { " <> named_fields(labels, types) <> " }"
    else
      ctor <> "(" <> comma_join(types) <> ")"
    end
  end

  def named_fields(Vec(String), Vec(String)) String
  def named_fields([], _) := ""
  def named_fields([l], [t]) := l <> ": " <> t
  def named_fields([l | ls], [t | ts]) := l <> ": " <> t <> ", " <> named_fields(ls, ts)

  def comma_join(Vec(String)) String
  def comma_join([]) := ""
  def comma_join([s]) := s
  def comma_join([s | rest]) := s <> ", " <> comma_join(rest)

  # ── functions / match dispatch ──
  def fn_decls(Vec(Func)) String
  def fn_decls([]) := ""
  def fn_decls([f]) := function_rs(f)
  def fn_decls([f | rest]) := function_rs(f) <> "\n\n" <> fn_decls(rest)

  # OWNED→BORROW coercion at call sites (`Rian.Lower.insert_borrows`, the non-generic
  # `borrowed = nil` branch): an owned-producing argument (here a list literal →
  # `vec![…]`) passed to a `&`-typed parameter is `&`-wrapped (`takes(&vec![1, 2])`).
  # This is a Core→Core pre-pass keyed on the CALLEE's lowered parameter types, so it
  # needs every function's signature — `borrow_prog` threads the whole `Vec(Func)` as
  # the lookup. GENERIC functions are skipped: the reference takes the `borrowed`-SET
  # branch there (clone-or-`&` over the clause's `&`-bound vars), which is not yet
  # ported, so leaving generic bodies untouched keeps the port honest rather than
  # half-coercing them. The owned-`String`/owned-returning-call producers and scalar
  # literals are likewise deferred (this slice coerces list literals only).
  def borrow_prog(Vec(Func)) Vec(Func)
  def borrow_prog(funcs) := borrow_each(funcs, funcs)

  def borrow_each(Vec(Func), Vec(Func)) Vec(Func)
  def borrow_each([], _) := []
  def borrow_each([f | rest], all) := [borrow_func(f, all) | borrow_each(rest, all)]

  def borrow_func(Func, Vec(Func)) Func
  def borrow_func(Func(n, p, [], params, ret, clauses), all) :=
    Func(n, p, [], params, ret, borrow_clauses(clauses, all))
  def borrow_func(Func(n, p, tvars, params, ret, clauses), _) :=
    Func(n, p, tvars, params, ret, clauses)

  def borrow_clauses(Vec(Clause), Vec(Func)) Vec(Clause)
  def borrow_clauses([], _) := []
  def borrow_clauses([Clause(pats, g, body) | rest], all) :=
    [Clause(pats, g, borrow_core(body, all)) | borrow_clauses(rest, all)]

  # rewrite calls anywhere in a Core expression; recurse every compound node.
  def borrow_core(Core, Vec(Func)) Core
  def borrow_core(CCall(f, args), all) := CCall(f, coerce_args(borrow_list(args, all), func_ptypes(f, all)))
  def borrow_core(CUnary(op, x), all) := CUnary(op, borrow_core(x, all))
  def borrow_core(CBin(op, l, r), all) := CBin(op, borrow_core(l, all), borrow_core(r, all))
  def borrow_core(CIf(c, t, e), all) := CIf(borrow_core(c, all), borrow_core(t, all), borrow_core(e, all))
  def borrow_core(CTuple(es), all) := CTuple(borrow_list(es, all))
  def borrow_core(COk(v), all) := COk(borrow_core(v, all))
  def borrow_core(CErr(e), all) := CErr(borrow_core(e, all))
  def borrow_core(CVariant(en, ct, nm, pairs), all) := CVariant(en, ct, nm, borrow_pairs(pairs, all))
  def borrow_core(CStruct(nm, pairs), all) := CStruct(nm, borrow_pairs(pairs, all))
  def borrow_core(CDot(h, fld), all) := CDot(borrow_core(h, all), fld)
  def borrow_core(CList(es, LClose), all) := CList(borrow_list(es, all), LClose)
  def borrow_core(CList(es, LCons(t)), all) := CList(borrow_list(es, all), LCons(borrow_core(t, all)))
  def borrow_core(leaf, _) := leaf

  def borrow_list(Vec(Core), Vec(Func)) Vec(Core)
  def borrow_list([], _) := []
  def borrow_list([c | rest], all) := [borrow_core(c, all) | borrow_list(rest, all)]

  def borrow_pairs(Vec(VPair), Vec(Func)) Vec(VPair)
  def borrow_pairs([], _) := []
  def borrow_pairs([VP(l, v) | rest], all) := [VP(l, borrow_core(v, all)) | borrow_pairs(rest, all)]

  # the callee's lowered parameter types, or None when the callee is unknown (a prim
  # or external) — then its args are left as-is.
  def func_ptypes(String, Vec(Func)) Option(Vec(String))
  def func_ptypes(_, []) := None
  def func_ptypes(name, [Func(n, _, _, params, _, _) | rest])
    if name == n do
      Some(ptype_list(params))
    else
      func_ptypes(name, rest)
    end
  end

  def ptype_list(Vec(Param)) Vec(String)
  def ptype_list([]) := []
  def ptype_list([Param(_, t) | rest]) := [t | ptype_list(rest)]

  def coerce_args(Vec(Core), Option(Vec(String))) Vec(Core)
  def coerce_args(args, None) := args
  def coerce_args(args, Some(pts)) := zip_coerce(args, pts)

  # zip args with the callee's param types; surplus args (none here) pass through.
  def zip_coerce(Vec(Core), Vec(String)) Vec(Core)
  def zip_coerce([], _) := []
  def zip_coerce(args, []) := args
  def zip_coerce([a | as], [pt | pts]) := [coerce1(a, pt) | zip_coerce(as, pts)]

  def coerce1(Core, String) Core
  def coerce1(a, pt)
    if borrow_type(pt) and is_owned(a) do
      CUnary("&", a)
    else
      a
    end
  end

  # a `&`-typed parameter (a borrow): its lowered type string starts with `&`.
  def borrow_type(String) Bool
  def borrow_type(t) := starts_amp(Prim.str_chars(t))

  def starts_amp(Vec(Char)) Bool
  def starts_amp([]) := false
  def starts_amp([c | _]) := c == '&'

  # an owned-producing argument: a list literal (`vec![…]`). Owned-`String` builders
  # and owned-returning calls are deferred.
  def is_owned(Core) Bool
  def is_owned(CList(_, _)) := true
  def is_owned(_) := false

  # `rust_program` emits plain `fn` for every top-level function (a single Rust
  # module; the `pub?` flag is not a Rust visibility here), so it is ignored.
  def function_rs(Func) String
  def function_rs(Func(name, _, tvars, params, ret, clauses)) :=
    "fn " <> name <> generics(tvars) <> "(" <> param_decls(params) <> ") -> " <> ret <>
      " {\n    match " <> scrut(params) <> " {\n" <> arms(clauses, ret, tvars) <> "    }\n}"

  # `<T: Clone, U: Clone>` for a generic fn (every tvar is `Clone`-bounded so a
  # borrowed `&T` can be cloned to the owned `T` a return wants); empty otherwise.
  def generics(Vec(String)) String
  def generics([]) := ""
  def generics(tvars) := "<" <> clone_bounds(tvars) <> ">"

  def clone_bounds(Vec(String)) String
  def clone_bounds([t]) := t <> ": Clone"
  def clone_bounds([t | rest]) := t <> ": Clone, " <> clone_bounds(rest)

  def member(String, Vec(String)) Bool
  def member(_, []) := false
  def member(x, [y | rest])
    if x == y do
      true
    else
      member(x, rest)
    end
  end

  def param_decls(Vec(Param)) String
  def param_decls([]) := ""
  def param_decls([Param(n, t)]) := n <> ": " <> t
  def param_decls([Param(n, t) | rest]) := n <> ": " <> t <> ", " <> param_decls(rest)

  # one param matches directly; N>1 match the tuple of params.
  def scrut(Vec(Param)) String
  def scrut([Param(n, _)]) := n
  def scrut(params) := "(" <> param_names(params) <> ")"

  def param_names(Vec(Param)) String
  def param_names([]) := ""
  def param_names([Param(n, _)]) := n
  def param_names([Param(n, _) | rest]) := n <> ", " <> param_names(rest)

  def arms(Vec(Clause), String, Vec(String)) String
  def arms([], _, _) := ""
  def arms([c | rest], ret, tvars) := arm(c, ret, tvars) <> arms(rest, ret, tvars)

  def arm(Clause, String, Vec(String)) String
  def arm(Clause(pats, guard, body), ret, tvars) :=
    "        " <> arm_pat(pats) <> guard_str(guard) <> " => " <>
      ret_coerce(wrap_rebinds(rebind_strs(pats, used_ids(body)), render(body)), ret, tvars) <>
      ",\n"

  # A list pattern matches against a `&[T]` slice, so its element binders are
  # borrowed (`&T`). Any binder the body USES is cloned back to an owned `T` with
  # a `let h = h.clone();` prepended inside a block — mirroring `Rian.Lower`'s
  # `arm_rebinds`. A binder used only by the guard needs no rebind (rustc would
  # flag it unused), so we filter on the body's used identifiers.
  def wrap_rebinds(Vec(String), String) String
  def wrap_rebinds([], body) := body
  def wrap_rebinds(rs, body) := "{ " <> space_join(rs) <> " " <> body <> " }"

  def rebind_strs(Vec(RPat), Vec(String)) Vec(String)
  def rebind_strs([], _) := []
  def rebind_strs([p | rest], used) := app(clones(slice_elem_vars(p), used), rebind_strs(rest, used))

  def clones(Vec(String), Vec(String)) Vec(String)
  def clones([], _) := []
  def clones([v | rest], used)
    if member(v, used) do
      ["let " <> v <> " = " <> v <> ".clone();" | clones(rest, used)]
    else
      clones(rest, used)
    end
  end

  # binders sitting in slice-ELEMENT position of a list pattern (the cons tail is
  # excluded — it stays a borrowed slice). Non-list patterns contribute nothing.
  def slice_elem_vars(RPat) Vec(String)
  def slice_elem_vars(RListP(ps, _)) := pat_vars_list(ps)
  def slice_elem_vars(_) := []

  def pat_vars_list(Vec(RPat)) Vec(String)
  def pat_vars_list([]) := []
  def pat_vars_list([p | rest]) := app(pat_vars(p), pat_vars_list(rest))

  def pat_vars(RPat) Vec(String)
  def pat_vars(RVar(n)) := [n]
  def pat_vars(RCtorP(_, _, _, _, args)) := pat_vars_list(args)
  def pat_vars(RTupleP(ps)) := pat_vars_list(ps)
  def pat_vars(ROkP(p)) := pat_vars(p)
  def pat_vars(RErrP(p)) := pat_vars(p)
  def pat_vars(RListP(ps, _)) := pat_vars_list(ps)
  def pat_vars(_) := []

  # identifiers the body references (an over-approximation, like `collect_ids`):
  # the call callee counts, so a binder shadowing a callee name is still seen.
  def used_ids(Core) Vec(String)
  def used_ids(CNum(_)) := []
  def used_ids(CStr(_)) := []
  def used_ids(CId(n)) := [n]
  def used_ids(CUnary(_, x)) := used_ids(x)
  def used_ids(CBin(_, l, r)) := app(used_ids(l), used_ids(r))
  def used_ids(CCall(f, args)) := [f | used_each(args)]
  def used_ids(CIf(c, t, e)) := app(used_ids(c), app(used_ids(t), used_ids(e)))
  def used_ids(CTuple(es)) := used_each(es)
  def used_ids(COk(v)) := used_ids(v)
  def used_ids(CErr(e)) := used_ids(e)
  def used_ids(CVariant(_, _, _, pairs)) := used_pairs(pairs)
  def used_ids(CStruct(_, pairs)) := used_pairs(pairs)
  def used_ids(CDot(h, _)) := used_ids(h)
  def used_ids(CList(es, LClose)) := used_each(es)
  def used_ids(CList(es, LCons(t))) := app(used_each(es), used_ids(t))

  def used_each(Vec(Core)) Vec(String)
  def used_each([]) := []
  def used_each([c | rest]) := app(used_ids(c), used_each(rest))

  def used_pairs(Vec(VPair)) Vec(String)
  def used_pairs([]) := []
  def used_pairs([VP(_, v) | rest]) := app(used_ids(v), used_pairs(rest))

  def app(Vec(String), Vec(String)) Vec(String)
  def app([], ys) := ys
  def app([x | rest], ys) := [x | app(rest, ys)]

  def space_join(Vec(String)) String
  def space_join([]) := ""
  def space_join([s]) := s
  def space_join([s | rest]) := s <> " " <> space_join(rest)

  # a bare owned-tvar return (`-> T`) yields a borrowed `&T` in the base arms (a
  # returned param), so `.clone()` it to the owned `T` the signature promises.
  def ret_coerce(String, String, Vec(String)) String
  def ret_coerce(s, ret, tvars)
    if member(ret, tvars) do
      "(" <> s <> ").clone()"
    else
      s
    end
  end

  # one pattern matches directly; N>1 a tuple pattern.
  def arm_pat(Vec(RPat)) String
  def arm_pat([p]) := rpat(p)
  def arm_pat(ps) := "(" <> rpat_list(ps) <> ")"

  def rpat_list(Vec(RPat)) String
  def rpat_list([]) := ""
  def rpat_list([p]) := rpat(p)
  def rpat_list([p | rest]) := rpat(p) <> ", " <> rpat_list(rest)

  def guard_str(Guard) String
  def guard_str(GNone) := ""
  def guard_str(GSome(g)) := " if " <> render(g)

  # ── resolved patterns -> Rust ──
  def rpat(RPat) String
  def rpat(RWild) := "_"
  def rpat(RVar(n)) := n
  def rpat(RInt(v)) := Prim.int_to_string(v)
  def rpat(RStr(s)) := "\"" <> s <> "\""
  def rpat(ROkP(p)) := "Ok(" <> rpat(p) <> ")"
  def rpat(RErrP(p)) := "Err(" <> rpat(p) <> ")"
  def rpat(RTupleP(ps)) := "(" <> rpat_list(ps) <> ")"
  def rpat(RCtorP(enum, ctor, named, labels, args)) := ctor_pat(enum, ctor, named, labels, args)
  def rpat(RListP(ps, LpClose)) := "[" <> rpat_list(ps) <> "]"
  def rpat(RListP(ps, LpVar(n))) := "[" <> comma_join(snoc(rpat_each(ps), n <> " @ ..")) <> "]"
  def rpat(RListP(ps, LpWild)) := "[" <> comma_join(snoc(rpat_each(ps), "..")) <> "]"

  # render each element pattern (so the cons tail can be comma-appended).
  def rpat_each(Vec(RPat)) Vec(String)
  def rpat_each([]) := []
  def rpat_each([p | rest]) := [rpat(p) | rpat_each(rest)]

  # append one element to the end of a string vector.
  def snoc(Vec(String), String) Vec(String)
  def snoc([], x) := [x]
  def snoc([y | rest], x) := [y | snoc(rest, x)]

  def ctor_pat(enum String, ctor String, named Bool, labels Vec(String), args Vec(RPat)) String
    if named do
      enum <> "::" <> ctor <> " { " <> named_pats(labels, args) <> " }"
    else
      enum <> "::" <> ctor <> pos_pat_args(args)
    end
  end

  # a nullary ctor pattern is `Enum::Ctor` (no parens); positional args add `(…)`.
  def pos_pat_args(Vec(RPat)) String
  def pos_pat_args([]) := ""
  def pos_pat_args(args) := "(" <> rpat_list(args) <> ")"

  def named_pats(Vec(String), Vec(RPat)) String
  def named_pats([], _) := ""
  def named_pats([l], [p]) := l <> ": " <> rpat(p)
  def named_pats([l | ls], [p | ps]) := l <> ": " <> rpat(p) <> ", " <> named_pats(ls, ps)

  # ── expression emission (precedence-aware) ──
  def dq(s String) String := "\"" <> s <> "\""

  def prec(String) Int53
  def prec("*") := 10
  def prec("/") := 10
  def prec("rem") := 10
  def prec("div") := 10
  def prec("+") := 9
  def prec("-") := 9
  def prec("<>") := 8
  def prec("<") := 5
  def prec("<=") := 5
  def prec(">") := 5
  def prec(">=") := 5
  def prec("==") := 4
  def prec("!=") := 4
  def prec("and") := 3
  def prec("or") := 2

  def assoc(String) String
  def assoc("<>") := "right"
  def assoc("<") := "none"
  def assoc("<=") := "none"
  def assoc(">") := "none"
  def assoc(">=") := "none"
  def assoc("==") := "none"
  def assoc("!=") := "none"
  def assoc(other) := "left"

  def disp(String) String
  def disp("and") := "&&"
  def disp("or") := "||"
  def disp("div") := "/"
  def disp("rem") := "%"
  def disp(other) := other

  def udisp(String) String
  def udisp("not") := "!"
  def udisp("-") := "-"
  def udisp("&") := "&"

  def paren(e Em, ctx Int53) String
    if e.pr < ctx do
      "(" <> e.s <> ")"
    else
      e.s
    end
  end

  pub def emit(Core) Em
  pub def emit(CNum(t)) := Em(s: t, pr: 12)
  pub def emit(CStr(s)) := Em(s: dq(s), pr: 12)
  pub def emit(CId(n)) := Em(s: n, pr: 12)
  pub def emit(CUnary(op, x)) := Em(s: udisp(op) <> paren(emit(x), 11), pr: 11)
  pub def emit(CBin(op, l, r)) := bin_em(op, l, r)
  pub def emit(CCall(f, args)) := Em(s: f <> "(" <> args_str(args) <> ")", pr: 12)
  pub def emit(CTuple(es)) := Em(s: "(" <> args_str(es) <> ")", pr: 12)
  pub def emit(COk(v)) := Em(s: "Ok(" <> args0(v) <> ")", pr: 12)
  pub def emit(CErr(e)) := Em(s: "Err(" <> args0(e) <> ")", pr: 12)
  pub def emit(CVariant(enum, ctor, named, pairs)) := variant_em(enum, ctor, named, pairs)
  pub def emit(CIf(c, th, el)) :=
    Em(s: "if " <> args0(c) <> " { " <> args0(th) <> " } else { " <> args0(el) <> " }", pr: 0)
  # struct construction `Name { l: v, … }` (no `Enum::` prefix — a record, not a variant)
  pub def emit(CStruct(name, pairs)) := Em(s: name <> " { " <> named_vals(pairs) <> " }", pr: 12)
  # field access `p.x` (postfix, prec 12)
  pub def emit(CDot(h, f)) := Em(s: paren(emit(h), 12) <> "." <> f, pr: 12)
  # closed list `vec![…]`; cons `[e1, … | tail]` prepends onto an owned copy of the
  # tail (`{ let mut __v = tail.to_vec(); __v.insert(0, en); … __v }`, ADR-0047)
  pub def emit(CList(es, LClose)) := Em(s: "vec![" <> args_str(es) <> "]", pr: 12)
  pub def emit(CList(es, LCons(t))) :=
    Em(s: "{ let mut __v = " <> paren(emit(t), 12) <> ".to_vec(); " <> inserts(es) <> "__v }", pr: 0)

  # one `__v.insert(0, e);` per element, in reverse so the result order is e1, …, en, tail…
  def inserts(Vec(Core)) String
  def inserts([]) := ""
  def inserts([e | rest]) := inserts(rest) <> "__v.insert(0, " <> args0(e) <> "); "

  def variant_em(enum String, ctor String, named Bool, pairs Vec(VPair)) Em
    if named do
      Em(s: enum <> "::" <> ctor <> " { " <> named_vals(pairs) <> " }", pr: 12)
    else
      Em(s: enum <> "::" <> ctor <> variant_args(pairs), pr: 12)
    end
  end

  def variant_args(Vec(VPair)) String
  def variant_args([]) := ""
  def variant_args(pairs) := "(" <> vpair_vals(pairs) <> ")"

  def vpair_vals(Vec(VPair)) String
  def vpair_vals([]) := ""
  def vpair_vals([VP(_, v)]) := args0(v)
  def vpair_vals([VP(_, v) | rest]) := args0(v) <> ", " <> vpair_vals(rest)

  def named_vals(Vec(VPair)) String
  def named_vals([]) := ""
  def named_vals([VP(l, v)]) := l <> ": " <> args0(v)
  def named_vals([VP(l, v) | rest]) := l <> ": " <> args0(v) <> ", " <> named_vals(rest)

  def bin_em(op String, l Core, r Core) Em
    case assoc(op) do
      "right" -> mk_bin(op, l, r, prec(op) + 1, prec(op))
      "none" -> mk_bin(op, l, r, prec(op) + 1, prec(op) + 1)
      other -> mk_bin(op, l, r, prec(op), prec(op) + 1)
    end
  end

  def mk_bin(op String, l Core, r Core, lc Int53, rc Int53) Em :=
    Em(s: paren(emit(l), lc) <> " " <> disp(op) <> " " <> paren(emit(r), rc), pr: prec(op))

  def args0(c Core) String := paren(emit(c), 0)

  def args_str(Vec(Core)) String
  def args_str([]) := ""
  def args_str([x]) := args0(x)
  def args_str([x | rest]) := args0(x) <> ", " <> args_str(rest)

  pub def render(c Core) String
    e := emit(c)
    e.s
  end

  # ── parametric type rendering (toward the whole-module Rust port) ──────────
  # The reference `Rian.Lower` lowers a type to an owned Rust string (`Capability
  # .owned`) and then splices `<K, V>` onto each parametric name via a `Regex`
  # (`rustify_parametric`). Rian has no regex — so model the type STRUCTURALLY and
  # substitute by recursion: `instantiate` applies a parametric name to its args
  # (`Pair` -> `Pair(K, V)`), then `render_ty` renders the owned Rust. This kills
  # the regex dependency and is the foundation of the parametric-generics part of
  # the Rust backend. Fixpoint-locked against the public `Rian.Capability.owned/1`
  # (`test/rian/rust_ty_fixpoint_test.exs`).
  type Ty := TName(String) | TApp(String, Vec(Ty))

  # a parametric type name -> the type arguments to apply (`Pair -> [K, V]`).
  type Inst := Inst(String, Vec(Ty))

  # the Copy-primitive scalar map (`Rian.Capability.rust_name`): an `@copy` name
  # gets its Rust spelling, everything else (String, a tvar, a nominal) passes
  # through unchanged.
  def rust_scalar(String) String
  def rust_scalar("Int53") := "i64"
  def rust_scalar("Int8") := "i8"
  def rust_scalar("Int16") := "i16"
  def rust_scalar("Int32") := "i32"
  def rust_scalar("Int64") := "i64"
  def rust_scalar("Int128") := "i128"
  def rust_scalar("UInt8") := "u8"
  def rust_scalar("UInt16") := "u16"
  def rust_scalar("UInt32") := "u32"
  def rust_scalar("UInt64") := "u64"
  def rust_scalar("UInt128") := "u128"
  def rust_scalar("Float32") := "f32"
  def rust_scalar("Float64") := "f64"
  def rust_scalar("Bool") := "bool"
  def rust_scalar("Char") := "char"
  def rust_scalar(other) := other

  # look a name up in the instantiation map: its args, or `None` if not parametric.
  def lookup_inst(String, Vec(Inst)) Option(Vec(Ty))
  def lookup_inst(_, []) := None
  def lookup_inst(n, [Inst(m, args) | rest])
    if n == m do
      Some(args)
    else
      lookup_inst(n, rest)
    end
  end

  # substitute: a parametric leaf `TName("Pair")` becomes `TApp("Pair", [K, V])`;
  # a container's element types are instantiated in turn; a non-parametric name is
  # left alone.
  def inst_ty(Ty, Vec(Inst)) Ty
  def inst_ty(TName(n), pinst)
    case lookup_inst(n, pinst) do
      Some(args) -> TApp(n, args)
      None -> TName(n)
    end
  end
  def inst_ty(TApp(name, args), pinst) := TApp(name, inst_args(args, pinst))

  def inst_args(Vec(Ty), Vec(Inst)) Vec(Ty)
  def inst_args([], _) := []
  def inst_args([t | rest], pinst) := [inst_ty(t, pinst) | inst_args(rest, pinst)]

  # render an (already-instantiated) type to its owned Rust spelling: a leaf maps
  # via the scalar table; an application is `Name<arg, …>`.
  def render_ty(Ty) String
  def render_ty(TName(n)) := rust_scalar(n)
  def render_ty(TApp(name, args)) := name <> "<" <> join_tys(args) <> ">"

  def join_tys(Vec(Ty)) String
  def join_tys([]) := ""
  def join_tys([t]) := render_ty(t)
  def join_tys([t | rest]) := render_ty(t) <> ", " <> join_tys(rest)

  # instantiate then render — the regex-free counterpart of
  # `rustify_parametric(Capability.owned(type), pinst)`.
  pub def render_inst(t Ty, pinst Vec(Inst)) String := render_ty(inst_ty(t, pinst))
end
