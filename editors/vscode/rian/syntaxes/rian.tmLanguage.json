{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Rian",
  "scopeName": "source.rian",
  "patterns": [
    { "include": "#comments" },
    { "include": "#annotations" },
    { "include": "#strings" },
    { "include": "#characters" },
    { "include": "#prim" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#capabilities" },
    { "include": "#constants" },
    { "include": "#atoms" },
    { "include": "#numbers" },
    { "include": "#named-arguments" },
    { "include": "#types" },
    { "include": "#function-calls" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.rian",
          "begin": "#",
          "end": "$",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.rian" }
          }
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "meta.annotation.rian",
          "match": "(@)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.definition.annotation.rian" },
            "2": { "name": "entity.name.decorator.rian" }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.rian",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.rian" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.rian" }
          },
          "patterns": [
            {
              "comment": "Escapes, incl. `\\$` for a literal `$` (so `\\${` is not a hole).",
              "name": "constant.character.escape.rian",
              "match": "\\\\(x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]+\\}|.)"
            },
            { "include": "#interpolation" }
          ]
        }
      ]
    },
    "interpolation": {
      "patterns": [
        {
          "comment": "String interpolation hole `${expr}` (ADR-0069). The body is full source.",
          "name": "meta.interpolation.rian",
          "begin": "\\$\\{",
          "beginCaptures": {
            "0": { "name": "punctuation.section.interpolation.begin.rian" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.section.interpolation.end.rian" }
          },
          "patterns": [
            {
              "comment": "Consume a nested `{ … }` so it does not end the hole early.",
              "begin": "\\{",
              "end": "\\}",
              "patterns": [{ "include": "$self" }]
            },
            { "include": "$self" }
          ]
        }
      ]
    },
    "characters": {
      "patterns": [
        {
          "name": "string.quoted.single.rian",
          "match": "'(\\\\(x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]+\\}|.)|[^'\\\\])'",
          "captures": {
            "1": { "name": "constant.character.escape.rian" }
          }
        }
      ]
    },
    "prim": {
      "patterns": [
        {
          "comment": "Reserved `Prim.*` intrinsic namespace (ADR-0047) — `Prim.<name>`.",
          "match": "\\b(Prim)(\\.)([a-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "support.class.prim.rian" },
            "2": { "name": "punctuation.accessor.rian" },
            "3": { "name": "support.function.prim.rian" }
          }
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "comment": "Function / macro / cast-method heads bind the following lower-case name.",
          "match": "\\b(def|defp|macro|to)\\b\\s+([a-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.function.rian" },
            "2": { "name": "entity.name.function.rian" }
          }
        },
        {
          "comment": "Type / value declaration heads bind the following Pascal-case name.",
          "match": "\\b(type|struct|alias|range|const|mod|abstract|opaque)\\b\\s+([A-Z][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.type.rian" },
            "2": { "name": "entity.name.type.rian" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.rian",
          "match": "\\b(case|when|if|else|do|end)\\b"
        },
        {
          "name": "keyword.declaration.rian",
          "match": "\\b(def|defp|macro|type|struct|alias|range|const|mod|abstract|opaque|pub|use|import|extern|comptime|forall|to)\\b"
        },
        {
          "name": "keyword.operator.word.rian",
          "match": "\\b(and|or|not|rem|div)\\b"
        }
      ]
    },
    "capabilities": {
      "patterns": [
        {
          "name": "storage.modifier.capability.rian",
          "match": "\\b(val|iso|ref|tag)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.rian",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "atoms": {
      "patterns": [
        {
          "comment": "Erlang-style atom / symbol literal: leading colon, not the `::` operator.",
          "name": "constant.other.symbol.rian",
          "match": "(?<![:\\w]):[a-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.rian",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9_]+)?\\b"
        },
        {
          "name": "constant.numeric.hex.rian",
          "match": "\\b0x[0-9A-Fa-f][0-9A-Fa-f_]*\\b"
        },
        {
          "name": "constant.numeric.binary.rian",
          "match": "\\b0b[01][01_]*\\b"
        },
        {
          "name": "constant.numeric.integer.rian",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "named-arguments": {
      "patterns": [
        {
          "comment": "Map / named-argument keys: `key:` association (not the `::` operator).",
          "match": "\\b([a-z_][A-Za-z0-9_]*)(:)(?!:)\\s",
          "captures": {
            "1": { "name": "entity.name.tag.rian" },
            "2": { "name": "punctuation.separator.key-value.rian" }
          }
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "comment": "Pascal-case identifiers: types, variant constructors, modules.",
          "name": "entity.name.type.rian",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "comment": "Lower-case identifier immediately followed by `(` is a call.",
          "match": "\\b([a-z_][A-Za-z0-9_]*)(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.rian" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.rian",
          "match": ":=|<-"
        },
        {
          "name": "keyword.operator.arrow.rian",
          "match": "->|=>"
        },
        {
          "name": "keyword.operator.pipe.rian",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.concat.rian",
          "match": "<>"
        },
        {
          "name": "keyword.operator.comparison.rian",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.range.rian",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.arithmetic.rian",
          "match": "[+\\-*/]"
        },
        {
          "name": "keyword.operator.other.rian",
          "match": "\\||::"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.accessor.rian",
          "match": "\\."
        },
        {
          "name": "punctuation.separator.rian",
          "match": "[,;]"
        },
        {
          "name": "punctuation.section.brackets.rian",
          "match": "[\\[\\](){}]"
        }
      ]
    }
  }
}
