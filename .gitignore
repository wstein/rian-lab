# Common 
.DS_Store
tmp/
*~
*.bak
*.swp
*.swo

# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Temporary files, for example, from tests.
/tmp/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Rust artifacts generated by example runners (written to the project root).
/*.rs

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
rian_lab-*.tar

# Ignore the lockfile for Bun
bun.lock

# The Starlight docs app (rian_lab/site) is source and IS committed.
# Ignore only its generated/installed artifacts — these are recreated by
# `mix docs` + `npm run build` (prebuild sync), so they must not be committed.
/site/node_modules/
/site/dist/
/site/.astro/
/site/src/content/docs/
/site/src/generated/


# escript build artifact (mix escript.build)
/rian
