# ===========================================================================
# SELF-HOSTING SPIKE — a Rian code generator + stack VM, written in Rian
# ===========================================================================
# Goal (ADR-0027/0031): the "back end" of the self-hosting toolchain. Compile
# the `Expr` sum to a flat list of **stack-machine instructions** (post-order),
# then run them on a tiny VM — both written in Rian. `Expr -> Vec(Instr) -> Int53`.
#
# This version handles **variables and `let`** via load/store **slots**: the
# code generator threads a compile-time environment (name -> slot index) and the
# VM threads a slot store (`Map(Int53, Int53)`) alongside the operand stack.
#
#   gen(Let("x", Num(5), Add(Var("x"), Num(1))))
#     = [Push(5), Store(0), Load(0), Push(1), IAdd]
#   run(that)  =  6
# ---------------------------------------------------------------------------

mod Codegen do
  type Expr := Num(Int53)
             | Var(String)
             | Add(Expr, Expr)
             | Sub(Expr, Expr)
             | Mul(Expr, Expr)
             | Div(Expr, Expr)
             | Let(String, Expr, Expr)

  # Push a literal, load/store a slot, or pop two / push one.
  type Instr := Push(Int53) | Load(Int53) | Store(Int53) | IAdd | ISub | IMul | IDiv

  # Public entry: compile in an empty environment at slot depth 0.
  pub def gen(e Expr) Vec(Instr) := g(e, %{}, 0)

  # `env` maps a bound name to its slot; `depth` is the next free slot (= the
  # lexical `let`-nesting depth — sibling subtrees safely reuse a slot once it
  # has been loaded, since scoping forbids a binding escaping its body).
  def g(e Expr, env Map(String, Int53), depth Int53) Vec(Instr)
  def g(Num(n), _, _) := [Push(n)]
  def g(Var(name), env, _) := [Load(Map.get(env, name))]
  def g(Add(a, b), env, d) := bin(a, b, env, d, IAdd)
  def g(Sub(a, b), env, d) := bin(a, b, env, d, ISub)
  def g(Mul(a, b), env, d) := bin(a, b, env, d, IMul)
  def g(Div(a, b), env, d) := bin(a, b, env, d, IDiv)

  def g(Let(name, rhs, body), env, d)
    # evaluate `rhs`, store it into slot `d`, then compile `body` with `name`
    # bound to slot `d` and the next free slot at `d + 1`
    concat(g(rhs, env, d), concat([Store(d)], g(body, Map.put(env, name, d), d + 1)))
  end

  def bin(a Expr, b Expr, env Map(String, Int53), d Int53, op Instr) Vec(Instr)
  def bin(a, b, env, d, op) := concat(g(a, env, d), concat(g(b, env, d), [op]))

  # List concatenation, written in Rian (there is no `++` operator).
  def concat(xs Vec(Instr), ys Vec(Instr)) Vec(Instr)
  def concat([], ys) := ys
  def concat([h | t], ys) := [h | concat(t, ys)]

  # Execute against an operand stack (`Vec(Int53)`) and a slot store
  # (`Map(Int53, Int53)`), returning the value left on top of the stack.
  pub def run(prog Vec(Instr)) Int53 := exec(prog, [], %{})

  def exec(prog Vec(Instr), stack Vec(Int53), slots Map(Int53, Int53)) Int53
  def exec([], [top | _], _) := top
  def exec([Push(n) | r], st, sl) := exec(r, [n | st], sl)
  def exec([Load(i) | r], st, sl) := exec(r, [Map.get(sl, i) | st], sl)
  def exec([Store(i) | r], [v | st], sl) := exec(r, st, Map.put(sl, i, v))
  def exec([IAdd | r], [b, a | st], sl) := exec(r, [a + b | st], sl)
  def exec([ISub | r], [b, a | st], sl) := exec(r, [a - b | st], sl)
  def exec([IMul | r], [b, a | st], sl) := exec(r, [a * b | st], sl)
  def exec([IDiv | r], [b, a | st], sl) := exec(r, [a div b | st], sl)
end
